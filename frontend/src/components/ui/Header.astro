---
interface Props {
  title?: string;
  showBreadcrumb?: boolean;
}

const {
  title = 'Fundación Gestionar Esperanzas',
  showBreadcrumb = false,
} = Astro.props;
---

<header
  class="sticky top-0 z-40 flex h-16 shrink-0 items-center
    justify-between border-b border-[#E9E6F0] bg-white/95
    px-4 backdrop-blur-sm md:px-6"
>
  <div class="flex min-w-0 items-center gap-3">
    <button
      id="sidebar-toggle"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-controls="app-sidebar"
      aria-expanded="false"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center
        rounded-xl text-[#4C4688] transition-colors hover:bg-[#F0EEF8]
        focus-visible:outline-2 focus-visible:outline-offset-2
        focus-visible:outline-[#4C4688] md:hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

    {
      showBreadcrumb ? (
        <div
          class="header-page-title header-migas flex min-w-0 items-center gap-2 overflow-hidden
            text-base font-semibold tracking-tight text-[#252238]
            md:gap-3 md:text-lg"
        >
          <slot name="breadcrumb" />
        </div>
      ) : (
        <span
          class="header-page-title truncate text-base font-semibold tracking-tight
            text-[#252238] md:text-lg"
        >
          {title}
        </span>
      )
    }
  </div>

  <div class="ml-4 flex shrink-0 items-center gap-2 md:gap-3">
    <slot name="actions" />

    <div class="relative" data-session-profile hidden>
      <button
        type="button"
        data-profile-toggle
        aria-label="Ver datos de sesión"
        aria-controls="profile-menu"
        aria-expanded="false"
        class="relative flex h-10 w-10 shrink-0 items-center justify-center
          overflow-hidden rounded-full p-0 border-2 border-white
          bg-[#4C4688] text-sm font-bold text-white
          shadow-sm ring-1 ring-[#DCD8EE] transition hover:bg-[#423C76]
          focus-visible:outline-2 focus-visible:outline-offset-2
          focus-visible:outline-[#4C4688]"
      >
        <span data-session-initial aria-hidden="true">U</span>
        <img
          data-session-flag
          src=""
          alt=""
          aria-hidden="true"
          class="absolute inset-0 hidden h-full w-full rounded-full object-cover object-center"
        />
      </button>

      <div
        id="profile-menu"
        data-profile-menu
        role="dialog"
        aria-label="Datos de sesión"
        hidden
        class="absolute right-0 top-full z-50 mt-3 w-72 origin-top-right
          rounded-2xl border border-[#E9E6F0] bg-white p-4 shadow-xl
          shadow-[#252238]/10"
      >
        <div class="flex items-center gap-3">
          <div
            aria-hidden="true"
            data-session-initial-large
            class="flex h-12 w-12 shrink-0 items-center justify-center
              rounded-full bg-[#F0EEF8] text-lg font-bold text-[#4C4688]"
          >
            U
          </div>
          <div class="min-w-0 flex-1">
            <p data-session-name class="truncate text-sm font-semibold text-[#252238]">
              Usuario
            </p>
            <p data-session-role class="mt-0.5 truncate text-xs text-[#77738A]">
              Rol no disponible
            </p>
            <p
              data-session-country
              class="mt-1 hidden truncate text-xs font-medium text-[#4C4688]"
            ></p>
          </div>
        </div>

        <div class="my-3 border-t border-[#EEEAF5]"></div>

        <div class="space-y-1">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8A869B]">
            Correo electrónico
          </p>
          <p data-session-email class="break-words text-sm text-[#454157]">
            Correo no disponible
          </p>
          <div data-session-country-detail hidden class="mt-3 space-y-1">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-[#8A869B]">
              País principal
            </p>
            <p class="text-sm font-medium text-[#454157]">
              <img
                data-session-country-flag
                src=""
                alt=""
                aria-hidden="true"
                class="inline-block h-4 w-6 rounded-sm object-cover"
              />
              <span data-session-country-name></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('app-sidebar');
  const closeButton = document.getElementById('sidebar-close');

  function setSidebarOpen(open: boolean) {
    sidebar?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));

    if (toggle) {
      toggle.setAttribute(
        'aria-label',
        open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = sidebar?.getAttribute('data-open') === 'true';
    setSidebarOpen(!isOpen);
  });

  closeButton?.addEventListener('click', () => {
    setSidebarOpen(false);
  });

  const profileContainer = document.querySelector<HTMLElement>('[data-session-profile]');
  const profileToggle = profileContainer?.querySelector<HTMLButtonElement>('[data-profile-toggle]');
  const profileMenu = profileContainer?.querySelector<HTMLElement>('[data-profile-menu]');

  function setProfileMenuOpen(open: boolean) {
    if (!profileToggle || !profileMenu) return;
    profileMenu.toggleAttribute('hidden', !open);
    profileToggle.setAttribute('aria-expanded', String(open));
  }

  profileToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = profileToggle.getAttribute('aria-expanded') === 'true';
    setProfileMenuOpen(!isOpen);
  });

  document.addEventListener('click', (event) => {
    if (
      profileContainer &&
      event.target instanceof Node &&
      !profileContainer.contains(event.target)
    ) {
      setProfileMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setSidebarOpen(false);
      setProfileMenuOpen(false);
    }
  });
</script>


<style>
  :global(.header-page-title *) {
    font-size: inherit !important;
    line-height: inherit !important;
  }

  @media (max-width: 767.98px) {
    :global(.header-migas a:not([data-migas-volver])),
    :global(.header-migas span:not(.font-semibold)) {
      display: none !important;
    }
  }

  @media (min-width: 768px) {
    :global(.header-migas [data-migas-volver]) {
      display: none !important;
    }
  }
</style>
