
---
interface Props {
  title?: string;
  showBreadcrumb?: boolean;
}

const {
  title = 'Fundación Gestionar Esperanzas',
  showBreadcrumb = false,
} = Astro.props;
---

<header
  class="sticky top-0 z-40 flex h-16 shrink-0 items-center
    justify-between border-b border-[#E9E6F0] bg-white/95
    px-4 backdrop-blur-sm md:px-6"
>
  <div class="flex min-w-0 items-center gap-3">
    <button
      id="sidebar-toggle"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-controls="app-sidebar"
      aria-expanded="false"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center
        rounded-xl text-[#4C4688] transition-colors hover:bg-[#F0EEF8]
        focus-visible:outline-2 focus-visible:outline-offset-2
        focus-visible:outline-[#4C4688] md:hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

    {
      showBreadcrumb ? (
        <div
          class="flex min-w-0 items-center gap-2 overflow-hidden
            text-sm md:gap-3 md:text-base"
        >
          <slot name="breadcrumb" />
        </div>
      ) : (
        <span
          class="truncate text-base font-semibold tracking-tight
            text-[#252238] md:text-lg"
        >
          {title}
        </span>
      )
    }
  </div>

  <div class="ml-4 flex shrink-0 items-center gap-2 md:gap-3">
    <slot name="actions" />
  </div>
</header>

<script>
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('app-sidebar');
  const closeButton = document.getElementById('sidebar-close');

  function setSidebarOpen(open: boolean) {
    sidebar?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));

    if (toggle) {
      toggle.setAttribute(
        'aria-label',
        open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = sidebar?.getAttribute('data-open') === 'true';
    setSidebarOpen(!isOpen);
  });

  closeButton?.addEventListener('click', () => {
    setSidebarOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setSidebarOpen(false);
    }
  });
</script>
