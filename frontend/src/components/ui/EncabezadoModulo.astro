---
interface Props {
  id: string;
  titulo: string;
  descripcion?: string;
  descripcionVisible?: boolean;
}

const { id, titulo, descripcion, descripcionVisible = false } = Astro.props;
const tieneAcciones = Astro.slots.has('default');
---

<header class="modulo-encabezado">
  <div class="min-w-0">
    <h2 id={id} class="modulo-titulo">{titulo}</h2>
    {descripcion && <p class:list={['modulo-descripcion', descripcionVisible && 'modulo-descripcion--visible']}>{descripcion}</p>}
  </div>
  {tieneAcciones && <div class="modulo-acciones"><slot /></div>}
</header>
