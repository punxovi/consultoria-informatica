---
/**
 * Encabezado común de los módulos de la ficha de organización
 * (Actas, Compromisos, Diagnóstico, Donaciones, Expediente legal…).
 * Título + una línea de descripción (oculta en móvil) + acciones en el slot.
 * Con `descripcionVisible` la descripción también se muestra en móvil (para
 * secciones que no tienen otra explicación previa, como Evidencias o Indicadores).
 */
interface Props {
  id: string;
  titulo: string;
  descripcion?: string;
  descripcionVisible?: boolean;
}

const { id, titulo, descripcion, descripcionVisible = false } = Astro.props;
const tieneAcciones = Astro.slots.has('default');
---

<header class="modulo-encabezado">
  <div class="min-w-0">
    <h2 id={id} class="modulo-titulo">{titulo}</h2>
    {descripcion && <p class:list={['modulo-descripcion', descripcionVisible && 'modulo-descripcion--visible']}>{descripcion}</p>}
  </div>
  {tieneAcciones && <div class="modulo-acciones"><slot /></div>}
</header>
