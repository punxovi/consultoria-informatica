---
/**
 * Encabezado común de los módulos de la ficha de organización
 * (Actas, Compromisos, Diagnóstico, Donaciones, Expediente legal…).
 * Título + una línea de descripción (oculta en móvil) + acciones en el slot.
 */
interface Props {
  id: string;
  titulo: string;
  descripcion?: string;
}

const { id, titulo, descripcion } = Astro.props;
const tieneAcciones = Astro.slots.has('default');
---

<header class="modulo-encabezado">
  <div class="min-w-0">
    <h2 id={id} class="modulo-titulo">{titulo}</h2>
    {descripcion && <p class="modulo-descripcion">{descripcion}</p>}
  </div>
  {tieneAcciones && <div class="modulo-acciones"><slot /></div>}
</header>
