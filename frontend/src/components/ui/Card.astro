---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
---

<div class={`rounded-xl border border-neutral-200 bg-white p-4 shadow-sm ${className}`}>
  {hasHeader && (
    <div class="mb-3 border-b border-neutral-100 pb-3">
      <slot name="header" />
    </div>
  )}

  <div>
    <slot />
  </div>

  {hasFooter && (
    <div class="mt-3 border-t border-neutral-100 pt-3">
      <slot name="footer" />
    </div>
  )}
</div>
