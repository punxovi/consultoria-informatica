---
// RNF13: la identificación de estados del semáforo debe incluir íconos o
// etiquetas de texto, para no depender únicamente del color (accesibilidad
// para personas con daltonismo).

interface Props {
  id?: string;
  variant?: 'success' | 'warning' | 'danger' | 'neutral' | 'info';
  class?: string;
}

const { id, variant = 'neutral', class: className = '' } = Astro.props;

const variants = {
  success: 'bg-success/10 text-success',
  warning: 'bg-warning/10 text-warning',
  danger: 'bg-danger/10 text-danger',
  neutral: 'bg-neutral-100 text-neutral-600',
  info: 'bg-primary/10 text-primary',
};

// Formas distintas por variante, no solo color: útil para el semáforo de
// Acciones (RF57-RF59) y para no depender del color en pantallas.
const shapes = {
  success: '●',
  warning: '▲',
  danger: '■',
  neutral: '○',
  info: 'ℹ',
};
---

<span
  id={id}
  class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${variants[variant]} ${className}`}
>
  <span aria-hidden="true">{shapes[variant]}</span>
  <slot />
</span>
