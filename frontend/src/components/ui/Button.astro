---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  disabled?: boolean;
  id?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  href,
  disabled = false,
  id,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg font-medium ' +
  'transition-colors min-h-[48px] min-w-[48px] ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 ' +
  'disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary:
    'bg-primary text-white hover:bg-primary/90 focus-visible:ring-primary',

  secondary:
    'bg-secondary text-white hover:bg-secondary/90 focus-visible:ring-secondary',

  outline:
    'border-2 border-primary text-primary bg-white hover:bg-primary/5 focus-visible:ring-primary',

  danger:
    'bg-danger text-white hover:bg-danger/90 focus-visible:ring-danger',

  ghost:
    'text-primary font-semibold hover:bg-primary/10 focus-visible:ring-primary',
};

const sizes = {
  sm: 'px-3 py-2 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-6 py-3 text-lg',
};

const classes =
  `${base} ${variants[variant]} ${sizes[size]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag
  id={id}
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled}
>
  <slot />
</Tag>