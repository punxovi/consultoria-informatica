---
interface Option {
  value: string;
  label: string;
}

interface Props {
  label: string;
  id: string;
  name?: string;
  options: Option[];
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  hint?: string;
  value?: string;
  class?: string;
}

const {
  label,
  id,
  name = id,
  options,
  placeholder,
  required = false,
  disabled = false,
  error,
  hint,
  value,
  class: className = '',
} = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm font-medium text-neutral-800">
    {label}
    {required && (
      <span class="ml-0.5 text-danger" aria-hidden="true">*</span>
    )}
  </label>

  <select
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
    class={`min-h-[48px] rounded-lg border bg-white px-3 py-2 text-base
      focus:outline-none focus:ring-2 focus:ring-primary
      disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:text-neutral-400
      ${error ? 'border-danger' : 'border-neutral-300'} ${className}`}
  >
    {placeholder && (
      <option value="" disabled selected={!value}>
        {placeholder}
      </option>
    )}
    {options.map((opt) => (
      <option value={opt.value} selected={opt.value === value}>
        {opt.label}
      </option>
    ))}
  </select>

  {hint && !error && (
    <p id={`${id}-hint`} class="text-sm text-neutral-500">{hint}</p>
  )}

  {error && (
    <p id={`${id}-error`} class="text-sm text-danger" role="alert">
      {error}
    </p>
  )}
</div>
