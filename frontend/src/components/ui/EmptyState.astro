---
import Card from './Card.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  hidden?: boolean;
}

const { id, title, description, hidden = false } = Astro.props;
const tieneAccion = Astro.slots.has('default');
---

<div id={id} hidden={hidden} class="empty-state">
  <Card>
    <div class="flex flex-col items-center px-3 py-7 text-center sm:py-8">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#F0EDF8] text-[#4C4688]" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 4.75h7l4 4v10.5A1.75 1.75 0 0 1 17.25 21h-10.5A1.75 1.75 0 0 1 5 19.25V6.5A1.75 1.75 0 0 1 6.75 4.75H8Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6M9 16h4" />
        </svg>
      </span>
      <h3 id={`${id}-title`} class="mt-3 text-base font-semibold text-slate-900">{title}</h3>
      <p id={`${id}-description`} class="mx-auto mt-1 max-w-md text-sm leading-6 text-slate-500">{description}</p>
      {tieneAccion && <div class="mt-4 flex justify-center"><slot /></div>}
    </div>
  </Card>
</div>
