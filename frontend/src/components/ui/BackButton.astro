---
interface Props {
  label?: string;
  class?: string;
  href?: string;
}

const {
  label = '',
  class: className = '',
  href,
} = Astro.props;

const accessibleLabel =
  label || (href ? 'Volver al listado' : 'Volver a la página anterior');
---

{
  href ? (
    <a
      href={href}
      class:list={[
        'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl',
        'border border-[#DCD8E8] bg-white px-3 text-[#4C4688]',
        'transition-colors hover:border-[#C9C3E0] hover:bg-[#F0EEF8]',
        'focus-visible:outline-none focus-visible:ring-2',
        'focus-visible:ring-[#4C4688] focus-visible:ring-offset-2',
        className,
      ]}
      aria-label={accessibleLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5m7 7-7-7 7-7" />
      </svg>

      {label && <span class="text-sm font-semibold">{label}</span>}
    </a>
  ) : (
    <button
      type="button"
      data-back-button="true"
      class:list={[
        'inline-flex min-h-11 items-center justify-center gap-2 rounded-xl',
        'border border-[#DCD8E8] bg-white px-3 text-[#4C4688]',
        'transition-colors hover:border-[#C9C3E0] hover:bg-[#F0EEF8]',
        'focus-visible:outline-none focus-visible:ring-2',
        'focus-visible:ring-[#4C4688] focus-visible:ring-offset-2',
        className,
      ]}
      aria-label={accessibleLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5m7 7-7-7 7-7" />
      </svg>

      {label && <span class="text-sm font-semibold">{label}</span>}
    </button>
  )
}

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-back-button]')
    .forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';

      button.addEventListener('click', () => {
        window.history.back();
      });
    });
</script>
