---
interface Props {
  label?: string;
  class?: string;
  href?: string;
}

const {
  label = '',
  class: className = '',
  href,
} = Astro.props;

const accessibleLabel =
  label || (href ? 'Volver al listado' : 'Volver a la página anterior');

const clases = [
  '-ml-1 inline-flex h-10 min-w-10 shrink-0 items-center justify-center gap-1 rounded-full',
  'text-[#4C4688] transition-colors hover:bg-[#F0EEF8] active:bg-[#E6E2F3]',
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4C4688]',
  className,
];
---

{
  href ? (
    <a href={href} data-migas-volver class:list={clases} aria-label={accessibleLabel}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6" />
      </svg>

      {label && <span class="text-sm font-semibold">{label}</span>}
    </a>
  ) : (
    <button
      type="button"
      data-back-button="true"
      data-migas-volver
      class:list={clases}
      aria-label={accessibleLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6" />
      </svg>

      {label && <span class="text-sm font-semibold">{label}</span>}
    </button>
  )
}

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-back-button]')
    .forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';

      button.addEventListener('click', () => {
        window.history.back();
      });
    });
</script>
