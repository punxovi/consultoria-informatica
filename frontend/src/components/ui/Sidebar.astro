---
interface NavItem {label: string; href: string;}

interface Props {items: NavItem[]; }

const { items } = Astro.props;
const currentPath = Astro.url.pathname;
---

<aside
  id="app-sidebar"
  data-open="false"
  class="fixed inset-y-0 left-0 z-50 flex w-64
    -translate-x-full flex-col border-r border-[#39336E]
    bg-[#4C4688] p-4 text-white transition-transform duration-200
    data-[open=true]:translate-x-0 md:translate-x-0"
>
  <!-- Logo de la fundación -->
  <div class="flex min-h-[76px] items-center justify-between
    border-b border-white/15 px-1 pb-4 pt-1">
    <a
      href="/dashboard"
      class="flex min-w-0 flex-1 items-center"
      aria-label="Fundación Gestionar Esperanzas, ir al Dashboard"
    >
      <img
        src="/images/logo-fge-blanco.png"
        alt="Fundación Gestionar Esperanzas"
        class="block h-auto w-[205px] max-w-full object-contain"
        width="820"
        height="248"
      />
    </a>

    <!-- Botón para cerrar el menú en móvil -->
    <button
      id="sidebar-close"
      type="button"
      class="ml-2 inline-flex h-9 w-9 shrink-0 items-center
        justify-center rounded-lg text-white/80
        transition-colors hover:bg-white/10 hover:text-white
        md:hidden"
      aria-label="Cerrar menú de navegación"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 6l12 12M18 6L6 18"
        />
      </svg>
    </button>
  </div>

  <nav aria-label="Navegación principal" class="flex flex-col gap-1.5">
    {items.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== '/dashboard' &&
          currentPath.startsWith(`${item.href}/`));

      return (
        <a
          href={item.href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'group flex min-h-[48px] items-center gap-3 rounded-xl px-3 py-2.5',
            'text-sm transition-colors duration-150',
            isActive
              ? 'bg-[#7770B5] font-semibold text-white shadow-sm'
              : 'font-medium text-[#EEEAFB] hover:bg-white/10 hover:text-white',
          ]}
        >
          <span
            class:list={[
              'flex h-9 w-9 shrink-0 items-center justify-center rounded-lg',
              isActive
                ? 'bg-white/15 text-white'
                : 'text-[#D2CFF0] group-hover:text-white',
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {item.href === '/dashboard' && (
                <>
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </>
              )}

              {item.href.startsWith('/organizaciones') && (
                <>
                  <rect x="5" y="3" width="14" height="18" rx="1.5" />
                  <path d="M9 7h2M9 11h2M9 15h2M15 7h.01M15 11h.01M15 15h.01M10 21v-3h4v3" />
                </>
              )}

              {item.href.startsWith('/programas') && (
                <>
                  <rect x="4" y="3" width="16" height="18" rx="2" />
                  <path d="M8 8h8M8 12h8M8 16h5" />
                </>
              )}

              {item.href.startsWith('/planes') && (
                <>
                  <rect x="5" y="4" width="14" height="17" rx="2" />
                  <path d="M9 4.5v-2h6v2M8 12l2.5 2.5L16 9" />
                </>
              )}

              {item.href.startsWith('/reportes') && (
                <>
                  <path d="M6 3h8l5 5v13H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
                  <path d="M14 3v5h5M8 16v-3M12 16v-5M16 16v-2" />
                </>
              )}

              {![
                '/dashboard',
                '/organizaciones',
                '/programas',
                '/planes',
                '/reportes',
              ].some((href) =>
                href === '/dashboard'
                  ? item.href === href
                  : item.href.startsWith(href)
              ) && <circle cx="12" cy="12" r="8" />}
            </svg>
          </span>

          <span class="min-w-0 flex-1">{item.label}</span>

          {isActive && (
            <span
              class="h-1.5 w-1.5 shrink-0 rounded-full bg-white"
              aria-hidden="true"
            />
          )}
        </a>
      );
    })}
  </nav>

  <div class="mt-auto border-t border-white/20 px-1 pb-5 pt-4">
    <button
      id="logout-btn"
      type="button"
      class="flex min-h-[46px] w-full cursor-pointer items-center gap-3
        rounded-xl border-0 bg-transparent px-3 py-3 text-left
        text-sm font-medium text-[#FFD2E1] transition-colors
        hover:bg-white/10 hover:text-white"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 17l5-5-5-5M15 12H3" />
        <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" />
      </svg>
      <span>Cerrar sesión</span>
    </button>
  </div>
</aside>

<script>
  import { cerrarSesion } from '../../lib/auth/cliente';

  const logoutBtn = document.getElementById('logout-btn');

  logoutBtn?.addEventListener('click', async () => {
    try {
      await cerrarSesion();
    } finally {
      window.location.href = '/login';
    }
  });
</script>
