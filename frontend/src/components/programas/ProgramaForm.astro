---
import AvisoObligatorios from '../ui/AvisoObligatorios.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';

interface Props { idPrograma?: string }
const { idPrograma = '' } = Astro.props;
const campos = [
  { id: 'objetivo_general', label: 'Objetivo general', max: 3000 },
  { id: 'objetivos_especificos', label: 'Objetivos específicos', max: 5000 },
  { id: 'descripcion', label: 'Descripción / contexto', max: 5000 },
];
---

<section class="w-full space-y-5">
  <header class="min-w-0">
    <h1 id="programa-form-titulo" class="text-2xl font-bold tracking-tight text-neutral-900 md:text-3xl">
      {idPrograma ? 'Editar programa' : 'Crear programa'}
    </h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-neutral-600 md:text-base">
      Registra los objetivos, líneas de acción y referencias del programa institucional.
    </p>
  </header>

  <AvisoObligatorios />

  <p id="programa-estado" role="status" aria-live="polite" class="text-sm text-neutral-600">
    Cargando formulario…
  </p>

  <div id="programa-errores" role="alert" tabindex="-1" class="hidden rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800"></div>

  <div id="programa-recuperacion" hidden class="flex flex-wrap gap-3">
    <Button id="recargar-programa" variant="outline">Reintentar</Button>
    <a href="/login" class="inline-flex min-h-[48px] items-center text-primary underline">Iniciar sesión</a>
  </div>

  <form id="programa-form" data-id={idPrograma} novalidate aria-busy="true" class="w-full space-y-5">
    <fieldset id="programa-campos" disabled class="min-w-0 space-y-5">
      <Card class="w-full tarjeta-acento acento-morado p-5 md:p-6">
        <section class="space-y-5" aria-labelledby="programa-info-titulo">
          <header class="flex items-start gap-3 border-b border-neutral-100 pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#F0EEF9] text-[#4C4688]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 3h7l5 5v13H5V3h2Zm7 0v5h5M8 13h8m-8 4h8" />
              </svg>
            </span>
            <div>
              <h2 id="programa-info-titulo" class="text-lg font-bold text-neutral-900">Información del programa</h2>
              <p class="mt-1 text-sm text-neutral-500">Registra el nombre, los objetivos y el contexto del programa.</p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
              <Input id="nombre" label="Nombre del programa" required maxlength={150} />
            </div>

            {campos.map(({ id, label, max }) => (
              <div class:list={["min-w-0 space-y-1.5", id === 'descripcion' ? 'md:col-span-2' : '']}>
                <label for={id} class="block text-sm font-medium text-neutral-800">
                  {label}<span class="marca-obligatorio" aria-hidden="true">*</span>
                </label>
                <textarea
                  id={id}
                  name={id}
                  required
                  maxlength={max}
                  rows="4"
                  class="mt-1.5 w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 text-base text-neutral-900 focus:outline-none focus:ring-2 focus:ring-primary"
                ></textarea>
              </div>
            ))}
          </div>
        </section>
      </Card>

      <Card class="w-full tarjeta-acento acento-verde p-5 md:p-6">
        <section class="space-y-5" aria-labelledby="programa-lineas-titulo">
          <header class="flex items-start gap-3 border-b border-neutral-100 pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E8F6EF] text-[#199D6B]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19V5m0 14h17M8 15v-4m4 4V7m4 8V9m4 6V4" />
              </svg>
            </span>
            <div>
              <h2 id="programa-lineas-titulo" class="text-lg font-bold text-neutral-900">Líneas de acción y resultados esperados</h2>
              <p class="mt-1 text-sm text-neutral-500">Cada programa nuevo requiere al menos una línea. Puedes registrar hasta 50.</p>
            </div>
          </header>

          <div id="programa-legado" hidden class="rounded-xl border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-700">
            <p>Este programa conserva sus componentes y resultados generales. Puedes editar sus datos sin agregar líneas, o registrar cada línea con su resultado correspondiente.</p>
            <h3 class="mt-3 font-semibold text-neutral-900">Componentes registrados</h3>
            <p id="legado-componentes" class="whitespace-pre-wrap"></p>
            <h3 class="mt-3 font-semibold text-neutral-900">Resultados registrados</h3>
            <p id="legado-resultados" class="whitespace-pre-wrap"></p>
          </div>

          <div id="programa-lineas" class="space-y-4"></div>

          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
            <p class="text-sm text-neutral-500">Registra por separado cada línea y su resultado esperado.</p>
            <Button id="agregar-linea" variant="outline">+ Agregar línea de acción</Button>
          </div>
        </section>
      </Card>

      <Card class="w-full tarjeta-acento acento-celeste p-5 md:p-6">
        <section class="space-y-5" aria-labelledby="programa-complementaria-titulo">
          <header class="flex items-start gap-3 border-b border-neutral-100 pb-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E5F5F8] text-[#16899B]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
              </svg>
            </span>
            <div>
              <h2 id="programa-complementaria-titulo" class="text-lg font-bold text-neutral-900">Información complementaria</h2>
              <p class="mt-1 text-sm text-neutral-500">Añade referencias y, si corresponde, una imagen representativa.</p>
            </div>
          </header>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="min-w-0 space-y-1.5">
              <label for="referencias_ods" class="block text-sm font-medium text-neutral-800">Referencias <abbr title="Objetivos de Desarrollo Sostenible" class="no-underline">ODS</abbr> <span class="font-normal text-neutral-500">(opcional)</span></label>
              <textarea id="referencias_ods" name="referencias_ods" maxlength="2000" rows="3" placeholder="Objetivos de Desarrollo Sostenible. Ej.: ODS 4, ODS 10" class="mt-1.5 w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
            </div>

            <div class="min-w-0 space-y-1.5">
              <label for="referencias_esg" class="block text-sm font-medium text-neutral-800">Referencias <abbr title="Criterios ambientales, sociales y de gobernanza" class="no-underline">ESG</abbr> <span class="font-normal text-neutral-500">(opcional)</span></label>
              <textarea id="referencias_esg" name="referencias_esg" maxlength="2000" rows="3" placeholder="Criterios ambientales, sociales y de gobernanza" class="mt-1.5 w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
            </div>

            <div class="min-w-0 space-y-2 md:col-span-2">
              <label for="imagen" class="block text-sm font-medium text-neutral-800">Imagen representativa <span class="font-normal text-neutral-500">(opcional)</span></label>
              <input id="imagen" name="imagen" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="imagen-ayuda" />
              <p id="imagen-ayuda" class="text-sm leading-5 text-neutral-500">JPG, PNG o WebP, hasta 10 MB. Se optimiza a WebP de menos de 600 KB antes de subir.</p>
              <img id="imagen-preview" alt="Vista previa de la imagen del programa" hidden class="mt-4 max-h-64 max-w-full rounded-xl border border-neutral-200 object-contain" />
              <div id="quitar-imagen-contenedor" hidden class="mt-3">
                <Button id="quitar-imagen" variant="outline">Quitar imagen</Button>
              </div>
              <p id="imagen-cambio" role="status" class="mt-2 text-sm text-neutral-600"></p>
            </div>
          </div>
        </section>

        <footer class="mt-6 flex flex-col-reverse gap-3 border-t border-neutral-100 pt-5 sm:flex-row sm:justify-end">
          <Button id="cancelar-programa" data-descartar variant="outline">Cancelar</Button>
          <Button id="guardar-programa" type="submit">{idPrograma ? 'Guardar cambios' : 'Crear programa'}</Button>
        </footer>
      </Card>
    </fieldset>
  </form>
</section>

<template id="plantilla-linea">
  <fieldset class="min-w-0 rounded-xl border border-[#D7EDE2] bg-[#F8FCF9] p-4 md:p-5">
    <legend class="px-1 font-semibold text-neutral-900"></legend>
    <div class="grid min-w-0 gap-4 md:grid-cols-2">
      <div class="min-w-0">
        <label class="block text-sm font-medium text-neutral-800" data-label="linea_accion">Línea de acción<span class="marca-obligatorio" aria-hidden="true">*</span></label>
        <textarea data-campo="linea_accion" required maxlength="500" rows="3" class="mt-1.5 w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
      </div>
      <div class="min-w-0">
        <label class="block text-sm font-medium text-neutral-800" data-label="resultado_esperado">Resultado esperado<span class="marca-obligatorio" aria-hidden="true">*</span></label>
        <textarea data-campo="resultado_esperado" required maxlength="2000" rows="3" class="mt-1.5 w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
      </div>
    </div>
    <button type="button" data-quitar class="mt-3 inline-flex min-h-[44px] items-center rounded-lg px-3 font-medium text-[#AD174F] transition-colors hover:bg-[#FCE8F0] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">Quitar línea</button>
  </fieldset>
</template>

<script>
  import '../../lib/programas/formulario';
</script>

