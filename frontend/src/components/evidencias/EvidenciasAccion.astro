---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import { accept } from '../../lib/evidencias/modelo';
const { idAccion } = Astro.props;
---
<section id="evidencias-accion" data-accion={idAccion} aria-labelledby="evidencias-titulo" class="space-y-5 border-t border-neutral-200 pt-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 id="evidencias-titulo" class="text-2xl font-bold tracking-tight md:text-3xl">Evidencias</h2>
      <p class="mt-2 max-w-3xl text-base text-neutral-700 md:text-lg">Adjunta archivos que respalden esta acción y controla cuáles pueden publicarse. Puedes agregarlos en cualquier momento.</p>
    </div>
    <Button id="ev-recargar" variant="outline">Actualizar evidencias</Button>
  </header>
  <p id="ev-carga" role="status" hidden class="rounded-lg bg-primary/5 p-4">Cargando evidencias…</p>
  <p id="ev-error" hidden role="alert" tabindex="-1" class="rounded-lg border border-red-300 bg-red-50 p-4 text-red-800"></p>
  <p id="ev-exito" hidden role="status" class="rounded-lg border border-green-300 bg-green-50 p-4 text-green-900"></p>
  <div class="grid min-w-0 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
    <Card>
      <h3 id="ev-form-titulo" class="text-xl font-semibold">Adjuntar evidencia</h3>
      <p id="ev-pendiente" hidden class="my-3 rounded-lg bg-amber-50 p-3 text-amber-900"></p>
      <p class="my-3 text-sm text-neutral-700">Los campos con * son obligatorios. El archivo queda vinculado a esta acción.</p>
      <form id="ev-form" novalidate>
        <fieldset id="ev-campos" class="min-w-0 space-y-5" disabled>
          <div>
            <label for="ev-archivo" class="block font-medium">Archivo *</label>
            <input id="ev-archivo" type="file" required accept={accept} aria-describedby="ev-archivo-ayuda" class="mt-2 min-h-[48px] w-full min-w-0 max-w-full text-sm file:mr-3 file:min-h-[48px] file:rounded-lg file:border-0 file:bg-primary file:px-4 file:text-white" />
            <p id="ev-archivo-ayuda" class="mt-2 text-sm text-neutral-700">Fotografías (JPG, PNG, WebP), videos (MP4, WebM), documentos o actas en PDF y audio (MP3, OGG, WAV). Máximo 50 MiB.</p>
          </div>
          <div id="ev-metadatos" class="space-y-5">
            <Input id="ev-origen" name="origen" label="Origen" required maxlength={200} placeholder="Ej.: Visita en terreno o acta de reunión" />
            <div>
              <label for="ev-descripcion" class="block font-medium">Descripción *</label>
              <textarea id="ev-descripcion" name="descripcion" required maxlength="5000" rows="3" class="mt-2 w-full rounded-lg border border-neutral-300 p-3" placeholder="Describe qué demuestra el archivo y su relación con la acción."></textarea>
            </div>
            <div class="space-y-4 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
              <h4 class="font-semibold">Personas y consentimiento</h4>
              <label for="ev-personas" class="block font-medium">¿Aparecen personas identificables? *</label>
              <select id="ev-personas" name="personas" required class="min-h-[48px] w-full rounded-lg border border-neutral-300 bg-white px-3">
                <option value="">Selecciona una opción</option><option value="sin_personas">No aparecen personas identificables</option>
                <option value="adultos">Sí, solo personas adultas</option><option value="menores">Sí, aparecen menores de edad</option>
              </select>
              <label id="ev-consentimiento-grupo" hidden class="flex items-start gap-3">
                <input id="ev-consentimiento" name="consentimiento" type="checkbox" class="mt-1 size-5 shrink-0 accent-primary" />
                <span>Declaro contar con el consentimiento de las personas identificables que aparecen en la evidencia.</span>
              </label>
              <label id="ev-tutor-grupo" hidden class="flex items-start gap-3">
                <input id="ev-tutor" name="tutor" type="checkbox" class="mt-1 size-5 shrink-0 accent-primary" />
                <span>Declaro contar con el consentimiento del padre, madre o tutor legal de los menores que aparecen.</span>
              </label>
              <p class="text-sm text-neutral-700">La declaración se registra con tu usuario y la fecha del servidor.</p>
            </div>
            <label class="flex items-start gap-3 rounded-lg border border-primary/20 p-4">
              <input id="ev-publicable" name="publicable" type="checkbox" class="mt-1 size-5 shrink-0 accent-primary" />
              <span><strong>Permitir publicación</strong><span class="mt-1 block text-sm text-neutral-700">Se marcará como publicada solo después de completar la carga. Si no lo marcas, queda sin publicar.</span></span>
            </label>
          </div>
          <div class="flex flex-wrap gap-3">
            <Button id="ev-guardar" type="submit">Guardar evidencia</Button>
            <Button id="ev-cancelar" variant="outline">Cancelar</Button>
          </div>
        </fieldset>
      </form>
    </Card>
    <div class="min-w-0 space-y-5">
      <Card>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-xl font-semibold">Archivos de la acción</h3><span id="ev-cantidad" class="rounded-full bg-primary/10 px-3 py-1 font-medium text-primary">—</span>
        </div>
        <div id="ev-vacio" hidden class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-6">
          <h4 class="text-lg font-semibold">Todavía no hay evidencias</h4>
          <p class="mt-2 text-neutral-700">La acción puede continuar sin archivos. Usa el formulario para adjuntar el primero cuando esté disponible.</p>
        </div>
        <div id="ev-lista" class="space-y-3"></div>
      </Card>
      <div id="ev-detalle" hidden>
        <Card>
          <h3 id="ev-detalle-titulo" tabindex="-1" class="break-words text-xl font-semibold">Detalle de evidencia</h3>
          <dl id="ev-datos" class="my-5 grid gap-4 sm:grid-cols-2"></dl>
          <p id="ev-declaracion" class="mb-5 whitespace-pre-wrap break-words rounded-lg bg-neutral-50 p-4 text-neutral-700"></p>
          <div class="flex flex-wrap gap-3">
            <Button id="ev-descargar" variant="outline">Descargar archivo</Button>
            <Button id="ev-publicar" variant="outline">Permitir publicación</Button>
            <Button id="ev-revocar" variant="outline">Revocar consentimiento</Button>
            <Button id="ev-reintentar" variant="outline">Completar carga</Button>
          </div>
          <p id="ev-sin-consentimiento" hidden class="mt-3 text-sm text-neutral-700">No se puede publicar sin una declaración de consentimiento afirmativa.</p>
        </Card>
      </div>
    </div>
  </div>
</section>
<script>
  import { iniciarEvidencias } from '../../lib/evidencias/interfaz';
  iniciarEvidencias();
</script>
