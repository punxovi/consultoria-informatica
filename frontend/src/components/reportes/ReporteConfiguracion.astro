---
import AvisoObligatorios from '../ui/AvisoObligatorios.astro';
import Icono from '../ui/Icono.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import { DESTINOS, etiquetasDestino } from '../../lib/reportes/configuracion';

const claseSelect =
  'min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary disabled:cursor-not-allowed disabled:bg-neutral-50 disabled:text-neutral-400';
const claseEtiqueta = 'block text-sm font-medium text-neutral-800';
const selectores = [
  { id: 'rep-pais', name: 'id_pais', label: 'País', vacio: 'Todos los países' },
  { id: 'rep-organizacion', name: 'id_organizacion', label: 'Organización', vacio: 'Todas las organizaciones' },
  { id: 'rep-programa', name: 'id_programa', label: 'Programa Institucional', vacio: 'Todos los programas' },
];
const listas = [
  { id: 'indicadores', titulo: 'Indicadores', ayuda: 'Selecciona los indicadores que deseas incluir.' },
  { id: 'resultados', titulo: 'Resultados', ayuda: 'Selecciona los resultados que deseas incluir.' },
];
---

<section id="reporte-configuracion" class="reporte-config space-y-6" aria-busy="true">
  <!-- Paso 1: configurar. Paso 2: vista previa en su propia pantalla, con la descarga. -->
  <ol class="flex flex-wrap items-center gap-2 text-sm" aria-label="Pasos del reporte">
    <li id="rep-paso-1" class="rep-paso rep-paso-activo"><span>1</span> Configurar</li>
    <li aria-hidden="true" class="h-px w-6 bg-[#D8D3E8]"></li>
    <li id="rep-paso-2" class="rep-paso"><span>2</span> Vista previa y descarga</li>
  </ol>

  <div id="rep-paso-configurar" class="space-y-6">
  <header class="min-w-0">
    <p class="text-sm font-medium text-primary">Reportes consolidados</p>
    <h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">Configurar nuevo reporte</h1>
    <p class="mt-2 max-w-2xl text-sm text-neutral-500">
      Define el período y los criterios del reporte antes de solicitar su vista previa.
    </p>
  </header>

  <AvisoObligatorios />

  <div
    id="rep-catalogos-estado"
    role="status"
    aria-live="polite"
    class="rounded-xl border border-[#E4E0F2] bg-white px-4 py-3 text-sm text-neutral-500"
  >
    Cargando opciones de filtro…
  </div>
  <div
    id="rep-catalogos-error"
    role="alert"
    hidden
    class="flex flex-col gap-3 rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger sm:flex-row sm:items-center sm:justify-between"
  >
    <p id="rep-catalogos-error-texto"></p>
    <Button id="rep-reintentar" variant="outline" size="sm" class="shrink-0">Reintentar</Button>
  </div>

  <form id="rep-form" novalidate class="space-y-6">
    <Card class="tarjeta-acento acento-morado p-4 md:p-5">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-neutral-900">Período del reporte</h2>
        <p class="mt-1 text-sm text-neutral-500">Ambas fechas son obligatorias para solicitar el reporte.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div data-campo-wrap="fecha_inicio">
          <Input id="rep-fecha-inicio" name="fecha_inicio" type="date" label="Fecha de inicio" required min="0001-01-01" max="9999-12-31" />
        </div>
        <div data-campo-wrap="fecha_termino">
          <Input id="rep-fecha-termino" name="fecha_termino" type="date" label="Fecha de término" required min="0001-01-01" max="9999-12-31" />
        </div>
      </div>
    </Card>

    <Card class="tarjeta-acento acento-verde p-4 md:p-5">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-neutral-900">Filtros</h2>
        <p class="mt-1 text-sm text-neutral-500">Opcionales. Sin filtros se consideran todos los datos visibles para tu sesión.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {selectores.map((campo) => (
          <div data-campo-wrap={campo.name} class="space-y-1.5">
            <label for={campo.id} class={claseEtiqueta}>{campo.label}</label>
            <select id={campo.id} name={campo.name} class={claseSelect} disabled>
              <option value="">{campo.vacio}</option>
            </select>
            <p id={`${campo.id}-ayuda`} class="text-xs text-neutral-500" hidden></p>
          </div>
        ))}
      </div>

      <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
        {listas.map((lista) => (
          <div data-campo-wrap={lista.id}>
            <fieldset class="rep-lista rounded-xl border border-neutral-200 p-3" aria-describedby={`rep-${lista.id}-ayuda`}>
              <legend class="px-1 text-sm font-medium text-neutral-800">
                {lista.titulo} <span id={`rep-${lista.id}-contador`} class="font-normal text-neutral-500"></span>
              </legend>
              <p id={`rep-${lista.id}-ayuda`} class="px-1 text-xs text-neutral-500">{lista.ayuda}</p>
              <div id={`rep-${lista.id}-opciones`} class="mt-2 max-h-48 space-y-1 overflow-y-auto pr-1">
                <p class="px-1 py-2 text-sm text-neutral-500">Cargando opciones…</p>
              </div>
            </fieldset>
          </div>
        ))}
      </div>

      <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-3">
        <div data-campo-wrap="destino" class="space-y-1.5">
          <label for="rep-destino" class={claseEtiqueta}>Destino del reporte</label>
          <select id="rep-destino" name="destino" class={claseSelect}>
            {DESTINOS.map((destino) => <option value={destino}>{etiquetasDestino[destino]}</option>)}
          </select>
          <p class="text-xs text-neutral-500">Donantes y organismos externos reciben solo información agregada.</p>
        </div>
      </div>
    </Card>

    <Card class="tarjeta-acento acento-amarillo p-4 md:p-5">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-neutral-900">Filtros seleccionados</h2>
          <p id="rep-seleccion-resumen" class="mt-1 text-sm text-neutral-500" aria-live="polite"></p>
        </div>
        <Button id="rep-restablecer" variant="outline" size="sm" disabled>
          <Icono nombre="limpiar" />
          Restablecer filtros
        </Button>
      </div>
      <ul id="rep-seleccion" class="flex flex-wrap gap-2" aria-label="Filtros seleccionados"></ul>
    </Card>

    <p id="rep-error-general" role="alert" hidden class="rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger"></p>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <Button href="/reportes" variant="outline" data-descartar>Cancelar</Button>
      <Button id="rep-solicitar" type="submit" disabled>Solicitar vista previa</Button>
    </div>
  </form>

  <div id="rep-vista-disponible" hidden class="flex flex-col gap-3 rounded-2xl border border-[#D9D3EE] bg-[#F6F4FC] p-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-[#423C76]">Ya tienes una vista previa preparada con los filtros anteriores.</p>
    <Button id="rep-ver-vista" type="button" variant="outline" size="sm" class="shrink-0">Ver vista previa</Button>
  </div>

  <section id="rep-consulta" aria-label="Estado de la solicitud" aria-live="polite" class="space-y-3">
    <div id="rep-consulta-inactivo" class="rounded-2xl border border-dashed border-[#D8D3E8] bg-white p-4 text-center text-sm text-neutral-500">
      Completa el período y los filtros y presiona «Solicitar vista previa».
    </div>
    <div id="rep-consulta-carga" hidden role="status" class="flex items-center justify-center gap-3 rounded-2xl border border-[#E4E0F2] bg-white p-6 text-sm text-neutral-500">
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#D8D3E8] border-t-primary" aria-hidden="true"></span>
      Preparando la vista previa del reporte…
    </div>
    <div id="rep-consulta-error" hidden role="alert" class="flex flex-col gap-3 rounded-2xl border border-danger/20 bg-danger/5 p-5 text-sm text-danger sm:flex-row sm:items-center sm:justify-between">
      <p id="rep-consulta-error-texto"></p>
      <Button id="rep-consulta-reintentar" variant="outline" size="sm" class="shrink-0">Reintentar</Button>
    </div>
    <div id="rep-consulta-listo" hidden class="rounded-2xl border border-[#E4E0F2] bg-white p-4 md:p-5">
      <p class="text-sm font-semibold text-neutral-900">Solicitud preparada</p>
      <p class="mt-1 text-sm text-neutral-500">Los criterios son válidos y están listos para generar la vista previa.</p>
    </div>
    <div id="rep-consulta-parametros" hidden>
      <Card class="p-4 md:p-5">
        <p class="text-sm font-semibold text-neutral-900">Criterios de la solicitud</p>
        <dl id="rep-parametros" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2"></dl>
      </Card>
    </div>
  </section>
  </div>

  <div id="rep-paso-vista" hidden class="space-y-5">
    <!-- Barra superior de la vista previa: volver a los filtros y descargar el PDF. -->
    <div class="tarjeta-acento acento-morado relative overflow-hidden rounded-2xl border border-[#E2DDED] bg-white p-5 shadow-sm md:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <Button id="rep-volver-configurar" type="button" variant="ghost" size="sm" class="-ml-2">
            <span aria-hidden="true">←</span> Modificar filtros
          </Button>
          <h2 id="rep-vista-titulo" tabindex="-1" class="mt-2 text-2xl font-bold text-neutral-900 md:text-3xl">Vista previa del reporte</h2>
          <p class="mt-1 max-w-2xl text-sm text-neutral-500">Revisa la información antes de descargarla. El PDF tendrá el mismo contenido, período y filtros.</p>
        </div>

        <section id="rep-exportacion" hidden aria-live="polite" class="w-full min-w-0 lg:w-80 lg:shrink-0">
          <div id="rep-exportacion-lista">
            <Button id="rep-exportar-pdf" type="button" size="lg" class="w-full">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" /></svg>
              Descargar PDF
            </Button>
          </div>
    <div id="rep-exportacion-confirmacion" hidden class="rounded-xl border border-[#E4E0F2] bg-[#FAF9FC] p-4">
      <p class="text-sm font-semibold text-neutral-900">¿Generar el PDF?</p>
      <p class="mt-1 text-xs text-neutral-500">Se usará esta misma vista previa; no se vuelven a consultar datos.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <Button id="rep-confirmar-pdf" type="button" size="sm">Generar y descargar PDF</Button>
        <Button id="rep-cancelar-pdf" type="button" variant="outline" size="sm">Cancelar</Button>
      </div>
    </div>
    <div id="rep-exportacion-generando" hidden role="status" class="flex items-center gap-3">
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#D8D3E8] border-t-primary" aria-hidden="true"></span>
      <span class="text-sm text-neutral-600">Generando y descargando el PDF…</span>
    </div>
    <div id="rep-exportacion-exito" hidden role="status" class="rounded-xl border border-brand-green/30 bg-brand-green/10 px-4 py-3 text-sm text-[#14784D]"></div>
    <div id="rep-exportacion-error" hidden role="alert" class="flex flex-col gap-3 rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger sm:flex-row sm:items-center sm:justify-between">
      <p id="rep-exportacion-error-texto"></p>
      <Button id="rep-exportacion-reintentar" type="button" variant="outline" size="sm" class="shrink-0">Reintentar</Button>
    </div>
        </section>
      </div>
    </div>

    <div id="rep-consulta-exito" hidden role="status" class="rounded-2xl border border-brand-green/30 bg-brand-green/10 px-4 py-3 text-sm text-[#14784D]">
      Vista previa lista. Revisa la información antes de descargar el reporte.
    </div>

    <div id="rep-consulta-vacio" hidden role="status" class="rounded-2xl border border-dashed border-[#D8D3E8] bg-white p-6 text-center text-sm text-neutral-500">
      <p class="font-semibold text-neutral-800">No hay resultados para los criterios seleccionados.</p>
      <p class="mt-1">Amplía el período o quita algunos filtros y vuelve a solicitar la vista previa.</p>
    </div>

    <section id="rep-vista-previa" hidden aria-label="Vista previa del reporte" class="space-y-4"></section>
  </div>
</section>

<style>
  .reporte-config :global(.rep-paso) {
    display: inline-flex; align-items: center; gap: .5rem; padding: .3rem .8rem .3rem .3rem; border-radius: 999px;
    background: #fff; border: 1px solid #E4E0F2; color: #6B6680; font-weight: 500;
  }
  .reporte-config :global(.rep-paso span) {
    display: inline-flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 999px;
    background: #F0EDF8; color: #4C4688; font-size: .8rem; font-weight: 700;
  }
  .reporte-config :global(.rep-paso-activo) { border-color: #4C4688; color: #2B2654; font-weight: 600; }
  .reporte-config :global(.rep-paso-activo span) { background: #4C4688; color: #fff; }
  .reporte-config :global([aria-invalid='true']) { border-color: #C81E5B; }
  .reporte-config :global(.rep-lista label) {
    display: flex; align-items: flex-start; gap: .6rem; min-height: 40px; padding: .35rem .5rem;
    border-radius: .6rem; font-size: .875rem; color: #292536; cursor: pointer;
  }
  .reporte-config :global(.rep-lista label:hover) { background: #F5F3FA; }
  .reporte-config :global(.rep-lista input[type='checkbox']) { margin-top: .2rem; width: 1.05rem; height: 1.05rem; accent-color: #4C4688; }
  .reporte-config :global(.rep-chip) {
    display: inline-flex; align-items: center; gap: .4rem; max-width: 100%; min-height: 36px;
    padding: .25rem .35rem .25rem .8rem; border: 1px solid #DCD8EA; border-radius: 999px;
    background: #F4F2FA; color: #423C76; font-size: .8125rem; font-weight: 500;
  }
  .reporte-config :global(.rep-chip span) { overflow-wrap: anywhere; }
  .reporte-config :global(.rep-chip button) {
    display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0;
    border-radius: 999px; color: #4C4688; line-height: 1;
  }
  .reporte-config :global(.rep-chip button:hover) { background: #E6E1F4; }
  .reporte-config :global(.rep-param) { min-width: 0; padding: .75rem; border: 1px solid #E5E0EF; border-radius: .75rem; background: #F7F5FB; }
  .reporte-config :global(.rep-param dt) { color: #817B98; font-size: .72rem; font-weight: 600; letter-spacing: .045em; text-transform: uppercase; }
  .reporte-config :global(.rep-param dd) { margin-top: .35rem; color: #211E2B; font-size: .9rem; overflow-wrap: anywhere; }
  /* SCRUM-138: vista previa del reporte. */
  .reporte-config :global(.rep-vp-indice-enlace) {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .4rem .5rem .4rem .85rem;
    border: 1px solid #DCD8EA; border-radius: 999px; background: #fff; color: #423C76; font-size: .8125rem; font-weight: 500;
  }
  .reporte-config :global(.rep-vp-indice-enlace:hover) { background: #F4F2FA; }
  .reporte-config :global(.rep-vp-contador) {
    display: inline-flex; align-items: center; min-height: 24px; padding: .1rem .55rem; border-radius: 999px;
    background: #F0EDF8; color: #4C4688; font-size: .75rem; font-weight: 600; white-space: nowrap;
  }
  .reporte-config :global(.rep-vp-seccion) { scroll-margin-top: 5rem; }
  .reporte-config :global(.rep-vp-plegar),
  .reporte-config :global(.rep-vp-mas) {
    min-height: 44px; padding: .4rem .9rem; border: 1px solid #DCD8EA; border-radius: .75rem;
    background: #fff; color: #4C4688; font-size: .8125rem; font-weight: 600;
  }
  .reporte-config :global(.rep-vp-plegar:hover),
  .reporte-config :global(.rep-vp-mas:hover) { background: #F0EEF8; }
  .reporte-config :global(.rep-vp-mas) { margin-top: .75rem; }
  .reporte-config :global(.rep-vp-vacio) {
    padding: 1rem; border: 1px dashed #D8D3E8; border-radius: .75rem; background: #FAF9FC; color: #6B6680; font-size: .875rem; text-align: center;
  }
  .reporte-config :global(.rep-vp-tabla) { width: 100%; border-collapse: collapse; font-size: .875rem; }
  .reporte-config :global(.rep-vp-tabla th) {
    padding: .6rem .75rem; border-bottom: 1px solid #E5E0EF; background: #F7F5FB; color: #5F5A78;
    font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-align: left; text-transform: uppercase;
  }
  .reporte-config :global(.rep-vp-tabla td) {
    padding: .65rem .75rem; border-bottom: 1px solid #F0EDF6; color: #211E2B; vertical-align: top;
    white-space: pre-line; overflow-wrap: anywhere;
  }
  .reporte-config :global(.rep-vp-tabla tbody tr:hover) { background: #FCFBFE; }
  /* En pantallas pequeñas cada fila se presenta como tarjeta, sin desborde horizontal. */
  @media (max-width: 767px) {
    .reporte-config :global(.rep-vp-tabla thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .reporte-config :global(.rep-vp-tabla tr) {
      display: block; margin-bottom: .75rem; padding: .5rem .75rem; border: 1px solid #E5E0EF; border-radius: .75rem; background: #FCFBFE;
    }
    .reporte-config :global(.rep-vp-tabla td) {
      display: grid; grid-template-columns: minmax(0, 40%) minmax(0, 1fr); gap: .75rem; padding: .4rem 0; border-bottom: 1px solid #F0EDF6;
    }
    .reporte-config :global(.rep-vp-tabla td:last-child) { border-bottom: 0; }
    .reporte-config :global(.rep-vp-tabla td::before) {
      content: attr(data-etiqueta); color: #817B98; font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
    }
  }
</style>

<script>
  import { iniciarConfiguracionReporte } from '../../lib/reportes/interfaz-configuracion';
  iniciarConfiguracionReporte();
</script>
