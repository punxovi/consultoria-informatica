---
import AvisoObligatorios from '../ui/AvisoObligatorios.astro';
import Icono from '../ui/Icono.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import EmptyState from '../ui/EmptyState.astro';
import EncabezadoModulo from '../ui/EncabezadoModulo.astro';

interface Props {
  idOrganizacion: string;
}

const { idOrganizacion } = Astro.props;

---

<section
  id="actas-reunion"
  data-organizacion={idOrganizacion}
  class="relative space-y-6"
  aria-labelledby="actas-titulo"
>
  <EncabezadoModulo id="actas-titulo" titulo="Actas de reunión" descripcion="Reuniones, participantes y acuerdos de la organización.">
    <Button id="actas-nueva" disabled>
      <span aria-hidden="true">＋</span> Registrar acta
    </Button>
  </EncabezadoModulo>

  <!-- Error general -->
  <p
    id="actas-error"
    hidden
    role="alert"
    class="rounded-lg border border-danger bg-red-50 p-4 text-sm text-red-800"
  ></p>

  <p id="actas-mensaje" hidden role="status" aria-live="polite"></p>
  <p id="actas-catalogo-estado" hidden class="rounded-lg bg-neutral-100 p-4 text-sm"></p>
  <div id="actas-recuperacion" hidden>
    <Button id="actas-recargar" variant="outline">Reintentar</Button>
  </div>

  <!-- Carga -->
  <div id="actas-carga" hidden role="status" aria-live="polite">
    <Card>
      <div class="py-8 text-center">
        <div
          class="mx-auto h-8 w-8 animate-spin rounded-full border-4 border-neutral-200 border-t-primary"
          aria-hidden="true"
        ></div>

        <p class="mt-4 text-sm font-medium text-neutral-700">
          Cargando actas...
        </p>
      </div>
    </Card>
  </div>

  <!-- Estado vacío compartido con Compromisos -->
  <EmptyState
    id="actas-vacio"
    hidden
    title="Todavía no hay actas"
    description="Cuando registres un acta de reunión para esta organización, aparecerá aquí con sus participantes y acuerdos."
  />

  <!-- Historial -->
  <div id="actas-historial" hidden class="space-y-3">
    <p id="cantidad-actas" class="modulo-conteo"></p>
    <div id="lista-actas" class="space-y-3"></div>
  </div>

  <!-- Formulario -->
  <div id="actas-formulario-contenedor" hidden>
    <form
      id="actas-formulario"
      novalidate
      class="space-y-5"
    >
      <Card>
        <div class="mb-6">
          <h3
            id="actas-formulario-titulo"
            class="text-xl font-semibold text-neutral-900"
          >
            Registrar acta
          </h3>

          <p class="mt-2 text-sm leading-6 text-neutral-500">
            Completa la información de la reunión, registra a sus participantes y agrega los compromisos acordados.
          </p>
          <AvisoObligatorios />
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          <Select
            id="actas-plan"
            name="id_plan"
            label="Plan relacionado"
            options={[]}
            placeholder="Selecciona un plan"
            required
            hint="Primero selecciona un plan de intervención. Luego podrás elegir una acción relacionada con ese plan."
          />
          <p
            id="error-plan-acta"
            data-error-acta
            hidden
            class="mt-1 text-sm text-danger"
          ></p>

          <Select
            id="actas-accion"
            name="id_accion"
            label="Acción relacionada"
            options={[]}
            placeholder="Selecciona una acción"
          />
          <p
            id="error-accion-acta"
            data-error-acta
            hidden
            class="mt-1 text-sm text-danger"
          ></p>
        </div>

        <div class="mt-5">
          <Input
            id="actas-fecha"
            name="fecha_reunion"
            label="Fecha de la reunión"
            type="date"
            required
            hint="La fecha no puede ser posterior a la fecha actual."
          />
        <p
          id="error-fecha-acta"
          data-error-acta
          hidden
          class="mt-1 text-sm text-danger"
        ></p>

        </div>
      </Card>

      <Card>
        <h3 class="text-lg font-semibold text-neutral-900">Participantes de la reunión</h3>

        <p class="mt-2 text-sm leading-6 text-neutral-500">
          Selecciona a las personas del sistema que participaron y registra los asistentes externos cuando corresponda.
        </p>

        <div class="mt-5">
          <label
            for="actas-asistentes"
            class="block text-sm font-medium text-neutral-800"
          >
            Usuarios del sistema
           <span class="marca-obligatorio" aria-hidden="true">*</span>
          </label>

          <select
            id="actas-asistentes"
            name="asistentes"
            multiple
            required
            class="mt-1.5 min-h-[140px] w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          >

          </select>

          <p class="mt-1.5 text-sm text-neutral-500">
            Mantén presionada la tecla Ctrl para seleccionar más de una persona.
          </p>

          <p
            id="error-asistentes-acta"
            data-error-acta
            hidden
            class="mt-1 text-sm text-danger"
          ></p>
        </div>

        <div class="mt-5">
          <Input
            id="actas-asistentes-externos"
            name="asistentes_externos"
            label="Asistentes externos"
            maxlength={500}
            placeholder="Ej: María González, representante de la organización"
            hint="Opcional."
          />
        </div>
      </Card>

      <Card>
        <div class="space-y-5">
          <div>
            <label
              for="actas-objetivo"
              class="block text-sm font-medium text-neutral-800"
            >
              Objetivo de la reunión
             <span class="marca-obligatorio" aria-hidden="true">*</span>
            </label>

            <textarea
              id="actas-objetivo" maxlength="1000"
              name="objetivo"
              required
              rows="4"
              placeholder="Describe el objetivo principal de la reunión..."
              class="mt-1.5 w-full resize-y rounded-lg border border-neutral-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            ></textarea>

            <p
              id="error-objetivo-acta"
              data-error-acta
              hidden
              class="mt-1 text-sm text-danger"
            ></p>
          </div>

          <div>
            <label
              for="actas-observaciones"
              class="block text-sm font-medium text-neutral-800"
            >
              Notas u observaciones
              <span class="ml-1 text-sm font-normal text-neutral-500">
                (opcional)
              </span>
            </label>

            <textarea
              id="actas-observaciones" maxlength="2000"
              name="observaciones"
              rows="5"
              placeholder="Registra notas, acuerdos u observaciones relevantes..."
              class="mt-1.5 w-full resize-y rounded-lg border border-neutral-300 bg-white px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            ></textarea>
          </div>
        </div>
      </Card>

      <Card>
        <section id="actas-compromisos" class="space-y-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#77719F]">Acuerdos y tareas</p>
            <h3 class="mt-1 text-lg font-semibold text-neutral-900">Compromisos del acta</h3>
            <p class="mt-2 text-sm leading-6 text-neutral-500">Agrega uno o más acuerdos, asigna una persona responsable y define una fecha límite. Se guardarán junto con el acta.</p>
          </div>
          <div data-borradores class="space-y-4"></div>
          <Button id="actas-agregar-compromiso" variant="outline">Agregar compromiso al acta</Button>
        </section>
      </Card>


      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <Button id="actas-cancelar" data-descartar type="button" variant="outline">Cancelar</Button>
        <Button id="actas-guardar" type="submit">Guardar acta</Button>
      </div>
    </form>
  </div>

  <!-- Ficha / detalle del acta -->
  <div id="actas-detalle" hidden class="space-y-5">
    <Card>
      <div class="space-y-6">
        <div class="flex flex-col gap-4 border-b border-[#E8E4F1] pb-5 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex items-start gap-3">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#F0EDF8] text-[#4C4688]" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h4"/></svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#77719F]">Ficha de reunión</p>
              <h3 class="mt-1 text-xl font-bold text-neutral-900">Acta de reunión</h3>
              <p id="detalle-fecha" class="mt-1 text-sm text-neutral-500"></p>
            </div>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row">
            <!-- Solo se muestra si el acta tiene compromisos; genera el mismo PDF que el detalle del compromiso. -->
            <Button id="actas-pdf-compromisos" type="button" variant="outline">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mr-1.5 h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" />
              </svg>
              Descargar PDF de compromisos
            </Button>
            <Button id="actas-editar" type="button" variant="outline"> <Icono nombre="editar" /> Editar acta
            </Button>
            <Button id="actas-volver" type="button" variant="outline">Volver al historial</Button>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-[#E8E4F1] bg-[#FAF9FC] p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Plan relacionado</p>
            <p id="detalle-plan" class="mt-2 text-sm font-medium text-neutral-900"></p>
          </div>
          <div class="rounded-xl border border-[#D9F0F3] bg-[#F3FBFC] p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Acción relacionada</p>
            <p id="detalle-accion" class="mt-2 text-sm font-medium text-neutral-900"></p>
          </div>
        </div>

        <div class="space-y-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Participantes del sistema</p>
          <div id="detalle-asistentes" class="flex flex-wrap gap-2"></div>
          <p id="detalle-asistentes-externos" hidden class="text-sm leading-6 text-neutral-700"></p>
        </div>

        <div class="rounded-xl bg-[#FAF9FC] p-4 sm:p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Objetivo de la reunión</p>
          <p id="detalle-objetivo" class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"></p>
        </div>

        <div class="rounded-xl border border-neutral-100 p-4 sm:p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Notas u observaciones</p>
          <p id="detalle-observaciones" class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"></p>
        </div>
      </div>
    </Card>

    <Card>
      <div class="space-y-5">
        <div class="actas-adjuntos-encabezado">
          <div class="actas-adjuntos-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.1 12.2 20.3a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-neutral-900">Archivos adjuntos</h3>
            <p class="mt-1 text-sm leading-6 text-neutral-500">Adjunta documentos, imágenes, audios o videos relacionados con esta reunión. Tamaño máximo por archivo: 50 MB.</p>
          </div>
        </div>

        <div class="actas-adjuntos-carga" id="actas-adjuntos-carga">
          <div class="min-w-0 space-y-1.5">
            <label for="actas-adjuntos-archivos">Archivos <span class="font-normal text-neutral-500">(opcional)</span></label>
            <input id="actas-adjuntos-archivos" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.mp3,.ogg,.wav,.mp4,.webm,application/pdf,image/jpeg,image/png,image/webp,audio/mpeg,audio/ogg,audio/wav,video/mp4,video/webm" aria-describedby="actas-adjuntos-ayuda" />
            <p id="actas-adjuntos-ayuda" class="text-sm leading-5 text-neutral-500">PDF, imágenes, audio o video. Puedes seleccionar varios, hasta 50 MB por archivo.</p>
          </div>
          <div id="actas-adjuntos-seleccionados" class="actas-adjuntos-seleccionados" hidden aria-live="polite"></div>
          <Button id="actas-adjuntos-subir" type="button">Cargar archivos seleccionados</Button>
        </div>
        <div class="actas-adjuntos-guardados">
          <h4 class="text-base font-semibold text-neutral-900">Archivos adjuntos</h4>
          <div id="actas-adjuntos-lista" class="space-y-2 text-sm text-neutral-500">Cargando archivos adjuntos…</div>
        </div>
        <p id="actas-adjuntos-mensaje" hidden role="status" aria-live="polite" class="actas-adjuntos-mensaje rounded-lg p-3 text-sm"></p>
      </div>
    </Card>

    <Card>
      <div class="mb-4 flex items-start gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E7F7FA] text-[#1BAAC1]" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h12M8 12h12M8 18h12"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-neutral-900">Compromisos asociados</h3>
          <p class="mt-1 text-sm leading-6 text-neutral-500">Acuerdos registrados en esta reunión, con sus responsables, fechas límite y estado.</p>
        </div>
      </div>
      <div id="actas-compromisos-detalle" class="space-y-3"></div>
    </Card>
  </div>
</section>


<style>
  #actas-reunion {
    --actas-purple: #4C4688;
    --actas-purple-soft: #F0EDF8;
    --actas-border: #E5E1EF;
  }

  #actas-reunion :global(#actas-carga > div),
  #actas-reunion :global(#actas-vacio > div) {
    border: 1px solid var(--actas-border);
    border-radius: 16px;
    box-shadow: 0 4px 14px rgb(38 28 76 / 5%);
  }

  #actas-reunion :global(#actas-compromisos-detalle > *) {
    border: 1px solid #E2DEED !important;
    border-left: 3px solid var(--color-brand-cyan) !important;
    border-radius: 12px !important;
    background: #FCFBFE !important;
    padding: 14px 16px !important;
    line-height: 1.6;
  }

  #actas-reunion :global(#actas-compromisos [data-borradores] > *) {
    border: 1px solid #E2DEED;
    border-radius: 14px;
    background: #FCFBFE;
    padding: 16px;
  }

  #actas-reunion :global(#detalle-asistentes > *) {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--actas-purple-soft);
    padding: 5px 11px;
    color: var(--actas-purple);
    font-size: 0.875rem;
  }


  /* Presentación verde para archivos adjuntos. No modifica Compromisos asociados. */
  #actas-reunion .actas-adjuntos-encabezado {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: transparent;
    padding: 0;
  }

  #actas-reunion .actas-adjuntos-icono {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #DDF4E8;
    color: #159765;
  }

  #actas-reunion .actas-adjuntos-icono { width: 48px; height: 48px; }
  #actas-reunion .actas-adjuntos-icono svg { width: 24px; height: 24px; }

  #actas-reunion .actas-adjuntos-carga {
    display: grid;
    gap: 12px;
  }



  #actas-reunion :global(#actas-adjuntos-subir) {
    width: fit-content;
  }

  #actas-reunion .actas-adjuntos-mensaje {
    border: 1px solid #D6EDE0;
    background: #F0FAF4;
    color: #176B4B;
  }

  #actas-reunion :global(#actas-adjuntos-lista > *) {
    border: 1px solid #DCEBE2;
    border-radius: 12px;
    background: #FBFEFC;
    padding: 12px 14px;
  }

  :global(#actas-reunion .actas-adjuntos-seleccionados) {
    display: grid;
    gap: 10px;
  }

  :global(#actas-reunion .actas-adjuntos-seleccionados[hidden]) {
    display: none;
  }

  :global(#actas-reunion .actas-adjunto-seleccionado),
  :global(#actas-reunion .actas-adjunto-guardado) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 14px;
    border: 1px solid #E2E4F1;
    border-radius: 13px;
    background: #FAFAFD;
    padding: 10px 13px;
  }

  :global(#actas-reunion .actas-adjunto-guardado) {
    border-color: #DCEFE4;
    border-left: 3px solid var(--color-brand-green);
    background: linear-gradient(100deg, #F3FBF6 0%, #F8FCF9 100%);
    padding: 11px 14px;
  }

  :global(#actas-reunion .actas-adjunto-tipo) {
    display: flex;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    color: #647084;
  }

  /* Acciones con la misma forma y jerarquía visual que los botones del módulo. */
  :global(#actas-reunion .actas-adjunto-eliminar),
  :global(#actas-reunion .actas-adjunto-descargar) {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid;
    border-radius: 11px;
    background: #fff;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 150ms ease, border-color 150ms ease, color 150ms ease;
    cursor: pointer;
  }

  :global(#actas-reunion .actas-adjunto-descargar) {
    border-color: #36BD8A;
    color: #159765;
  }

  :global(#actas-reunion .actas-adjunto-descargar:hover) {
    background: #EFF9F3;
  }

  :global(#actas-reunion .actas-adjunto-eliminar) {
    border-color: #F2B8B8;
    color: #C24141;
  }

  :global(#actas-reunion .actas-adjunto-eliminar:hover) {
    border-color: #E99A9A;
    background: #FFF5F5;
    color: #B42323;
  }

  :global(#actas-reunion .actas-adjunto-eliminar:disabled),
  :global(#actas-reunion .actas-adjunto-descargar:disabled) {
    cursor: not-allowed;
    opacity: 0.55;
  }

  #actas-reunion .actas-adjuntos-guardados {
    display: grid;
    gap: 10px;
    border-top: 1px solid #E5E7EB;
    padding-top: 14px;
  }

</style>

<script>
  import { iniciarActasReunion } from '../../lib/actas-reunion/interfaz';

  void iniciarActasReunion();
</script>
