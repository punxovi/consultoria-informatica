
---
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';

interface Props {
  idOrganizacion?: string;
}

const { idOrganizacion = '' } = Astro.props;
const esEdicion = Boolean(idOrganizacion);

const paisesPlaceholder = [
  { value: '4050c89c-1460-440d-a63d-4a9f063b3007', label: 'Chile' },
  { value: '1294ac21-fa90-49d8-bfdf-9b6f33006171', label: 'Argentina' },
  { value: '3eeb7a43-3c70-4a2e-8cb5-5a1ec778dbd1', label: 'Uruguay' },
];

const tiposOrganizacion = [
  { value: 'comedor_merendero', label: 'Comedor solidario / Merendero' },
  { value: 'centro_comunitario', label: 'Centro comunitario' },
  { value: 'emprendimiento_uv', label: 'Emprendimiento UV+' },
  { value: 'otra', label: 'Otra' },
];
---

<section class="w-full">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-neutral-900">
      {esEdicion ? 'Editar Organización' : 'Nueva Organización'}
    </h1>
    <p class="mt-1 text-sm text-neutral-500">
      {esEdicion
        ? 'Actualiza la información de la organización.'
        : 'Registra una nueva Organización.'}
    </p>
  </div>

  <p
    id="organizacion-estado"
    role="status"
    aria-live="polite"
    class="mb-4 text-sm text-neutral-700"
    hidden={!esEdicion}
  >
    Cargando organización...
  </p>

  <div
    id="organizacion-error"
    role="alert"
    hidden
    class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"
  ></div>

  <div id="organizacion-recuperacion" hidden class="mb-4 flex flex-wrap gap-3">
    <Button id="recargar-organizacion" variant="outline">
      Reintentar
    </Button>
    <a href="/login" class="inline-flex items-center text-primary underline">
      Iniciar sesión
    </a>
  </div>

  <Card class="w-full">
    <form
      id="form-organizacion"
      data-modo={esEdicion ? 'editar' : 'crear'}
      data-id={idOrganizacion}
      novalidate
      aria-busy={esEdicion ? 'true' : 'false'}
      hidden={esEdicion}
      class="grid grid-cols-1 gap-5 md:grid-cols-2"
    >
      <fieldset
        id="campos-organizacion"
        disabled={esEdicion}
        class="contents"
      >
        <div class="md:col-span-2">
          <Input
            id="nombre"
            name="nombre"
            label="Nombre de la Organización"
            placeholder="Ej: Comedor Los Aromos"
            required
            maxlength={150}
          />
        </div>

        <div class="md:col-span-2">
          <Input
            id="nombre_representante"
            name="nombre_representante"
            label="Nombre del representante, dirigente o líder"
            required
            maxlength={150}
          />
        </div>

        <Input
          id="telefono"
          name="telefono"
          label="Teléfono de contacto"
          type="tel"
          placeholder="Ej: 9 12345678"
          hint="Máximo 15 números."
          maxlength={25}
          required
        />

        <Input
          id="correo"
          name="correo"
          label="Correo electrónico"
          type="email"
          required
        />

        <Select
          id="id_pais"
          name="id_pais"
          label="País"
          options={paisesPlaceholder}
          placeholder="Selecciona un país"
          required
          hint="Opciones provisionales: aún falta conectar el listado real de países."
        />

        <Select
          id="tipo_organizacion"
          name="tipo_organizacion"
          label="Tipo de Organización"
          options={tiposOrganizacion}
          placeholder="Selecciona un tipo"
          required
        />

        <Input
          id="region_departamento"
          name="region_departamento"
          label="Región / Departamento"
          required
          maxlength={120}
        />

        <Input
          id="comuna_municipio_ciudad"
          name="comuna_municipio_ciudad"
          label="Comuna / Municipio / Ciudad"
          required
          maxlength={120}
        />

        <div class="md:col-span-2">
          <Input
            id="direccion"
            name="direccion"
            label="Dirección"
            required
            maxlength={250}
          />
        </div>

        <div id="grupo-tipo-otro" class="hidden md:col-span-2">
          <Input
            id="tipo_organizacion_otro"
            name="tipo_organizacion_otro"
            label={'Especifica el tipo de Organización ("Otra")'}
            maxlength={100}
          />
        </div>

        <div class="space-y-1.5">
          <label
            for="publico_objetivo"
            class="text-sm font-medium text-neutral-800"
          >
            Público objetivo
            <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <textarea
            id="publico_objetivo"
            name="publico_objetivo"
            required
            maxlength="500"
            rows="5"
            class="mt-1.5 w-full resize-y rounded-lg border border-neutral-300 px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        </div>

        <div class="space-y-1.5">
          <label
            for="descripcion_breve"
            class="text-sm font-medium text-neutral-800"
          >
            Descripción general
            <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <textarea
            id="descripcion_breve"
            name="descripcion_breve"
            required
            maxlength="1000"
            rows="5"
            class="mt-1.5 w-full resize-y rounded-lg border border-neutral-300 px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        </div>

        <div class="md:col-span-2">
          <Input
            id="numero_beneficiarios"
            name="numero_beneficiarios"
            label="Número de beneficiarios atendidos"
            type="number"
            required
          />
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-neutral-100 pt-5 sm:flex-row sm:justify-end md:col-span-2">
          <Button
            id="cancelar-organizacion"
            variant="outline"
            href={esEdicion
              ? `/organizaciones/${encodeURIComponent(idOrganizacion)}`
              : '/organizaciones'}
          >
            Cancelar
          </Button>
          <Button id="guardar-organizacion" type="submit">
            {esEdicion ? 'Guardar cambios' : 'Guardar'}
          </Button>
        </div>
      </fieldset>
    </form>
  </Card>
</section>

<script>
  import {
    actualizarOrganizacionSchema,
    crearOrganizacionSchema,
  } from '../../lib/validaciones/organizaciones';
  import {
    actualizarOrganizacion,
    crearOrganizacion,
    listarPaisesOrganizaciones,
    obtenerOrganizacion,
  } from '../../lib/organizaciones/cliente';
  import type { Organizacion } from '../../lib/modelos/organizaciones';

  const form = document.querySelector<HTMLFormElement>(
    '#form-organizacion',
  );
  const campos = document.querySelector<HTMLFieldSetElement>(
    '#campos-organizacion',
  );
  const estado = document.querySelector<HTMLElement>(
    '#organizacion-estado',
  );
  const error = document.querySelector<HTMLElement>(
    '#organizacion-error',
  );
  const recuperacion = document.querySelector<HTMLElement>(
    '#organizacion-recuperacion',
  );
  const recargar = document.querySelector<HTMLButtonElement>(
    '#recargar-organizacion',
  );
  const selectTipo = document.querySelector<HTMLSelectElement>(
    '#tipo_organizacion',
  );
  const grupoOtro = document.querySelector<HTMLElement>(
    '#grupo-tipo-otro',
  );
  const inputOtro = document.querySelector<HTMLInputElement>(
    '#tipo_organizacion_otro',
  );
  const inputTelefono = document.querySelector<HTMLInputElement>('#telefono');
  const selectPais = document.querySelector<HTMLSelectElement>('#id_pais');
  const guardar = document.querySelector<HTMLButtonElement>(
    '#guardar-organizacion',
  );

  if (
    !form ||
    !campos ||
    !estado ||
    !error ||
    !recuperacion ||
    !recargar ||
    !guardar ||
    !selectPais
  ) {
    throw new Error('No se encontraron los elementos del formulario de organización.');
  }

  const esEdicion = form.dataset.modo === 'editar';
  const idOrganizacion = form.dataset.id ?? '';
  let versionActual: number | undefined;
  let guardando = false;

  inputTelefono?.addEventListener('input', () => {
    let cantidadDigitos = 0;
    inputTelefono.value = Array.from(inputTelefono.value)
      .filter((caracter) => {
        if (!/\d/.test(caracter)) return true;
        cantidadDigitos += 1;
        return cantidadDigitos <= 15;
      })
      .join('');
  });

  function actualizarVisibilidadOtro() {
    const esOtra = selectTipo?.value === 'otra';
    grupoOtro?.classList.toggle('hidden', !esOtra);

    if (inputOtro) {
      inputOtro.required = Boolean(esOtra);
      if (!esOtra) inputOtro.value = '';
    }
  }

  selectTipo?.addEventListener('change', actualizarVisibilidadOtro);
  actualizarVisibilidadOtro();

  function mostrarError(titulo: string, mensaje: string, requiereSesion = false) {
    estado!.textContent = titulo;
    error!.textContent = mensaje;
    error!.hidden = false;
    recuperacion!.hidden = !requiereSesion;
  }

  function asignarValor(id: string, valor: string | number | null | undefined) {
    const campo = form!.querySelector<
      HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
    >(`#${id}`);

    if (campo) campo.value = valor == null ? '' : String(valor);
  }

  function seleccionarPais(nombre: string, idPais: string) {
    if (!nombre || !idPais) return;

    const normalizar = (valor: string) =>
      valor.trim().toLocaleLowerCase('es');

    const opcion = Array.from(selectPais!.options).find(
      (item) => normalizar(item.textContent ?? '') === normalizar(nombre),
    );

    if (opcion) {
      opcion.value = idPais;
      selectPais!.value = idPais;
      return;
    }

    const nuevaOpcion = new Option(nombre, idPais, true, true);
    selectPais!.add(nuevaOpcion);
    selectPais!.value = idPais;
  }

  async function cargarPaises() {
    const seleccionPrevia = selectPais!.value;
    const paises = await listarPaisesOrganizaciones();
    selectPais!.replaceChildren(new Option('Selecciona un país', '', true, false));
    for (const pais of paises) {
      selectPais!.add(new Option(pais.nombre, pais.id_pais));
    }
    if (paises.some((pais) => pais.id_pais === seleccionPrevia)) {
      selectPais!.value = seleccionPrevia;
    }
  }

  function precargarOrganizacion(organizacion: Organizacion) {
    const valores: Record<string, string | number | null | undefined> = {
      nombre: organizacion.nombre,
      nombre_representante: organizacion.nombre_representante,
      telefono: organizacion.telefono,
      correo: organizacion.correo,
      tipo_organizacion: organizacion.tipo_organizacion,
      tipo_organizacion_otro: organizacion.tipo_organizacion_otro,
      region_departamento: organizacion.region_departamento,
      comuna_municipio_ciudad: organizacion.comuna_municipio_ciudad,
      direccion: organizacion.direccion,
      publico_objetivo: organizacion.publico_objetivo,
      descripcion_breve: organizacion.descripcion_breve,
      numero_beneficiarios: organizacion.numero_beneficiarios,
    };

    for (const [id, valor] of Object.entries(valores)) {
      asignarValor(id, valor);
    }

    seleccionarPais(
      organizacion.pais?.nombre ?? '',
      organizacion.id_pais,
    );
    versionActual = organizacion.version;
    actualizarVisibilidadOtro();
  }

  function obtenerValor(nombre: string) {
    const campo = form!.elements.namedItem(nombre) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;

    return campo?.value ?? '';
  }

  function obtenerCambiosFormulario() {
    const otro = obtenerValor('tipo_organizacion_otro').trim();

    return {
      id_pais: obtenerValor('id_pais'),
      nombre: obtenerValor('nombre'),
      nombre_representante: obtenerValor('nombre_representante'),
      telefono: obtenerValor('telefono'),
      correo: obtenerValor('correo'),
      region_departamento: obtenerValor('region_departamento'),
      comuna_municipio_ciudad: obtenerValor('comuna_municipio_ciudad'),
      direccion: obtenerValor('direccion'),
      publico_objetivo: obtenerValor('publico_objetivo'),
      descripcion_breve: obtenerValor('descripcion_breve'),
      tipo_organizacion: obtenerValor('tipo_organizacion'),
      tipo_organizacion_otro: otro || null,
      numero_beneficiarios: Number(obtenerValor('numero_beneficiarios')),
    };
  }

  async function cargarOrganizacion() {
    if (!esEdicion) return;

    if (!idOrganizacion) {
      mostrarError(
        'Organización no encontrada',
        'No se proporcionó el identificador de la organización.',
      );
      return;
    }

    estado!.textContent = 'Cargando organización...';
    error!.hidden = true;
    recuperacion!.hidden = true;
    recargar!.disabled = true;
    form!.hidden = true;
    form!.setAttribute('aria-busy', 'true');

    try {
      await cargarPaises();
      precargarOrganizacion(await obtenerOrganizacion(idOrganizacion));
      campos!.disabled = false;
      form!.hidden = false;
      estado!.textContent = '';
    } catch (fallo) {
      const mensaje =
        fallo instanceof Error
          ? fallo.message
          : 'Ocurrió un error inesperado.';

      mostrarError(
        'No fue posible cargar la organización',
        mensaje,
        mensaje.toLocaleLowerCase('es').includes('sesión'),
      );
    } finally {
      recargar!.disabled = false;
      form!.setAttribute('aria-busy', 'false');
    }
  }

  recargar.addEventListener('click', () => {
    void cargarOrganizacion();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (guardando || !form!.reportValidity()) return;

    error!.hidden = true;
    recuperacion!.hidden = true;

    const datosFormulario = obtenerCambiosFormulario();
    const validacion = esEdicion
      ? actualizarOrganizacionSchema.safeParse({
          id_organizacion: idOrganizacion,
          version_esperada: versionActual,
          cambios: datosFormulario,
        })
      : crearOrganizacionSchema.safeParse(datosFormulario);

    if (!validacion.success) {
      mostrarError(
        'Revisa los datos ingresados',
        validacion.error.issues[0]?.message ??
          'Hay campos que no cumplen el formato solicitado.',
      );
      return;
    }

    guardando = true;
    campos!.disabled = true;
    guardar!.disabled = true;
    guardar!.textContent = 'Guardando...';
    estado!.textContent = esEdicion ? 'Guardando cambios...' : 'Guardando organización...';
    form!.setAttribute('aria-busy', 'true');

    try {
      const organizacion = esEdicion
        ? await actualizarOrganizacion(
            idOrganizacion,
            datosFormulario as Parameters<typeof actualizarOrganizacion>[1],
            versionActual,
          )
        : await crearOrganizacion(
            datosFormulario as Parameters<typeof crearOrganizacion>[0],
          );

      estado!.textContent = esEdicion
        ? 'Organización actualizada correctamente.'
        : 'Organización creada correctamente.';
      window.location.replace(
        `/organizaciones/${encodeURIComponent(organizacion.id_organizacion)}?resultado=${esEdicion ? 'actualizado' : 'creado'}`,
      );
    } catch (fallo) {
      const mensaje =
        fallo instanceof Error
          ? fallo.message
          : 'Ocurrió un error inesperado al guardar.';

      mostrarError(
        'No fue posible guardar los cambios',
        mensaje,
        mensaje.toLocaleLowerCase('es').includes('sesión'),
      );
      campos!.disabled = false;
    } finally {
      guardando = false;
      guardar!.disabled = false;
      guardar!.textContent = esEdicion ? 'Guardar cambios' : 'Guardar';
      form!.setAttribute('aria-busy', 'false');
    }
  });

  if (esEdicion) {
    void cargarOrganizacion();
  } else {
    campos.disabled = true;
    void cargarPaises()
      .then(() => { campos.disabled = false; })
      .catch((fallo) => {
        mostrarError(
          'No fue posible preparar el formulario',
          fallo instanceof Error ? fallo.message : 'No se pudieron cargar los países.',
          true,
        );
      });
  }
</script>
