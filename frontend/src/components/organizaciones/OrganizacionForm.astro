---
import AvisoObligatorios from '../ui/AvisoObligatorios.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';

interface Props {
  idOrganizacion?: string;
}

const { idOrganizacion = '' } = Astro.props;
const esEdicion = Boolean(idOrganizacion);

const paisesPlaceholder = [
  { value: '4050c89c-1460-440d-a63d-4a9f063b3007', label: 'Chile' },
  { value: '1294ac21-fa90-49d8-bfdf-9b6f33006171', label: 'Argentina' },
  { value: '3eeb7a43-3c70-4a2e-8cb5-5a1ec778dbd1', label: 'Uruguay' },
];

const tiposOrganizacion = [
  { value: 'comedor_merendero', label: 'Comedor solidario / Merendero' },
  { value: 'centro_comunitario', label: 'Centro comunitario' },
  { value: 'emprendimiento_uv', label: 'Emprendimiento UV+' },
  { value: 'otra', label: 'Otra' },
];
---

<section class="w-full space-y-5">
  <header class="min-w-0">
    <h1 class="text-2xl font-bold tracking-tight text-neutral-900 md:text-3xl">
      {esEdicion ? 'Editar organización' : 'Nueva organización'}
    </h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-neutral-600 md:text-base">
      {esEdicion
        ? 'Actualiza los datos de identificación, contacto y alcance de la organización.'
        : 'Registra la información de identificación, contacto y alcance de la organización.'}
    </p>
  </header>

  <p
    id="organizacion-estado"
    role="status"
    aria-live="polite"
    class="text-sm text-neutral-600"
    hidden={!esEdicion}
  >
    Cargando organización...
  </p>

  <div
    id="organizacion-error"
    role="alert"
    hidden
    class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800"
  ></div>

  <div id="organizacion-recuperacion" hidden class="flex flex-wrap gap-3">
    <Button id="recargar-organizacion" variant="outline">Reintentar</Button>
    <a href="/login" class="inline-flex min-h-11 items-center text-primary underline">Iniciar sesión</a>
  </div>

  <AvisoObligatorios />

  <form
    id="form-organizacion"
    data-modo={esEdicion ? 'editar' : 'crear'}
    data-id={idOrganizacion}
    novalidate
    aria-busy={esEdicion ? 'true' : 'false'}
    hidden={esEdicion}
    class="w-full space-y-5"
  >
    <fieldset id="campos-organizacion" disabled={esEdicion} class="min-w-0 space-y-5">
      <Card class="w-full tarjeta-acento acento-morado p-5 md:p-6">
        <div class="flex items-start gap-3 border-b border-neutral-100 pb-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#F0EDF8] text-[#4C4688]" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 20V7.5L12 4l8 3.5V20H4Z"/><path stroke-linecap="round" d="M9 20v-4h6v4M8 10h.01M12 10h.01M16 10h.01"/>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-bold text-neutral-900">Identificación y contacto</h2>
            <p class="mt-1 text-sm text-neutral-500">Datos principales de la organización y de su representante.</p>
          </div>
        </div>

        <div class="mt-5 grid min-w-0 grid-cols-1 gap-5 md:grid-cols-2">
          <div class="md:col-span-2">
            <Input id="nombre" name="nombre" label="Nombre de la organización" placeholder="Ej.: Comedor Los Aromos" required maxlength={150} />
          </div>
          <div class="md:col-span-2">
            <Input id="nombre_representante" name="nombre_representante" label="Nombre del representante, dirigente o líder" required maxlength={150} />
          </div>
          <Input id="telefono" name="telefono" label="Teléfono de contacto" type="tel" placeholder="Ej.: 9 12345678" hint="Máximo 15 números." maxlength={25} required />
          <Input id="correo" name="correo" label="Correo electrónico" type="email" required />
        </div>
      </Card>

      <Card class="w-full tarjeta-acento acento-celeste p-5 md:p-6">
        <div class="flex items-start gap-3 border-b border-neutral-100 pb-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E7F7FA] text-[#1BAAC1]" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.3"/>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-bold text-neutral-900">Ubicación y tipo de organización</h2>
            <p class="mt-1 text-sm text-neutral-500">Identifica el país, la ubicación y la categoría institucional.</p>
          </div>
        </div>

        <div class="mt-5 grid min-w-0 grid-cols-1 gap-5 md:grid-cols-2">
          <Select id="id_pais" name="id_pais" label="País" options={paisesPlaceholder} placeholder="Selecciona un país" required />
          <Select id="tipo_organizacion" name="tipo_organizacion" label="Tipo de organización" options={tiposOrganizacion} placeholder="Selecciona un tipo" required />
          <Input id="region_departamento" name="region_departamento" label="Región / Departamento" required maxlength={120} />
          <Input id="comuna_municipio_ciudad" name="comuna_municipio_ciudad" label="Comuna / Municipio / Ciudad" required maxlength={120} />
          <div class="md:col-span-2">
            <Input id="direccion" name="direccion" label="Dirección" required maxlength={250} />
          </div>
          <div id="grupo-tipo-otro" class="hidden md:col-span-2">
            <Input id="tipo_organizacion_otro" name="tipo_organizacion_otro" label={'Especifica el tipo de organización (“Otra”)' } maxlength={100} />
          </div>
        </div>
      </Card>

      <Card class="w-full tarjeta-acento acento-verde p-5 md:p-6">
        <div class="flex items-start gap-3 border-b border-neutral-100 pb-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E7F6EF] text-[#199D6B]" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 19.5h17M5.5 16V8.5m4 7.5V5m4 11v-5m4 5V7"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4.5h3M8 3h3"/>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-bold text-neutral-900">Comunidad y alcance</h2>
            <p class="mt-1 text-sm text-neutral-500">Describe a quién apoya la organización y el alcance de su trabajo.</p>
          </div>
        </div>

        <div class="mt-5 grid min-w-0 grid-cols-1 gap-5 md:grid-cols-2">
          <div class="min-w-0 space-y-1.5">
            <label for="publico_objetivo" class="block text-sm font-medium text-neutral-800">Público objetivo<span class="marca-obligatorio" aria-hidden="true">*</span></label>
            <textarea id="publico_objetivo" name="publico_objetivo" required maxlength="500" rows="4" placeholder="Describe a las personas o comunidades a las que apoya..." class="mt-1.5 block w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 text-base text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </div>
          <div class="min-w-0 space-y-1.5">
            <label for="descripcion_breve" class="block text-sm font-medium text-neutral-800">Descripción general<span class="marca-obligatorio" aria-hidden="true">*</span></label>
            <textarea id="descripcion_breve" name="descripcion_breve" required maxlength="1000" rows="4" placeholder="Resume las actividades y el propósito de la organización..." class="mt-1.5 block w-full resize-y rounded-xl border border-neutral-300 bg-white px-3 py-3 text-base text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </div>
          <div class="md:col-span-2 md:max-w-md">
            <Input id="numero_beneficiarios" name="numero_beneficiarios" label="Número de beneficiarios atendidos" type="number" min="0" required />
          </div>
        </div>
      </Card>

      <Card class="w-full tarjeta-acento acento-rosado p-5 md:p-6">
        <div class="flex items-start gap-3 border-b border-neutral-100 pb-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#FFE9F1] text-[#FF2471]" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path stroke-linecap="round" stroke-linejoin="round" d="m20.5 16-4.5-4.5L7 19.5"/>
            </svg>
          </span>
          <div>
            <h2 class="text-lg font-bold text-neutral-900">Imagen representativa</h2>
            <p class="mt-1 text-sm text-neutral-500">Ayuda a identificar visualmente la organización en el listado y en su ficha.</p>
          </div>
        </div>

        <div class="mt-5 min-w-0">
          <div class="min-w-0 space-y-2">
            <label for="imagen-organizacion" class="block text-sm font-medium text-neutral-800">
              <span id="imagen-organizacion-etiqueta">{esEdicion ? 'Reemplazar imagen' : 'Cargar imagen'}</span>{' '}
              <span class="font-normal text-neutral-500">(opcional)</span>
            </label>
            <input
              id="imagen-organizacion"
              name="imagen"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              aria-describedby="imagen-organizacion-ayuda imagen-organizacion-error"
            />
            <p id="imagen-organizacion-ayuda" class="text-sm leading-5 text-neutral-500">JPG, PNG o WebP, hasta 5 MB. Si no cargas una imagen se usará una predeterminada.</p>
            <img id="imagen-organizacion-vista" alt="Vista previa de la imagen de la organización" hidden class="mt-4 max-h-64 max-w-full rounded-xl border border-neutral-200 object-contain" />
            <p id="imagen-organizacion-estado" role="status" aria-live="polite" class="text-sm text-neutral-600"></p>
            <p id="imagen-organizacion-error" role="alert" hidden class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800"></p>
            <button id="imagen-organizacion-descartar" type="button" hidden class="inline-flex min-h-[44px] items-center rounded-xl px-3 text-sm font-semibold text-primary transition hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">Descartar selección</button>
          </div>
        </div>
      </Card>

      <div class="flex flex-col-reverse gap-3 border-t border-neutral-100 pt-5 sm:flex-row sm:justify-end">
        <Button id="cancelar-organizacion" data-descartar variant="outline" href={esEdicion ? `/organizaciones/${encodeURIComponent(idOrganizacion)}` : '/organizaciones'}>Cancelar</Button>
        <Button id="guardar-organizacion" type="submit">{esEdicion ? 'Guardar cambios' : 'Crear organización'}</Button>
      </div>
    </fieldset>
  </form>
</section>

<script>
  import {
    actualizarOrganizacionSchema,
    crearOrganizacionSchema,
  } from '../../lib/validaciones/organizaciones';
  import {
    actualizarOrganizacion,
    crearOrganizacion,
    descargarImagenOrganizacion,
    listarPaisesOrganizaciones,
    obtenerOrganizacion,
    OrganizacionesApiError,
    subirImagenOrganizacion,
  } from '../../lib/organizaciones/cliente';
  import {
    validarImagenOrganizacion,
  } from '../../lib/organizaciones/imagen';
  import type { Organizacion } from '../../lib/modelos/organizaciones';
  import {
    MENSAJE_SIN_PERMISO_TERRITORIAL,
    obtenerAlcanceGestion,
    puedeGestionarPais,
    type AlcanceGestion,
  } from '../../lib/territorio/permisos';

  const form = document.querySelector<HTMLFormElement>(
    '#form-organizacion',
  );
  const campos = document.querySelector<HTMLFieldSetElement>(
    '#campos-organizacion',
  );
  const estado = document.querySelector<HTMLElement>(
    '#organizacion-estado',
  );
  const error = document.querySelector<HTMLElement>(
    '#organizacion-error',
  );
  const recuperacion = document.querySelector<HTMLElement>(
    '#organizacion-recuperacion',
  );
  const recargar = document.querySelector<HTMLButtonElement>(
    '#recargar-organizacion',
  );
  const selectTipo = document.querySelector<HTMLSelectElement>(
    '#tipo_organizacion',
  );
  const grupoOtro = document.querySelector<HTMLElement>(
    '#grupo-tipo-otro',
  );
  const inputOtro = document.querySelector<HTMLInputElement>(
    '#tipo_organizacion_otro',
  );
  const inputTelefono = document.querySelector<HTMLInputElement>('#telefono');
  const selectPais = document.querySelector<HTMLSelectElement>('#id_pais');
  const guardar = document.querySelector<HTMLButtonElement>(
    '#guardar-organizacion',
  );

  if (
    !form ||
    !campos ||
    !estado ||
    !error ||
    !recuperacion ||
    !recargar ||
    !guardar ||
    !selectPais
  ) {
    throw new Error('No se encontraron los elementos del formulario de organización.');
  }

  // Tras crear la organización, un fallo al subir la imagen deja el formulario
  // en modo edición para reintentar sin duplicar el registro.
  let esEdicion = form.dataset.modo === 'editar';
  const esCreacionInicial = !esEdicion;
  let idOrganizacion = form.dataset.id ?? '';
  let versionActual: number | undefined;
  let guardando = false;
  let alcanceGestion: AlcanceGestion | undefined;

  const inputImagen = document.querySelector<HTMLInputElement>('#imagen-organizacion')!;
  const vistaImagen = document.querySelector<HTMLImageElement>('#imagen-organizacion-vista')!;
  const estadoImagen = document.querySelector<HTMLElement>('#imagen-organizacion-estado')!;
  const errorImagen = document.querySelector<HTMLElement>('#imagen-organizacion-error')!;
  const descartarImagen = document.querySelector<HTMLButtonElement>('#imagen-organizacion-descartar')!;
  let urlImagenActual: string | null = null;
  let urlImagenSeleccionada: string | null = null;

  function mostrarImagen(url: string | null) {
    vistaImagen.hidden = !url;
    if (url) vistaImagen.src = url;
    else vistaImagen.removeAttribute('src');
  }

  function errorDeImagen(mensaje: string) {
    errorImagen.textContent = mensaje;
    errorImagen.hidden = !mensaje;
  }

  function limpiarSeleccionImagen() {
    inputImagen.value = '';
    if (urlImagenSeleccionada) URL.revokeObjectURL(urlImagenSeleccionada);
    urlImagenSeleccionada = null;
    descartarImagen.hidden = true;
    mostrarImagen(urlImagenActual);
  }

  inputImagen.addEventListener('change', () => {
    errorDeImagen('');
    estadoImagen.textContent = '';
    const archivo = inputImagen.files?.[0];
    if (!archivo) {
      limpiarSeleccionImagen();
      return;
    }
    const problema = validarImagenOrganizacion(archivo);
    if (problema) {
      limpiarSeleccionImagen();
      errorDeImagen(problema);
      return;
    }
    if (urlImagenSeleccionada) URL.revokeObjectURL(urlImagenSeleccionada);
    urlImagenSeleccionada = URL.createObjectURL(archivo);
    mostrarImagen(urlImagenSeleccionada);
    descartarImagen.hidden = false;
    estadoImagen.textContent = 'La imagen se cargará al guardar.';
  });

  descartarImagen.addEventListener('click', () => {
    limpiarSeleccionImagen();
    errorDeImagen('');
    estadoImagen.textContent = '';
    inputImagen.focus();
  });

  async function cargarImagenActual(organizacion: Organizacion) {
    if (!organizacion.imagen) {
      estadoImagen.textContent = 'La organización usa la imagen predeterminada.';
      return;
    }
    estadoImagen.textContent = 'Cargando imagen actual…';
    try {
      const blob = await descargarImagenOrganizacion(organizacion.id_organizacion);
      if (urlImagenActual) URL.revokeObjectURL(urlImagenActual);
      urlImagenActual = URL.createObjectURL(blob);
      if (!urlImagenSeleccionada) mostrarImagen(urlImagenActual);
      estadoImagen.textContent = '';
    } catch {
      estadoImagen.textContent = '';
      errorDeImagen('No se pudo cargar la imagen actual. Puedes reemplazarla igualmente.');
    }
  }

  inputTelefono?.addEventListener('input', () => {
    let cantidadDigitos = 0;
    inputTelefono.value = Array.from(inputTelefono.value)
      .filter((caracter) => {
        if (!/\d/.test(caracter)) return true;
        cantidadDigitos += 1;
        return cantidadDigitos <= 15;
      })
      .join('');
  });

  function actualizarVisibilidadOtro() {
    const esOtra = selectTipo?.value === 'otra';
    grupoOtro?.classList.toggle('hidden', !esOtra);

    if (inputOtro) {
      inputOtro.required = Boolean(esOtra);
      if (!esOtra) inputOtro.value = '';
    }
  }

  selectTipo?.addEventListener('change', actualizarVisibilidadOtro);
  actualizarVisibilidadOtro();

  function mostrarError(titulo: string, mensaje: string, requiereSesion = false) {
    estado!.hidden = false;
    estado!.textContent = titulo;
    error!.textContent = mensaje;
    error!.hidden = false;
    recuperacion!.hidden = !requiereSesion;
  }

  // Mismo patrón que Programas y Planes: aviso general arriba y, debajo de
  // cada campo con problemas, su propio mensaje (todos a la vez).
  const MENSAJES_OBLIGATORIOS: Record<string, string> = {
    nombre: 'El nombre es obligatorio.',
    nombre_representante: 'El nombre del representante es obligatorio.',
    telefono: 'El teléfono es obligatorio.',
    correo: 'El correo electrónico es obligatorio.',
    id_pais: 'Selecciona un país.',
    tipo_organizacion: 'Selecciona un tipo de organización.',
    tipo_organizacion_otro: 'Debes especificar el otro tipo de organización.',
    region_departamento: 'La región o departamento es obligatoria.',
    comuna_municipio_ciudad: 'La comuna, municipio o ciudad es obligatoria.',
    direccion: 'La dirección es obligatoria.',
    publico_objetivo: 'El público objetivo es obligatorio.',
    descripcion_breve: 'La descripción general es obligatoria.',
    numero_beneficiarios: 'El número de beneficiarios es obligatorio.',
  };

  type ControlCampo = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  function controlCampo(nombre: string): ControlCampo | null {
    const control = form!.elements.namedItem(nombre);
    return control instanceof HTMLInputElement ||
      control instanceof HTMLTextAreaElement ||
      control instanceof HTMLSelectElement
      ? control
      : null;
  }

  function quitarErrorCampo(control: Element) {
    if (control.getAttribute('aria-invalid') !== 'true') return;
    document.getElementById(`${control.id}-validacion`)?.remove();
    control.setAttribute('aria-invalid', 'false');
    const original = (control as HTMLElement).dataset.describedbyOriginal;
    if (original) control.setAttribute('aria-describedby', original);
    else control.removeAttribute('aria-describedby');
  }

  function limpiarErroresCampos() {
    form!.querySelectorAll('[aria-invalid="true"]').forEach(quitarErrorCampo);
    form!.querySelectorAll('[data-error-campo]').forEach((nodo) => nodo.remove());
  }

  function marcarCampos(errores: Record<string, string>) {
    let primero: ControlCampo | null = null;
    for (const [nombre, mensaje] of Object.entries(errores)) {
      const control = controlCampo(nombre);
      if (!control) continue;
      const parrafo = document.createElement('p');
      parrafo.id = `${control.id}-validacion`;
      parrafo.className = 'mt-1 text-sm text-red-800';
      parrafo.dataset.errorCampo = '';
      parrafo.textContent = mensaje;
      const describedby = control.getAttribute('aria-describedby') ?? '';
      if (!control.dataset.describedbyOriginal && describedby) {
        control.dataset.describedbyOriginal = describedby;
      }
      control.setAttribute('aria-invalid', 'true');
      control.setAttribute(
        'aria-describedby',
        [control.dataset.describedbyOriginal, parrafo.id].filter(Boolean).join(' '),
      );
      control.after(parrafo);
      primero ??= control;
    }
    return primero;
  }

  function erroresDeValidacion(issues: { path: PropertyKey[]; message: string }[]) {
    const errores: Record<string, string> = {};

    // Primero los obligatorios vacíos, con un mensaje claro por campo.
    for (const [nombre, mensaje] of Object.entries(MENSAJES_OBLIGATORIOS)) {
      const control = controlCampo(nombre);
      if (control?.required && !control.value.trim()) errores[nombre] = mensaje;
    }

    // Luego el resto de reglas (formato, largo, etc.), una por campo.
    for (const issue of issues) {
      const nombre = String(issue.path[issue.path[0] === 'cambios' ? 1 : 0] ?? '');
      if (nombre && !errores[nombre]) errores[nombre] = issue.message;
    }
    return errores;
  }

  function mostrarErroresValidacion(errores: Record<string, string>) {
    const primero = marcarCampos(errores);
    estado!.hidden = true;
    error!.textContent = 'Revisa los campos indicados antes de guardar.';
    error!.hidden = false;
    recuperacion!.hidden = true;
    if (primero) primero.focus();
    else error!.focus();
  }

  form.addEventListener('input', (evento) => {
    if (evento.target instanceof Element) quitarErrorCampo(evento.target);
  });
  form.addEventListener('change', (evento) => {
    if (evento.target instanceof Element && evento.target.id !== 'imagen-organizacion') {
      quitarErrorCampo(evento.target);
    }
  });

  function asignarValor(id: string, valor: string | number | null | undefined) {
    const campo = form!.querySelector<
      HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
    >(`#${id}`);

    if (campo) campo.value = valor == null ? '' : String(valor);
  }

  function seleccionarPais(nombre: string, idPais: string) {
    if (!nombre || !idPais) return;

    const normalizar = (valor: string) =>
      valor.trim().toLocaleLowerCase('es');

    const opcion = Array.from(selectPais!.options).find(
      (item) => normalizar(item.textContent ?? '') === normalizar(nombre),
    );

    if (opcion) {
      opcion.value = idPais;
      selectPais!.value = idPais;
      return;
    }

    const nuevaOpcion = new Option(nombre, idPais, true, true);
    selectPais!.add(nuevaOpcion);
    selectPais!.value = idPais;
  }

  async function cargarPaises() {
    const seleccionPrevia = selectPais!.value;
    const [todosLosPaises, alcance] = await Promise.all([
      listarPaisesOrganizaciones(),
      obtenerAlcanceGestion(),
    ]);
    alcanceGestion = alcance;
    const paises = todosLosPaises.filter((pais) => puedeGestionarPais(alcance, pais.id_pais));
    if (paises.length === 0) throw new Error(MENSAJE_SIN_PERMISO_TERRITORIAL);
    selectPais!.replaceChildren(new Option('Selecciona un país', '', true, false));
    for (const pais of paises) {
      selectPais!.add(new Option(pais.nombre, pais.id_pais));
    }
    if (paises.some((pais) => pais.id_pais === seleccionPrevia)) {
      selectPais!.value = seleccionPrevia;
    }
  }

  function precargarOrganizacion(organizacion: Organizacion) {
    const valores: Record<string, string | number | null | undefined> = {
      nombre: organizacion.nombre,
      nombre_representante: organizacion.nombre_representante,
      telefono: organizacion.telefono,
      correo: organizacion.correo,
      tipo_organizacion: organizacion.tipo_organizacion,
      tipo_organizacion_otro: organizacion.tipo_organizacion_otro,
      region_departamento: organizacion.region_departamento,
      comuna_municipio_ciudad: organizacion.comuna_municipio_ciudad,
      direccion: organizacion.direccion,
      publico_objetivo: organizacion.publico_objetivo,
      descripcion_breve: organizacion.descripcion_breve,
      numero_beneficiarios: organizacion.numero_beneficiarios,
    };

    for (const [id, valor] of Object.entries(valores)) {
      asignarValor(id, valor);
    }

    seleccionarPais(
      organizacion.pais?.nombre ?? '',
      organizacion.id_pais,
    );
    versionActual = organizacion.version;
    actualizarVisibilidadOtro();
  }

  function obtenerValor(nombre: string) {
    const campo = form!.elements.namedItem(nombre) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;

    return campo?.value ?? '';
  }

  function obtenerCambiosFormulario() {
    const otro = obtenerValor('tipo_organizacion_otro').trim();

    return {
      id_pais: obtenerValor('id_pais'),
      nombre: obtenerValor('nombre'),
      nombre_representante: obtenerValor('nombre_representante'),
      telefono: obtenerValor('telefono'),
      correo: obtenerValor('correo'),
      region_departamento: obtenerValor('region_departamento'),
      comuna_municipio_ciudad: obtenerValor('comuna_municipio_ciudad'),
      direccion: obtenerValor('direccion'),
      publico_objetivo: obtenerValor('publico_objetivo'),
      descripcion_breve: obtenerValor('descripcion_breve'),
      tipo_organizacion: obtenerValor('tipo_organizacion'),
      tipo_organizacion_otro: otro || null,
      numero_beneficiarios: Number(obtenerValor('numero_beneficiarios')),
    };
  }

  async function cargarOrganizacion() {
    if (!esEdicion) return;

    if (!idOrganizacion) {
      mostrarError(
        'Organización no encontrada',
        'No se proporcionó el identificador de la organización.',
      );
      return;
    }

    estado!.hidden = false;
    estado!.textContent = 'Cargando organización...';
    error!.hidden = true;
    recuperacion!.hidden = true;
    recargar!.disabled = true;
    form!.hidden = true;
    form!.setAttribute('aria-busy', 'true');

    try {
      await cargarPaises();
      const organizacion = await obtenerOrganizacion(idOrganizacion);
      if (!alcanceGestion || !puedeGestionarPais(alcanceGestion, organizacion.id_pais)) {
        throw new Error(MENSAJE_SIN_PERMISO_TERRITORIAL);
      }
      precargarOrganizacion(organizacion);
      void cargarImagenActual(organizacion);
      campos!.disabled = false;
      form!.hidden = false;
      estado!.textContent = '';
      estado!.hidden = true;
    } catch (fallo) {
      const mensaje =
        fallo instanceof Error
          ? fallo.message
          : 'Ocurrió un error inesperado.';

      mostrarError(
        'No fue posible cargar la organización',
        mensaje,
        mensaje.toLocaleLowerCase('es').includes('sesión'),
      );
    } finally {
      recargar!.disabled = false;
      form!.setAttribute('aria-busy', 'false');
    }
  }

  recargar.addEventListener('click', () => {
    void cargarOrganizacion();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (guardando) return;

    error!.hidden = true;
    recuperacion!.hidden = true;
    limpiarErroresCampos();

    const datosFormulario = obtenerCambiosFormulario();
    const validacion = esEdicion
      ? actualizarOrganizacionSchema.safeParse({
          id_organizacion: idOrganizacion,
          version_esperada: versionActual,
          cambios: datosFormulario,
        })
      : crearOrganizacionSchema.safeParse(datosFormulario);

    const erroresCampos = erroresDeValidacion(
      validacion.success ? [] : validacion.error.issues,
    );
    if (Object.keys(erroresCampos).length > 0) {
      mostrarErroresValidacion(erroresCampos);
      return;
    }
    if (!validacion.success) {
      mostrarError(
        'Revisa los datos ingresados',
        validacion.error.issues[0]?.message ??
          'Hay campos que no cumplen el formato solicitado.',
      );
      return;
    }

    guardando = true;
    campos!.disabled = true;
    guardar!.disabled = true;
    guardar!.textContent = 'Guardando...';
    estado!.hidden = false;
    estado!.textContent = esEdicion ? 'Guardando cambios...' : 'Guardando organización...';
    form!.setAttribute('aria-busy', 'true');

    let organizacionGuardada = false;
    try {
      const organizacion = esEdicion
        ? await actualizarOrganizacion(
            idOrganizacion,
            datosFormulario as Parameters<typeof actualizarOrganizacion>[1],
            versionActual,
          )
        : await crearOrganizacion(
            datosFormulario as Parameters<typeof crearOrganizacion>[0],
          );
      organizacionGuardada = true;
      esEdicion = true;
      idOrganizacion = organizacion.id_organizacion;
      versionActual = organizacion.version;

      const archivoImagen = inputImagen.files?.[0];
      if (archivoImagen) {
        estado!.textContent = 'Subiendo imagen...';
        guardar!.textContent = 'Subiendo imagen...';
        estadoImagen.textContent = 'Subiendo imagen…';
        await subirImagenOrganizacion(idOrganizacion, archivoImagen);
        estadoImagen.textContent = 'Imagen cargada correctamente.';
      }

      estado!.textContent = esCreacionInicial
        ? 'Organización creada correctamente.'
        : 'Organización actualizada correctamente.';
      window.location.replace(
        `/organizaciones/${encodeURIComponent(idOrganizacion)}?resultado=${esCreacionInicial ? 'creado' : 'actualizado'}`,
      );
    } catch (fallo) {
      if (organizacionGuardada) {
        const detalle = fallo instanceof Error ? fallo.message : 'Ocurrió un error inesperado.';
        estadoImagen.textContent = '';
        errorDeImagen(`No se pudo cargar la imagen: ${detalle}`);
        mostrarError(
          'La organización se guardó, pero la imagen no se pudo cargar',
          `${detalle} Puedes reintentar guardando de nuevo, seleccionar otra imagen o continuar sin ella desde la ficha de la organización.`,
          detalle.toLocaleLowerCase('es').includes('sesión'),
        );
        form!.dataset.modo = 'editar';
        form!.dataset.id = idOrganizacion;
        document.querySelector('#cancelar-organizacion')
          ?.setAttribute('href', `/organizaciones/${encodeURIComponent(idOrganizacion)}`);
        campos!.disabled = false;
        return;
      }

      const camposServidor = fallo instanceof OrganizacionesApiError ? fallo.fields : undefined;
      if (camposServidor && Object.keys(camposServidor).length > 0) {
        const errores = Object.fromEntries(
          Object.entries(camposServidor)
            .filter(([, mensajes]) => mensajes?.[0])
            .map(([campo, mensajes]) => [campo.replace(/^cambios\./, ''), mensajes[0]]),
        );
        if (marcarCampos(errores)) {
          campos!.disabled = false;
          mostrarErroresValidacion({});
          form!.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }
      }

      const mensaje =
        fallo instanceof Error
          ? fallo.message
          : 'Ocurrió un error inesperado al guardar.';

      mostrarError(
        'No fue posible guardar los cambios',
        mensaje,
        mensaje.toLocaleLowerCase('es').includes('sesión'),
      );
      campos!.disabled = false;
    } finally {
      guardando = false;
      guardar!.disabled = false;
      guardar!.textContent = esEdicion ? 'Guardar cambios' : 'Crear organización';
      form!.setAttribute('aria-busy', 'false');
    }
  });

  if (esEdicion) {
    void cargarOrganizacion();
  } else {
    campos.disabled = true;
    void cargarPaises()
      .then(() => { campos.disabled = false; })
      .catch((fallo) => {
        mostrarError(
          'No fue posible preparar el formulario',
          fallo instanceof Error ? fallo.message : 'No se pudieron cargar los países.',
          true,
        );
      });
  }
</script>
