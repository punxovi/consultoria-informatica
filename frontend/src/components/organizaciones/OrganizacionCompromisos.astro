---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
const { idOrganizacion } = Astro.props;
---
<section id="compromisos" data-organizacion={idOrganizacion} class="space-y-5">
  <div>
    <h2 class="text-xl font-semibold">Compromisos</h2>
    <p class="mt-1 text-neutral-600">Consulta los acuerdos, sus responsables y las fechas de cumplimiento.</p>
  </div>
  <p id="comp-permisos" hidden class="rounded-lg bg-neutral-100 p-4 text-sm">Puedes consultar los compromisos. No tienes permiso para modificarlos en esta organización.</p>
  <p id="comp-carga" hidden role="status">Cargando compromisos…</p>
  <div id="comp-error" hidden role="alert" tabindex="-1" class="rounded-lg border border-danger p-4 text-danger"></div>
  <div id="comp-exito" hidden role="status" class="rounded-lg border border-success p-4 text-success"></div>
  <div class="flex flex-wrap gap-3">
    <Button id="comp-recargar" variant="outline">Recargar datos</Button>
    <Button id="comp-nuevo" disabled>Registrar compromiso</Button>
  </div>
  <div id="comp-listado" hidden class="space-y-4">
    <p id="comp-vacio" hidden class="rounded-xl border border-dashed p-6 text-center">Esta organización aún no tiene compromisos registrados.</p>
    <p id="comp-sin-actas" hidden class="rounded-xl border p-4">Para registrar compromisos, primero crea un acta en la pestaña Actas de Reunión.</p>
    <div id="comp-lista" class="grid gap-4 lg:grid-cols-2"></div>
  </div>
  <div id="comp-detalle" hidden>
    <Card>
      <h3 class="text-lg font-semibold">Detalle del compromiso</h3>
      <dl id="comp-datos" class="my-5 grid gap-4 sm:grid-cols-2"></dl>
      <p class="mb-4">Origen: <a id="comp-origen" class="text-primary underline"></a></p>
      <a id="comp-accion" hidden class="mb-4 block text-primary underline">Ver acción de origen</a>
      <div class="flex flex-wrap gap-3">
        <Button id="comp-volver" variant="outline">Volver a compromisos</Button>
        <Button id="comp-editar">Editar compromiso</Button>
      </div>
    </Card>
  </div>
  <form id="comp-form" hidden novalidate>
    <Card>
      <h3 id="comp-form-titulo" class="text-lg font-semibold">Registrar compromiso</h3>
      <p class="my-3 text-sm text-neutral-600">Los campos con * son obligatorios. Los nuevos compromisos quedan Pendientes.</p>
      <fieldset id="comp-campos" class="grid min-w-0 gap-5 sm:grid-cols-2 [&>*]:min-w-0">
        <div class="sm:col-span-2">
          <label for="comp-acta" class="block text-sm font-medium">Acta de origen *</label>
          <select id="comp-acta" name="id_acta" required class="mt-2 min-h-[48px] w-full rounded-lg border border-neutral-300 px-3"></select>
        </div>
        <div class="sm:col-span-2">
          <label for="comp-descripcion" class="block text-sm font-medium">Acción o acuerdo comprometido *</label>
          <textarea id="comp-descripcion" name="descripcion" required maxlength="2000" rows="3" class="mt-2 w-full rounded-lg border border-neutral-300 p-3"></textarea>
        </div>
        <Input id="comp-responsable" name="responsable_nombre" label="Responsable" required maxlength={150} />
        <Input id="comp-contacto" name="responsable_contacto" label="Contacto del responsable" required maxlength={300} hint="Correo, teléfono u otro medio de contacto." />
        <Input id="comp-fecha" name="fecha_limite" type="date" label="Fecha límite" required />
        <div>
          <label for="comp-estado" class="block text-sm font-medium">Estado *</label>
          <select id="comp-estado" name="estado" required class="mt-2 min-h-[48px] w-full rounded-lg border border-neutral-300 px-3">
            <option value="pendiente">Pendiente</option><option value="cumplido">Cumplido</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="comp-observaciones" class="block text-sm font-medium">Observaciones (opcional)</label>
          <textarea id="comp-observaciones" name="observaciones" maxlength="2000" rows="3" class="mt-2 w-full rounded-lg border border-neutral-300 p-3"></textarea>
        </div>
        <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:justify-end">
          <Button id="comp-cancelar" variant="outline">Cancelar</Button>
          <Button id="comp-guardar" type="submit">Guardar compromiso</Button>
        </div>
      </fieldset>
    </Card>
  </form>
</section>
<script>
  import { iniciarCompromisos } from '../../lib/compromisos/interfaz';
  iniciarCompromisos();
</script>
