---
import AvisoObligatorios from '../ui/AvisoObligatorios.astro';
import Icono from '../ui/Icono.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import EmptyState from '../ui/EmptyState.astro';
import EncabezadoModulo from '../ui/EncabezadoModulo.astro';

const campoTexto = 'mt-1.5 block w-full rounded-xl border border-[#D8D2E8] bg-white px-3 py-2.5 text-sm text-neutral-900 outline-none transition placeholder:text-neutral-400 focus:border-[#4C4688] focus:ring-2 focus:ring-[#4C4688]/15';

const camposInstitucionales = [
  { id: 'mision', label: 'Misión de la organización', placeholder: 'Describe la misión de la organización...' },
  { id: 'vision', label: 'Visión de la organización', placeholder: 'Describe la visión de la organización...' },
];
const camposInfraestructura = [
  { id: 'caracteristicas-infraestructura', label: 'Características de infraestructura', placeholder: 'Describe las características de la infraestructura...' },
  { id: 'espacios-disponibles', label: 'Espacios disponibles', placeholder: 'Describe los espacios disponibles...' },
];
const camposNecesidades = [
  { id: 'recursos-existentes', label: 'Recursos existentes', placeholder: 'Describe los recursos existentes...' },
  { id: 'danos-detectados', label: 'Daños detectados', placeholder: 'Describe los daños detectados...' },
  { id: 'necesidades-prioritarias', label: 'Necesidades prioritarias', placeholder: 'Describe las necesidades prioritarias...' },
];
const resumen: { titulo: string; tono: 'morado' | 'celeste' | 'verde'; campos: { id: string; label: string; ancho?: boolean }[] }[] = [
  { titulo: 'Información institucional', tono: 'morado', campos: [
    { id: 'resumen-mision', label: 'Misión' }, { id: 'resumen-vision', label: 'Visión' },
  ]},
  { titulo: 'Infraestructura y espacios', tono: 'celeste', campos: [
    { id: 'resumen-espacio-fisico', label: 'Espacio físico' },
    { id: 'resumen-caracteristicas-infraestructura', label: 'Características de infraestructura' },
    { id: 'resumen-espacios-disponibles', label: 'Espacios disponibles', ancho: true },
  ]},
  { titulo: 'Recursos, daños y necesidades', tono: 'verde', campos: [
    { id: 'resumen-recursos-existentes', label: 'Recursos existentes' },
    { id: 'resumen-danos-detectados', label: 'Daños detectados' },
    { id: 'resumen-necesidades-prioritarias', label: 'Necesidades prioritarias' },
  ]},
  { titulo: 'Observaciones generales', tono: 'morado', campos: [
    { id: 'resumen-observaciones', label: 'Observaciones generales', ancho: true },
  ]},
  { titulo: 'Información de raciones', tono: 'celeste', campos: [
    { id: 'resumen-raciones', label: 'Raciones entregadas' },
    { id: 'resumen-periodo-raciones', label: 'Periodicidad' },
  ]},
];
---

<section id="diagnostico-organizacion" class="space-y-6" aria-labelledby="diagnostico-titulo">
  <EncabezadoModulo id="diagnostico-titulo" titulo="Diagnóstico" descripcion="Situación, infraestructura, recursos y necesidades de la organización.">
    <Button id="btn-registrar-diagnostico" type="button" variant="primary" disabled>
      <Icono nombre="editar" />
      <span id="btn-registrar-diagnostico-texto">Registrar diagnóstico</span>
    </Button>
  </EncabezadoModulo>

  <p id="diagnostico-carga" hidden role="status" aria-live="polite" class="rounded-xl border border-[#E3DFF0] bg-white p-4 text-sm text-neutral-600">Cargando diagnóstico…</p>
  <p id="diagnostico-error" hidden role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></p>
  <div id="diagnostico-recuperacion" hidden><Button id="btn-recargar-diagnostico" variant="outline">Reintentar</Button></div>
  <p id="diagnostico-confirmacion" hidden role="status" aria-live="polite" class="rounded-xl border border-[#B8E3D1] bg-[#EDF8F2] p-4 text-sm text-[#16784F]"></p>

  <EmptyState
    id="estado-sin-diagnostico"
    hidden
    title="Todavía no hay un diagnóstico"
    description="Esta organización aún no tiene un diagnóstico registrado. Cuando lo registres, aquí podrás consultar su información institucional, infraestructura y necesidades."
  />

  <form id="form-diagnostico" hidden novalidate class="space-y-5" aria-labelledby="form-diagnostico-titulo">
    <fieldset id="diagnostico-campos" class="min-w-0 space-y-5">
      <section class="ficha-panel tarjeta-acento acento-morado">
        <h3 id="form-diagnostico-titulo" class="text-lg font-semibold text-neutral-900">Información institucional</h3>
        <p class="mt-1 text-sm text-neutral-500">Completa la misión y visión de la organización.</p>
        <AvisoObligatorios class="mt-2" />
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {camposInstitucionales.map((campo) => (
            <div>
              <label for={campo.id} class="block text-sm font-medium text-neutral-700">{campo.label}<span class="marca-obligatorio" aria-hidden="true">*</span></label>
              <textarea id={campo.id} name={campo.id} rows="4" maxlength="500" required placeholder={campo.placeholder} class={campoTexto}></textarea>
              <p id={`${campo.id}-error`} class="mt-1 text-xs text-red-600" aria-live="polite"></p>
              <p class="mt-1 text-right text-xs text-neutral-400">Máximo 500 caracteres</p>
            </div>
          ))}
        </div>
      </section>

      <section class="ficha-panel tarjeta-acento acento-celeste">
        <h3 class="text-lg font-semibold text-neutral-900">Infraestructura y espacios</h3>
        <p class="mt-1 text-sm text-neutral-500">Información sobre las condiciones físicas y los espacios disponibles.</p>
        <div class="mt-5 space-y-5">
          <div class="rounded-xl bg-[#F0EDF8]/60 p-4">
            <span class="block text-sm font-medium text-neutral-700">¿Existe un espacio físico?</span>
            <p class="mt-1 text-xs text-neutral-500">Este campo es opcional.</p>
            <div class="mt-3 flex flex-wrap gap-5">
              {['si', 'no'].map((valor) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-[#E3DFF0] bg-white px-4 py-2.5 text-sm text-neutral-700">
                  <input type="radio" name="tiene-espacio-fisico" value={valor} class="h-4 w-4 accent-[#4C4688]" />
                  {valor === 'si' ? 'Sí' : 'No'}
                </label>
              ))}
            </div>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            {camposInfraestructura.map((campo) => (
              <div>
                <label for={campo.id} class="block text-sm font-medium text-neutral-700">{campo.label}<span class="marca-obligatorio" aria-hidden="true">*</span></label>
                <textarea id={campo.id} name={campo.id} rows="4" maxlength="500" required placeholder={campo.placeholder} class={campoTexto}></textarea>
                <p id={`${campo.id}-error`} class="mt-1 text-xs text-red-600" aria-live="polite"></p>
                <p class="mt-1 text-right text-xs text-neutral-400">Máximo 500 caracteres</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="ficha-panel tarjeta-acento acento-verde">
        <h3 class="text-lg font-semibold text-neutral-900">Recursos, daños y necesidades</h3>
        <p class="mt-1 text-sm text-neutral-500">Describe los recursos disponibles, los daños identificados y las principales necesidades.</p>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {camposNecesidades.map((campo) => (
            <div>
              <label for={campo.id} class="block text-sm font-medium text-neutral-700">{campo.label}<span class="marca-obligatorio" aria-hidden="true">*</span></label>
              <textarea id={campo.id} name={campo.id} rows="4" maxlength="500" required placeholder={campo.placeholder} class={campoTexto}></textarea>
              <p id={`${campo.id}-error`} class="mt-1 text-xs text-red-600" aria-live="polite"></p>
              <p class="mt-1 text-right text-xs text-neutral-400">Máximo 500 caracteres</p>
            </div>
          ))}
        </div>
      </section>

      <section class="ficha-panel tarjeta-acento acento-morado">
        <h3 class="text-lg font-semibold text-neutral-900">Observaciones generales</h3>
        <p class="mt-1 text-sm text-neutral-500">Agrega cualquier información adicional relevante para el diagnóstico.</p>
        <div class="mt-5">
          <label for="observaciones" class="block text-sm font-medium text-neutral-700">Observaciones generales<span class="marca-obligatorio" aria-hidden="true">*</span></label>
          <textarea id="observaciones" name="observaciones" rows="4" maxlength="1000" required placeholder="Ingresa observaciones generales..." class={campoTexto}></textarea>
          <p id="observaciones-error" class="mt-1 text-xs text-red-600" aria-live="polite"></p>
          <p class="mt-1 text-right text-xs text-neutral-400">Máximo 1000 caracteres</p>
        </div>
      </section>

      <section class="ficha-panel tarjeta-acento acento-celeste">
        <h3 class="text-lg font-semibold text-neutral-900">Información de raciones</h3>
        <p class="mt-1 text-sm text-neutral-500">Completa esta información cuando corresponda a un comedor solidario o merendero.</p>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div>
            <Input id="raciones" name="raciones" label="Número de raciones entregadas" type="number" min="0" max="2147483647" step="1" placeholder="Ej: 150" />
            <p id="raciones-error" class="mt-1 text-xs text-red-600" aria-live="polite"></p>
          </div>
          <div>
            <Select id="periodo-raciones" name="periodo-raciones" label="Periodicidad" options={[{value:'',label:'Sin información'},{value:'diaria',label:'Diaria'},{value:'semanal',label:'Semanal'},{value:'mensual',label:'Mensual'}]} value="" />
            <p id="periodo-raciones-error" class="mt-1 text-xs text-red-600" aria-live="polite"></p>
          </div>
        </div>
      </section>

      <div class="flex flex-col-reverse gap-3 border-t border-[#E3DFF0] pt-5 sm:flex-row sm:justify-end">
        <Button id="btn-cancelar-diagnostico" data-descartar type="button" variant="outline">Cancelar</Button>
        <Button id="btn-guardar-diagnostico" type="submit" variant="primary">Guardar diagnóstico</Button>
      </div>
    </fieldset>
  </form>

  <div id="diagnostico-registrado" hidden class="space-y-5">
    <p class="modulo-conteo">Última actualización: <span id="fecha-actualizacion-diagnostico">Pendiente</span></p>

    <div class="grid gap-4 xl:grid-cols-2">
      {resumen.map((seccion) => (
        <section class={`ficha-panel tarjeta-acento acento-${seccion.tono} ${seccion.titulo === 'Recursos, daños y necesidades' ? 'xl:col-span-2' : ''}`}>
          <h3 class="ficha-panel-titulo">{seccion.titulo}</h3>
          <dl class="ficha-datos">
            {seccion.campos.map((campo) => (
              <div class={campo.ancho ? 'ficha-dato-ancho' : ''}>
                <dt>{campo.label}</dt>
                <dd id={campo.id}>—</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</section>


<script>
  import { iniciarDiagnostico } from '../../lib/diagnostico-organizacion/interfaz';
  void iniciarDiagnostico();
</script>
