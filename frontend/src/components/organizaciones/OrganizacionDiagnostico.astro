---
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
---

<section
  id="diagnostico-organizacion"
  class="space-y-6"
  aria-labelledby="diagnostico-titulo"
>
  <!-- Encabezado -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2
        id="diagnostico-titulo"
        class="text-lg font-semibold text-neutral-900"
      >
        Diagnóstico de la organización
      </h2>

      <p class="mt-1 text-sm text-neutral-500">
        Información utilizada para conocer la situación actual, necesidades y
        condiciones de la organización.
      </p>
    </div>

    <Button
      id="btn-registrar-diagnostico"
      type="button"
      variant="primary"
      disabled
    >
      Registrar diagnóstico
    </Button>
  </div>

  <!-- Estados -->
  <p
    id="diagnostico-carga"
    hidden
    role="status"
    aria-live="polite"
    class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-600"
  >
    Cargando diagnóstico…
  </p>

  <p
    id="diagnostico-error"
    hidden
    role="alert"
    class="rounded-lg border border-danger bg-red-50 p-4 text-sm text-red-800"
  ></p>

  <div id="diagnostico-recuperacion" hidden>
    <Button id="btn-recargar-diagnostico" variant="outline">Recargar diagnóstico</Button>
  </div>

  <p
    id="diagnostico-confirmacion"
    hidden
    role="status"
    class="rounded-lg border border-primary bg-primary/5 p-4 text-sm text-primary"
  ></p>

  <!-- Sin diagnóstico -->
  <div id="estado-sin-diagnostico" hidden>
    <Card>
      <div class="space-y-4 py-4 text-center">
        <div
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
          aria-hidden="true"
        >
          <span class="text-xl">+</span>
        </div>

        <h3 class="text-base font-semibold text-neutral-900">
          No hay un diagnóstico registrado
        </h3>

        <p class="mx-auto max-w-xl text-sm leading-6 text-neutral-500">
          Esta organización todavía no cuenta con un diagnóstico. Registra la
          información para comenzar a gestionar sus necesidades y condiciones
          actuales.
        </p>
      </div>
    </Card>
  </div>

  <!-- Formulario -->
  <form
    id="form-diagnostico"
    hidden
    novalidate
    class="space-y-6"
    aria-labelledby="form-diagnostico-titulo"
  >
    <fieldset id="diagnostico-campos" class="min-w-0 space-y-6">
    <Card>
      <h3
        id="form-diagnostico-titulo"
        class="text-lg font-semibold text-neutral-900"
      >
        Información institucional
      </h3>

      <p class="mt-2 text-sm text-neutral-500">
        Completa la misión y visión de la organización. Los campos marcados
        con * son obligatorios.
      </p>

      <div class="mt-6 space-y-5">
        <div>
          <label
            for="mision"
            class="block text-sm font-medium text-neutral-700"
          >
            Misión de la organización
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="mision"
            name="mision"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe la misión de la organización..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="mision-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>

          <p class="mt-1 text-right text-xs text-neutral-400">
            Máximo 500 caracteres
          </p>
        </div>

        <div>
          <label
            for="vision"
            class="block text-sm font-medium text-neutral-700"
          >
            Visión de la organización
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="vision"
            name="vision"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe la visión de la organización..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="vision-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>

          <p class="mt-1 text-right text-xs text-neutral-400">
            Máximo 500 caracteres
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-neutral-900">
        Infraestructura y espacios
      </h3>

      <p class="mt-2 text-sm text-neutral-500">
        Información sobre las condiciones físicas y espacios disponibles.
      </p>

      <div class="mt-6 space-y-5">
        <div>
          <span class="block text-sm font-medium text-neutral-700">
            ¿Existe un espacio físico?
          </span>

          <p class="mt-1 text-xs text-neutral-500">
            Este campo es opcional.
          </p>

          <div class="mt-3 flex flex-wrap gap-6">
            <label class="inline-flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tiene-espacio-fisico"
                value="si"
                class="h-4 w-4 border-neutral-300 text-primary focus:ring-primary"
              />
              <span class="text-sm text-neutral-700">Sí</span>
            </label>

            <label class="inline-flex cursor-pointer items-center gap-2">
              <input
                type="radio"
                name="tiene-espacio-fisico"
                value="no"
                class="h-4 w-4 border-neutral-300 text-primary focus:ring-primary"
              />
              <span class="text-sm text-neutral-700">No</span>
            </label>
          </div>
        </div>

        <div>
          <label
            for="caracteristicas-infraestructura"
            class="block text-sm font-medium text-neutral-700"
          >
            Características de infraestructura
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="caracteristicas-infraestructura"
            name="caracteristicas-infraestructura"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe las características de la infraestructura..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="caracteristicas-infraestructura-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>

          <p class="mt-1 text-right text-xs text-neutral-400">
            Máximo 500 caracteres
          </p>
        </div>

        <div>
          <label
            for="espacios-disponibles"
            class="block text-sm font-medium text-neutral-700"
          >
            Espacios disponibles
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="espacios-disponibles"
            name="espacios-disponibles"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe los espacios disponibles..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="espacios-disponibles-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>

          <p class="mt-1 text-right text-xs text-neutral-400">
            Máximo 500 caracteres
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-neutral-900">
        Recursos, daños y necesidades
      </h3>

      <p class="mt-2 text-sm text-neutral-500">
        Describe los recursos disponibles, daños identificados y principales
        necesidades de la organización.
      </p>

      <div class="mt-6 space-y-5">
        <div>
          <label
            for="recursos-existentes"
            class="block text-sm font-medium text-neutral-700"
          >
            Recursos existentes
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="recursos-existentes"
            name="recursos-existentes"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe los recursos existentes..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="recursos-existentes-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>
        </div>

        <div>
          <label
            for="danos-detectados"
            class="block text-sm font-medium text-neutral-700"
          >
            Daños detectados
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="danos-detectados"
            name="danos-detectados"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe los daños detectados..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="danos-detectados-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>
        </div>

        <div>
          <label
            for="necesidades-prioritarias"
            class="block text-sm font-medium text-neutral-700"
          >
            Necesidades prioritarias
            <span class="text-danger" aria-hidden="true">*</span>
          </label>

          <textarea
            id="necesidades-prioritarias"
            name="necesidades-prioritarias"
            rows="4"
            maxlength="500"
            required
            placeholder="Describe las necesidades prioritarias..."
            class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
          ></textarea>

          <p
            id="necesidades-prioritarias-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-neutral-900">
        Observaciones generales
      </h3>

      <p class="mt-2 text-sm text-neutral-500">
        Agrega cualquier información adicional relevante para el diagnóstico.
      </p>

      <div class="mt-6">
        <label
          for="observaciones"
          class="block text-sm font-medium text-neutral-700"
        >
          Observaciones generales
          <span class="text-danger" aria-hidden="true">*</span>
        </label>

        <textarea
          id="observaciones"
          name="observaciones"
          rows="5"
          maxlength="1000"
          required
          placeholder="Ingresa observaciones generales..."
          class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/20"
        ></textarea>

        <p
          id="observaciones-error"
          class="mt-1 text-xs text-danger"
          aria-live="polite"
        ></p>

        <p class="mt-1 text-right text-xs text-neutral-400">
          Máximo 1000 caracteres
        </p>
      </div>
    </Card>

    <Card>
      <h3 class="text-lg font-semibold text-neutral-900">
        Información de raciones
      </h3>

      <p class="mt-2 text-sm text-neutral-500">
        Completa esta información cuando corresponda a un comedor solidario o
        merendero.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
        <div>
          <Input
            id="raciones"
            name="raciones"
            label="Número de raciones entregadas"
            type="number"
            min="0"
            max="2147483647"
            step="1"
            placeholder="Ej: 150"
          />

          <p
            id="raciones-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>
        </div>

        <div>
          <Select
            id="periodo-raciones"
            name="periodo-raciones"
            label="Periodicidad"
            options={[
              { value: '', label: 'Sin información' },
              { value: 'diaria', label: 'Diaria' },
              { value: 'semanal', label: 'Semanal' },
              { value: 'mensual', label: 'Mensual' },
            ]}
            value=""
          />

          <p
            id="periodo-raciones-error"
            class="mt-1 text-xs text-danger"
            aria-live="polite"
          ></p>
        </div>
      </div>
    </Card>

    <div class="flex flex-col-reverse gap-3 border-t border-neutral-200 pt-6 sm:flex-row sm:justify-end">
      <Button
        id="btn-cancelar-diagnostico"
        type="button"
        variant="outline"
      >
        Cancelar
      </Button>

      <Button
        id="btn-guardar-diagnostico"
        type="submit"
        variant="primary"
      >
        Guardar diagnóstico
      </Button>
    </div>
    </fieldset>
  </form>

  <!-- Diagnóstico registrado -->
  <div
    id="diagnostico-registrado"
    hidden
    class="space-y-6"
  >
    <div
      class="flex flex-col gap-3 rounded-xl border border-success/20 bg-success/5 p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="text-sm font-semibold text-neutral-900">
          Diagnóstico registrado
        </p>

        <p class="mt-1 text-sm text-neutral-500">
          Última actualización:
          <span id="fecha-actualizacion-diagnostico">
            Pendiente
          </span>
        </p>
      </div>
    </div>

    <Card>
      <h3 class="mb-6 text-base font-semibold text-neutral-900">
        Información institucional
      </h3>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Misión
          </p>

          <p
            id="resumen-mision"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Visión
          </p>

          <p
            id="resumen-vision"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="mb-6 text-base font-semibold text-neutral-900">
        Infraestructura y espacios
      </h3>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Espacio físico
          </p>

          <p
            id="resumen-espacio-fisico"
            class="mt-2 text-sm text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Características de infraestructura
          </p>

          <p
            id="resumen-caracteristicas-infraestructura"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>

        <div class="md:col-span-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Espacios disponibles
          </p>

          <p
            id="resumen-espacios-disponibles"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="mb-6 text-base font-semibold text-neutral-900">
        Recursos, daños y necesidades
      </h3>

      <div class="space-y-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Recursos existentes
          </p>

          <p
            id="resumen-recursos-existentes"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Daños detectados
          </p>

          <p
            id="resumen-danos-detectados"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Necesidades prioritarias
          </p>

          <p
            id="resumen-necesidades-prioritarias"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Observaciones generales
          </p>

          <p
            id="resumen-observaciones"
            class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700"
          >
            —
          </p>
        </div>
      </div>
    </Card>

    <Card>
      <h3 class="mb-6 text-base font-semibold text-neutral-900">
        Información de raciones
      </h3>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Raciones entregadas
          </p>

          <p
            id="resumen-raciones"
            class="mt-2 text-sm text-neutral-700"
          >
            —
          </p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
            Periodicidad
          </p>

          <p
            id="resumen-periodo-raciones"
            class="mt-2 text-sm text-neutral-700"
          >
            —
          </p>
        </div>
      </div>
    </Card>
  </div>
</section>

<script>
  import { iniciarDiagnostico } from '../../lib/diagnostico-organizacion/interfaz';

  void iniciarDiagnostico();
</script>
