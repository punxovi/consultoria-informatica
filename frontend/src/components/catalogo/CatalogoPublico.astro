---
import Layout from '../../layouts/Layout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---
<Layout title="Catálogo público · Fundación Gestionar Esperanzas">
  <div class="min-h-screen bg-[#F7F6FA] text-neutral-900">
    <header class="border-b border-[#DCD8EA] bg-white">
      <nav aria-label="Navegación pública" class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4">
        <a href="/" class="text-lg font-bold text-primary">Fundación Gestionar Esperanzas</a>
        <div class="flex flex-wrap items-center gap-4"><a href="/catalogo" aria-current="page" class="inline-flex min-h-12 items-center font-semibold text-primary">Catálogo</a><a href="/login?returnTo=%2Fdashboard" class="inline-flex min-h-12 items-center font-semibold text-primary">Iniciar sesión</a><Button href="/cotizar" size="lg">Solicitar cotización</Button></div>
      </nav>
    </header>
    <main id="catalogo-publico" class="mx-auto max-w-7xl space-y-6 px-5 py-8 md:py-12">
      <header class="rounded-3xl border border-[#DCD8EA] bg-[#EDEAF7] p-6 md:p-9">
        <h1 class="max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">Productos con propósito</h1>
        <p class="mt-4 max-w-2xl text-lg text-neutral-700">Explora productos y servicios de nuestras organizaciones. Conoce sus características y encuentra opciones para tu próxima cotización.</p>
        <p class="mt-4 text-sm font-medium text-primary">Catálogo público · Sin necesidad de crear una cuenta</p>
      </header>
      <Card class="border-l-4 border-l-primary p-5 md:p-6">
        <h2 class="text-xl font-semibold">Encuentra lo que buscas</h2>
        <p class="mt-1 text-sm text-neutral-600">Explora por país, organización o combina ambos filtros.</p>
        <form id="catalogo-filtros" class="mt-5 grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]">
          <div class="min-w-0"><label for="catalogo-pais" class="mb-2 block font-medium">País</label><select id="catalogo-pais" disabled class="min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-white px-3 focus:ring-2 focus:ring-primary"><option value="">Todos los países</option></select></div>
          <div class="min-w-0"><label for="catalogo-organizacion" class="mb-2 block font-medium">Organización</label><select id="catalogo-organizacion" disabled class="min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-white px-3 focus:ring-2 focus:ring-primary"><option value="">Todas las organizaciones</option></select></div>
          <Button id="catalogo-limpiar" variant="outline" size="lg" disabled>Restablecer filtros</Button>
        </form>
        <p id="catalogo-criterios" class="mt-4 break-words text-sm text-primary"></p>
      </Card>
      <section aria-labelledby="catalogo-titulo">
        <p id="catalogo-seleccion" role="status" class="mb-4 text-primary"></p>
        <h2 id="catalogo-titulo" class="text-2xl font-bold">Catálogo de productos y servicios</h2>
        <p id="catalogo-estado" role="status" class="my-4 text-neutral-600">Cargando catálogo…</p>
        <div id="catalogo-error" hidden role="alert" class="my-4 rounded-xl border border-danger/20 bg-white p-5"><p id="catalogo-error-texto">No fue posible cargar el catálogo. Inténtalo nuevamente.</p><Button id="catalogo-reintentar" variant="outline" size="lg" class="mt-3">Reintentar</Button></div>
        <div id="catalogo-lista" aria-busy="true" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
      </section>
      <dialog id="catalogo-detalle" aria-labelledby="catalogo-detalle-titulo" class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-2xl border border-[#DCD8EA] p-5 backdrop:bg-black/40 md:p-7">
        <div class="flex items-start justify-between gap-3"><h2 id="catalogo-detalle-titulo" class="break-words text-2xl font-bold"></h2><Button id="catalogo-cerrar" variant="outline" size="lg">Cerrar</Button></div>
        <div id="catalogo-detalle-contenido" class="mt-5 space-y-4"></div>
        <p class="mt-5 text-sm text-neutral-600">Las condiciones de la cotización se acuerdan con la organización.</p>
        <Button href="/cotizar" size="lg" class="mt-4">Solicitar cotización</Button>
      </dialog>
    </main>
    <footer class="border-t border-[#DCD8EA] bg-white px-5 py-6 text-center text-sm text-neutral-600">Fundación Gestionar Esperanzas · Conectamos organizaciones y oportunidades.</footer>
  </div>
</Layout>
<script>
  import { iniciarCatalogo } from '../../lib/catalogo/interfaz';
  void iniciarCatalogo();
</script>
