<div
  id="selector-territorio"
  class="mx-1 my-3 rounded-2xl border border-white/15 bg-white/5 p-2.5"
  hidden
>
  <p id="selector-territorio-titulo" class="px-1 text-[11px] font-semibold uppercase tracking-wider text-[#D2CFF0]">
    Territorio de trabajo
  </p>

  <!-- Tarjetas en vez de una lista desplegable: el nombre completo del país siempre se lee. -->
  <div
    id="selector-territorio-opciones"
    role="radiogroup"
    aria-labelledby="selector-territorio-titulo"
    class="mt-2 space-y-1.5"
  >
    <p class="px-1 text-sm text-[#E5E2F8]">Cargando territorio…</p>
  </div>

  <p
    id="selector-territorio-ayuda"
    class="mt-2 px-1 text-xs leading-5 text-[#D2CFF0]"
    role="status"
    aria-live="polite"
  >
    Consultando los territorios disponibles para tu sesión.
  </p>
  <button id="selector-territorio-reintentar" type="button" class="mt-2 rounded-lg px-2 py-1 text-xs font-semibold text-white underline" hidden>
    Reintentar
  </button>
</div>

<script>
  import { getUserRoles } from '../../lib/supabase';
  import {
    listarMisCoberturasVigentes,
    listarPaisesOrganizaciones,
  } from '../../lib/organizaciones/cliente';
  import { invalidarAlcanceGestion } from '../../lib/territorio/permisos';

  type Territorio = {
    id_pais: string;
    nombre: string;
    codigo_iso?: string;
    tipo: 'principal' | 'cobertura';
    inicio_at?: string;
    fin_at?: string;
  };

  const contenedor = document.querySelector<HTMLElement>('#selector-territorio');
  const opciones = document.querySelector<HTMLElement>('#selector-territorio-opciones');
  const ayuda = document.querySelector<HTMLElement>('#selector-territorio-ayuda');
  const reintentar = document.querySelector<HTMLButtonElement>('#selector-territorio-reintentar');

  const CLAVE_TERRITORIO = 'fge.territorio.activo';

  let principal: Territorio | undefined;
  let coberturasRecibidas: Territorio[] = [];
  let firmaCoberturas: string | undefined;

  /**
   * El backend ya devuelve únicamente coberturas vigentes y no revocadas.
   * El frontend usa esa respuesta para poblar la interfaz, pero no concede
   * permisos ni sustituye las validaciones de autorización del servidor.
   */
  function obtenerTerritorios(): Territorio[] {
    if (!principal) return [];

    const adicionales = new Map<string, Territorio>();
    for (const territorio of coberturasRecibidas) {
      if (
        territorio.tipo === 'cobertura' &&
        territorio.id_pais &&
        territorio.nombre &&
        territorio.id_pais !== principal.id_pais
      ) {
        adicionales.set(territorio.id_pais, territorio);
      }
    }

    return [principal, ...adicionales.values()];
  }

  let ultimoNotificado: string | undefined;
  function notificarTerritorioActivo(idPais: string) {
    const cambio = ultimoNotificado !== undefined && ultimoNotificado !== idPais;
    ultimoNotificado = idPais;
    window.dispatchEvent(
      new CustomEvent('fge:territorio-cambiado', {
        detail: { id_pais: idPais },
      }),
    );
    // Las vistas con sus propios observadores descartan solicitudes anteriores.
    // En las demás, una navegación limpia evita conservar datos del país anterior.
    if (cambio && !['/organizaciones', '/planes', '/cotizaciones'].includes(location.pathname.replace(/\/$/, ''))) {
      const destino = location.pathname.startsWith('/organizaciones/') ? '/organizaciones'
        : location.pathname.startsWith('/planes/') ? '/planes' : location.pathname;
      location.assign(destino);
    }
  }

  function descripcion(territorio: Territorio) {
    if (territorio.tipo === 'principal') return 'País principal';
    if (!territorio.fin_at) return 'Cobertura temporal';
    const fin = new Date(territorio.fin_at);
    if (Number.isNaN(fin.getTime())) return 'Cobertura temporal';
    const [anio, mes, dia] = fin.toISOString().slice(0, 10).split('-');
    return `Cobertura hasta ${dia}/${mes}/${anio}`;
  }

  // Misma bandera circular que el perfil del encabezado; si no carga, se muestran las iniciales.
  function bandera(territorio: Territorio, activo: boolean) {
    const codigo = territorio.codigo_iso?.trim().toLowerCase() ?? '';
    const marco = document.createElement('span');
    marco.className = `flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full text-[11px] font-bold ring-2 ${
      activo ? 'bg-[#F0EDF8] text-[#4C4688] ring-[#4C4688]/15' : 'bg-white/15 text-white ring-white/20'}`;
    marco.setAttribute('aria-hidden', 'true');
    marco.textContent = (codigo || territorio.nombre.slice(0, 2)).toUpperCase();
    if (/^[a-z]{2}$/.test(codigo)) {
      const imagen = document.createElement('img');
      imagen.src = `https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/flags/1x1/${codigo}.svg`;
      imagen.alt = '';
      imagen.className = 'h-full w-full object-cover';
      imagen.addEventListener('load', () => { marco.textContent = ''; marco.append(imagen); }, { once: true });
    }
    return marco;
  }

  function tarjeta(territorio: Territorio, activo: boolean, seleccionable: boolean) {
    const boton = document.createElement('button');
    boton.type = 'button';
    boton.setAttribute('role', 'radio');
    boton.setAttribute('aria-checked', String(activo));
    boton.dataset.pais = territorio.id_pais;
    boton.disabled = !seleccionable;
    boton.tabIndex = activo ? 0 : -1;
    boton.className = `flex w-full min-w-0 items-center gap-2.5 rounded-xl px-2.5 py-2 text-left transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white ${
      activo
        ? 'bg-white text-[#2B2654] shadow-sm'
        : 'text-white hover:bg-white/10'
    } ${seleccionable ? 'cursor-pointer' : 'cursor-default'}`;

    const textos = document.createElement('span');
    textos.className = 'min-w-0 flex-1';
    const nombre = document.createElement('span');
    nombre.className = 'block text-sm font-semibold leading-5 [overflow-wrap:anywhere]';
    nombre.textContent = territorio.nombre;
    const detalle = document.createElement('span');
    detalle.className = `block text-xs leading-4 ${activo ? 'text-[#6B6591]' : 'text-[#D2CFF0]'}`;
    detalle.textContent = descripcion(territorio);
    textos.append(nombre, detalle);

    boton.append(bandera(territorio, activo), textos);
    if (activo) {
      const marca = document.createElement('span');
      marca.className = 'flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#4C4688] text-[11px] font-bold text-white';
      marca.setAttribute('aria-hidden', 'true');
      marca.textContent = '✓';
      boton.append(marca);
    }
    boton.setAttribute('aria-label', `${territorio.nombre}, ${descripcion(territorio)}`);
    return boton;
  }

  function seleccionar(idPais: string) {
    // La comprobación de la interfaz evita selecciones accidentales; el
    // backend sigue siendo la autoridad efectiva de los permisos.
    const autorizado = obtenerTerritorios().some((territorio) => territorio.id_pais === idPais);
    if (!autorizado || sessionStorage.getItem(CLAVE_TERRITORIO) === idPais) return;
    sessionStorage.setItem(CLAVE_TERRITORIO, idPais);
    renderizarSelector();
    opciones?.querySelector<HTMLButtonElement>(`[data-pais="${CSS.escape(idPais)}"]`)?.focus();
    notificarTerritorioActivo(idPais);
  }

  function renderizarSelector(notificarInicializacion = false) {
    if (!contenedor || !opciones || !ayuda || !principal) return;

    const territorios = obtenerTerritorios();
    const almacenado = sessionStorage.getItem(CLAVE_TERRITORIO);
    const territorioAlmacenadoSigueAutorizado = territorios.some(
      (territorio) => territorio.id_pais === almacenado,
    );
    const activo = territorioAlmacenadoSigueAutorizado && almacenado
      ? almacenado
      : principal.id_pais;
    const seleccionable = territorios.length > 1;

    opciones.replaceChildren(
      ...territorios.map((territorio) => tarjeta(territorio, territorio.id_pais === activo, seleccionable)),
    );
    contenedor.hidden = false;
    if (reintentar) reintentar.hidden = true;
    sessionStorage.setItem(CLAVE_TERRITORIO, activo);

    ayuda.textContent = seleccionable
      ? 'Elige el país en el que vas a trabajar.'
      : 'Sin coberturas temporales vigentes.';

    // Se notifica al inicializar para que las vistas operativas puedan leer
    // el territorio activo; también se notifica si una selección anterior ya
    // no está autorizada y debió volver al país principal.
    if (notificarInicializacion || activo !== almacenado) {
      notificarTerritorioActivo(activo);
    }
  }

  opciones?.addEventListener('click', (evento) => {
    const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>('button[data-pais]');
    if (boton && !boton.disabled && boton.dataset.pais) seleccionar(boton.dataset.pais);
  });

  // Teclado de un grupo de opciones: las flechas recorren los territorios.
  opciones?.addEventListener('keydown', (evento) => {
    if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(evento.key)) return;
    const botones = [...(opciones?.querySelectorAll<HTMLButtonElement>('button[data-pais]:not(:disabled)') ?? [])];
    const indice = botones.indexOf(document.activeElement as HTMLButtonElement);
    if (indice < 0 || botones.length < 2) return;
    evento.preventDefault();
    const paso = evento.key === 'ArrowDown' || evento.key === 'ArrowRight' ? 1 : -1;
    const siguiente = botones[(indice + paso + botones.length) % botones.length];
    if (siguiente?.dataset.pais) seleccionar(siguiente.dataset.pais);
  });

  async function iniciar() {
    if (!contenedor || !opciones || !ayuda) return;

    try {
      const roles = await getUserRoles();
      const rolCoordinador = roles.find(
        (rol) =>
          rol.codigo.toLocaleUpperCase('es-CL').includes('COORD') &&
          Boolean(rol.id_pais),
      );

      // El selector solo corresponde a coordinadores con país principal.
      if (!rolCoordinador?.id_pais) {
        sessionStorage.removeItem(CLAVE_TERRITORIO);
        notificarTerritorioActivo('');
        contenedor.hidden = true;
        return;
      }

      const [paises, coberturas] = await Promise.all([
        listarPaisesOrganizaciones(),
        listarMisCoberturasVigentes(),
      ]);

      const paisPrincipal = paises.find(
        (pais) => pais.id_pais === rolCoordinador.id_pais,
      );

      if (!paisPrincipal) {
        throw new Error('No fue posible identificar tu país principal.');
      }

      principal = {
        id_pais: paisPrincipal.id_pais,
        nombre: paisPrincipal.nombre,
        codigo_iso: paisPrincipal.codigo_iso,
        tipo: 'principal',
      };

      const paisesPorId = new Map(
        paises.map((pais) => [pais.id_pais, pais]),
      );

      coberturasRecibidas = coberturas.flatMap((cobertura) => {
        if (!cobertura.id_pais || cobertura.id_pais === principal?.id_pais) {
          return [];
        }

        const pais = paisesPorId.get(cobertura.id_pais);
        // Si el país no existe en el catálogo, no se muestra como opción.
        if (!pais) return [];

        return [{
          id_pais: cobertura.id_pais,
          nombre: pais.nombre,
          codigo_iso: pais.codigo_iso,
          tipo: 'cobertura' as const,
          inicio_at: cobertura.inicio_at,
          fin_at: cobertura.fin_at,
        }];
      });

      const firmaNueva = coberturasRecibidas
        .map(({ id_pais, inicio_at, fin_at }) => `${id_pais}:${inicio_at ?? ''}:${fin_at ?? ''}`)
        .sort()
        .join('|');
      if (firmaCoberturas !== undefined && firmaCoberturas !== firmaNueva) {
        invalidarAlcanceGestion();
        window.dispatchEvent(new CustomEvent('fge:alcance-gestion-cambiado'));
      }
      firmaCoberturas = firmaNueva;

      renderizarSelector(true);
    } catch (error) {
      // Fallo cerrado: no mostrar opciones territoriales cuya autorización
      // no se pudo verificar. El servidor valida igualmente cada operación.
      sessionStorage.removeItem(CLAVE_TERRITORIO);
      notificarTerritorioActivo('');
      contenedor.hidden = false;
      opciones.replaceChildren();
      const fallo = error as { status?: number; code?: string };
      const mensaje = fallo.status === 401 || fallo.code === 'SESION_REQUERIDA'
        ? 'Tu sesión venció. Inicia sesión nuevamente para consultar tus territorios.'
        : fallo.status === 403
          ? 'Tu cuenta no tiene permisos para consultar coberturas territoriales.'
          : error instanceof TypeError || fallo.status === 0 || (fallo.status !== undefined && fallo.status >= 500)
            ? 'No fue posible conectar con el servicio de territorios. Revisa tu conexión e inténtalo otra vez.'
            : 'No fue posible verificar tus territorios. Inténtalo nuevamente.';
      ayuda.textContent = mensaje;
      if (reintentar) reintentar.hidden = false;
      console.error(
        'No fue posible preparar el selector territorial:',
        error,
      );
    }
  }

  void iniciar();
  reintentar?.addEventListener('click', () => void iniciar());
  window.addEventListener('fge:alcance-gestion-cambiado', () => location.reload());

  // Una cobertura puede vencer o ser revocada desde otra sesión. Al volver a
  // enfocar la aplicación y, como respaldo, cada minuto visible, se vuelve a
  // consultar el Backend. Si ya no está autorizada se borra el contexto local.
  window.addEventListener('focus', () => void iniciar());
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') void iniciar();
  });
  window.addEventListener('fge:territorio-refrescar', () => void iniciar());
  window.setInterval(() => {
    if (document.visibilityState === 'visible') void iniciar();
  }, 60_000);
</script>
