---
interface Props {
  actual: 'catalogo' | 'solicitud';
}
const { actual } = Astro.props;
---
<header class="bg-[#423C76] text-white">
  <nav aria-label="Navegación pública" class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-3">
    <a href="/catalogo" class="inline-flex min-h-12 items-center" aria-label="Fundación Gestionar Esperanzas · Catálogo">
      <img src="/images/logo-fge-blanco.png" alt="Fundación Gestionar Esperanzas" width="820" height="248" class="h-11 w-auto object-contain md:h-12" />
    </a>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      <a href="/catalogo" aria-current={actual === 'catalogo' ? 'page' : undefined} class:list={['inline-flex min-h-12 items-center font-semibold', actual === 'catalogo' ? 'text-white underline decoration-white/50 underline-offset-8' : 'text-[#E5E2F8] hover:text-white']}>Catálogo</a>
      <a href="/login?returnTo=%2Fdashboard" class="inline-flex min-h-12 items-center font-semibold text-[#E5E2F8] hover:text-white">Iniciar sesión</a>
      <a href="/cotizar" aria-current={actual === 'solicitud' ? 'page' : undefined} class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-white px-4 font-semibold text-[#423C76] shadow-sm transition hover:bg-[#F0EEF8] focus-visible:outline-2 focus-visible:outline-white">
        Mi solicitud <span data-contador aria-label="productos seleccionados" class="inline-flex min-w-6 items-center justify-center rounded-full bg-brand-pink px-1.5 text-xs font-bold text-white">0</span>
      </a>
    </div>
  </nav>
</header>
<script>
  import { leerSeleccion, EVENTO_SELECCION } from '../../lib/cotizacion/seleccion';
  // El contador de «Mi solicitud» refleja la selección de esta pestaña en todo momento.
  function actualizar() {
    let total = 0;
    try { total = leerSeleccion().length; } catch { total = 0; }
    document.querySelectorAll<HTMLElement>('[data-contador]').forEach((nodo) => { nodo.textContent = String(total); });
  }
  window.addEventListener(EVENTO_SELECCION, actualizar);
  actualizar();
</script>
