---
import Icono from '../ui/Icono.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

const { idAccion } = Astro.props;
---

<section
  id="indicadores-accion"
  data-accion={idAccion}
  class="space-y-5"
  aria-labelledby="indicadores-titulo"
>
  <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div class="flex min-w-0 items-start gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#EDEBFA] text-primary" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <path d="m7 14 4-4 3 3 6-8" />
          <path d="M16 5h4v4" />
        </svg>
      </span>
      <div class="min-w-0">
        <h2 id="indicadores-titulo" class="text-xl font-bold tracking-tight text-neutral-900 md:text-2xl">
          Indicadores y resultados
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-neutral-500">
          Define qué esperas alcanzar y registra lo obtenido. La meta y el resultado se muestran por separado.
        </p>
      </div>
    </div>

    <Button id="ind-recargar" variant="outline">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 7v5h-5M4 17v-5h5" />
        <path d="M5.5 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.5-1" />
      </svg>
      Actualizar indicadores
    </Button>
  </header>

  <p id="ind-carga" hidden role="status" class="rounded-xl border border-primary/15 bg-[#F4F2FC] p-4 text-sm text-primary">
    Cargando indicadores…
  </p>
  <p id="ind-error" hidden role="alert" tabindex="-1" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></p>
  <p id="ind-exito" hidden role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800"></p>

  <div class="grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <Card class="h-full p-4 md:p-5">
      <div class="mb-5 flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E5F5EC] text-[#18865A]" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16v16H4z" />
            <path d="M8 8h8M8 12h5M8 16h8" />
          </svg>
        </span>
        <div class="min-w-0">
          <h3 class="text-base font-bold text-neutral-900">Catálogo estandarizado</h3>
          <p class="mt-1 text-sm leading-5 text-neutral-500">
            Selecciona los indicadores que correspondan y define la meta de cada uno.
          </p>
        </div>
      </div>

      <p id="ind-catalogo-vacio" hidden class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-600">
        No hay indicadores disponibles en el catálogo.
      </p>

      <form id="ind-form" novalidate>
        <fieldset id="ind-campos" disabled class="min-w-0 space-y-4">
          <legend class="sr-only">Indicadores disponibles y metas</legend>
          <div id="ind-catalogo" class="space-y-3"></div>
          <p id="ind-seleccion-error" hidden role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-800"></p>
          <div class="flex flex-wrap gap-3 border-t border-neutral-100 pt-4">
            <Button id="ind-asociar" type="submit">Asociar indicadores</Button>
            <Button id="ind-limpiar" variant="outline"> <Icono nombre="limpiar" />Limpiar selección</Button>
          </div>
        </fieldset>
      </form>
    </Card>

    <Card class="h-full p-4 md:p-5">
      <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
        <div class="flex min-w-0 items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#E5F2FC] text-[#2473B8]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 4h8l4 4v12H4V4h4Z" />
              <path d="M14 4v5h5M8 13h8M8 17h5" />
            </svg>
          </span>
          <div class="min-w-0">
            <h3 class="text-base font-bold text-neutral-900">Indicadores asociados</h3>
            <p class="mt-1 text-sm leading-5 text-neutral-500">Registra el avance frente a cada meta y consulta sus resultados.</p>
          </div>
        </div>
        <span id="ind-cantidad" class="inline-flex shrink-0 items-center rounded-full bg-[#EDEBFA] px-3 py-1 text-xs font-semibold text-primary">—</span>
      </div>

      <p id="ind-vacio" hidden class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 px-4 py-6 text-center text-sm leading-6 text-neutral-600">
        Esta acción todavía no tiene indicadores asociados. Selecciona los que correspondan en el catálogo para comenzar.
      </p>
      <div id="ind-lista" class="min-w-0 space-y-3"></div>
    </Card>
  </div>

  <dialog
    id="ind-dialogo"
    aria-labelledby="ind-dialogo-titulo"
    class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-xl overflow-y-auto rounded-2xl border border-[#E8E5EF] bg-white p-0 text-neutral-900 shadow-[0_20px_60px_rgba(26,26,26,0.2)] backdrop:bg-neutral-900/40"
  >
    <div class="border-b border-neutral-100 px-6 py-5">
      <h3 id="ind-dialogo-titulo" class="text-xl font-bold text-primary md:text-2xl">Registrar resultado</h3>
      <p id="ind-contexto" class="mt-2 break-words text-sm leading-6 text-neutral-600"></p>
    </div>
    <div class="px-6 py-5">
      <p id="ind-dialogo-error" hidden role="alert" tabindex="-1" class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800"></p>
      <p id="ind-dialogo-carga" hidden role="status" class="mb-4 rounded-lg bg-[#F4F2FC] p-3 text-sm text-primary">Guardando…</p>

      <form id="ind-edicion" novalidate>
        <fieldset id="ind-edicion-campos" class="min-w-0 space-y-5">
          <div>
            <Input id="ind-valor" name="valor" type="number" label="Valor" required />
            <p id="ind-valor-ayuda" class="mt-2 text-xs leading-5 text-neutral-500">
              Ingresa un valor mayor o igual a cero. Cero es un valor registrado; un campo vacío no lo es.
            </p>
          </div>
          <div id="ind-resultado-campos" class="space-y-5">
            <Input id="ind-fecha" name="fecha_medicion" type="date" label="Fecha de medición" required />
            <div>
              <label for="ind-observaciones" class="text-sm font-semibold text-neutral-700">Observaciones (opcional)</label>
              <textarea id="ind-observaciones" name="observaciones" rows="3" maxlength="1000" class="mt-2 w-full rounded-xl border border-neutral-200 bg-white p-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"></textarea>
            </div>
          </div>
          <div class="flex flex-wrap justify-end gap-3 border-t border-neutral-100 pt-4">
            <Button id="ind-cancelar" variant="outline">Cancelar</Button>
            <Button id="ind-guardar" type="submit">Guardar resultado</Button>
          </div>
        </fieldset>
      </form>
    </div>
  </dialog>
</section>

<script>
  import { iniciarIndicadores } from '../../lib/indicadores/interfaz';
  iniciarIndicadores();
</script>

<style is:global>
  #indicadores-accion .indicador-valor {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: #1f2937;
  }

  #indicadores-accion #ind-lista > * {
    min-width: 0;
    border-radius: 0.875rem;
  }

  #indicadores-accion #ind-catalogo > * {
    min-width: 0;
  }
</style>
