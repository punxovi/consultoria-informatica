---
import Icono from '../ui/Icono.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

const { idAccion } = Astro.props;
---

<section
  id="indicadores-accion"
  data-accion={idAccion}
  class="space-y-5"
  aria-labelledby="indicadores-titulo"
>
  <header class="flex flex-col gap-4 border-l-4 border-[#4C4688] pl-4 sm:flex-row sm:items-center sm:justify-between sm:pl-5">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#77719F]">Seguimiento de la acción</p>
      <h2 id="indicadores-titulo" class="mt-1 text-2xl font-bold tracking-tight text-neutral-900">Indicadores y resultados</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-neutral-500">Metas definidas para esta acción y los resultados obtenidos en cada una.</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button id="ind-recargar" variant="outline">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 7v5h-5M4 17v-5h5" />
          <path d="M5.5 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.5-1" />
        </svg>
        Actualizar
      </Button>
      <Button id="ind-nueva" disabled aria-controls="ind-vista-form">
        <span aria-hidden="true" class="mr-1.5">＋</span> Agregar indicadores
      </Button>
    </div>
  </header>

  <p id="ind-carga" hidden role="status" class="rounded-xl border border-primary/15 bg-[#F4F2FC] p-4 text-sm text-primary">
    Cargando indicadores…
  </p>
  <p id="ind-error" hidden role="alert" tabindex="-1" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></p>
  <p id="ind-exito" hidden role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800"></p>

  <div id="ind-vista-lista" class="min-w-0 space-y-4">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#77719F]">Metas y avance</p>
        <h3 class="mt-1 text-lg font-semibold text-neutral-900">Indicadores asociados</h3>
      </div>
      <p id="ind-cantidad" class="text-sm text-neutral-500">—</p>
    </div>
    <div id="ind-vacio" hidden class="rounded-2xl border border-dashed border-neutral-300 bg-white px-4 py-10 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-[#EDEBFA] text-primary" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <path d="m7 14 4-4 3 3 6-8" />
        </svg>
      </span>
      <h4 class="mt-3 font-semibold text-neutral-900">Todavía no hay indicadores</h4>
      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-neutral-600">Pulsa «Agregar indicadores» para elegirlos del catálogo y definir la meta de cada uno.</p>
    </div>
    <div id="ind-lista" class="grid min-w-0 gap-4 lg:grid-cols-2"></div>
  </div>

  <div id="ind-vista-form" hidden class="min-w-0">
    <Card class="p-4 md:p-6">
      <div class="mb-6 flex items-start gap-4 border-b border-[#EEEAF5] pb-5">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#EDEBFA] text-[#4C4688]" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16v16H4z" />
            <path d="M8 8h8M8 12h5M8 16h8" />
          </svg>
        </span>
        <div class="min-w-0">
          <h3 class="text-lg font-bold tracking-tight text-[#383165] md:text-xl">Agregar indicadores del catálogo</h3>
          <p class="mt-1 text-sm leading-5 text-[#706E78]">
            Selecciona los indicadores que correspondan y define la meta de cada uno.
          </p>
        </div>
      </div>

      <p id="ind-catalogo-vacio" hidden class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-600">
        No hay indicadores disponibles en el catálogo.
      </p>

      <form id="ind-form" novalidate>
        <fieldset id="ind-campos" disabled class="min-w-0 space-y-4">
          <legend class="sr-only">Indicadores disponibles y metas</legend>
          <div id="ind-catalogo" class="grid items-start gap-3 lg:grid-cols-2"></div>
          <p id="ind-seleccion-error" hidden role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-800"></p>
          <div class="flex flex-col-reverse gap-3 border-t border-[#EEEAF5] pt-5 sm:flex-row sm:flex-wrap sm:justify-end">
            <Button id="ind-volver" variant="outline">Cancelar</Button>
            <Button id="ind-limpiar" variant="outline"><Icono nombre="limpiar" />Limpiar selección</Button>
            <Button id="ind-asociar" type="submit">Asociar indicadores</Button>
          </div>
        </fieldset>
      </form>
    </Card>
  </div>

  <dialog
    id="ind-dialogo"
    aria-labelledby="ind-dialogo-titulo"
    class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-lg overflow-y-auto rounded-2xl border border-[#E8E5EF] bg-white p-0 text-[#1A1A1A] shadow-[0_20px_60px_rgba(26,26,26,0.2)] backdrop:bg-[#1A1A1A]/50"
  >
    <form id="ind-edicion" novalidate>
      <fieldset id="ind-edicion-campos" class="min-w-0">
        <div class="border-b border-[#EEEAF5] px-6 py-5">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#EDEBFA] text-[#4C4688]" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18" />
                <path d="m7 14 4-4 3 3 6-8" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <h3 id="ind-dialogo-titulo" class="text-lg font-bold tracking-tight text-[#383165] md:text-xl">Registrar resultado</h3>
              <p id="ind-contexto" class="mt-1 break-words text-sm text-[#706E78]"></p>
            </div>
          </div>
        </div>

        <div class="space-y-5 px-6 py-5">
          <p id="ind-dialogo-error" hidden role="alert" tabindex="-1" class="rounded-lg border border-[#F5C4D6] bg-[#FCE8F0] p-3 text-sm text-[#AD174F]"></p>
          <p id="ind-dialogo-carga" hidden role="status" class="rounded-lg bg-[#F4F2FC] p-3 text-sm text-primary">Guardando…</p>
          <div>
            <Input id="ind-valor" name="valor" type="number" label="Valor" required />
            <p id="ind-valor-ayuda" class="mt-2 text-xs leading-5 text-neutral-500">
              Ingresa un valor mayor o igual a cero. Cero es un valor registrado; un campo vacío no lo es.
            </p>
          </div>
          <div id="ind-resultado-campos" class="space-y-5">
            <Input id="ind-fecha" name="fecha_medicion" type="date" label="Fecha de medición" required />
            <div>
              <label for="ind-observaciones" class="text-sm font-semibold text-neutral-700">Observaciones (opcional)</label>
              <textarea id="ind-observaciones" name="observaciones" rows="3" maxlength="1000" class="mt-2 w-full rounded-xl border border-neutral-200 bg-white p-3 text-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"></textarea>
            </div>
          </div>
          <div class="rounded-xl border border-[#F5D989] bg-[#FFF8E5] px-4 py-3">
            <p class="text-sm leading-5 text-[#805600]">Esta operación modificará los registros del sistema. Revisa la información antes de confirmar.</p>
          </div>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-[#EEEAF5] bg-[#FAF9FC] px-6 py-4 sm:flex-row sm:justify-end">
          <Button id="ind-cancelar" variant="outline">Cancelar</Button>
          <Button id="ind-guardar" type="submit">Guardar resultado</Button>
        </div>
      </fieldset>
    </form>
  </dialog>
</section>

<script>
  import { iniciarIndicadores } from '../../lib/indicadores/interfaz';
  iniciarIndicadores();
</script>

<style is:global>
  #indicadores-accion .indicador-valor {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: #1f2937;
  }

  #indicadores-accion .indicador-pendiente {
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
  }

  #indicadores-accion #ind-lista > * {
    min-width: 0;
    border-radius: 0.875rem;
  }

  #indicadores-accion #ind-catalogo > * {
    min-width: 0;
  }
</style>
