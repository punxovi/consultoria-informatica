---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
---
<section id="solicitudes-invitado" class="min-w-0 space-y-6">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    {['Total de solicitudes', 'Pendientes', 'Aprobadas'].map((titulo, i) => (
      <Card class="border-l-4 border-l-primary p-4">
        <p class="text-sm font-medium text-neutral-500">{titulo}</p>
        <p id={`invitados-metrica-${i}`} class="mt-2 text-3xl font-bold text-primary">—</p>
      </Card>
    ))}
  </div>
  <Card class="p-4 md:p-5">
    <h2 class="text-lg font-semibold text-neutral-900">Consultar solicitudes</h2>
    <p class="mt-1 text-sm text-neutral-500">Busca por nombre, correo o institución y filtra por estado.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div><label for="buscar-solicitud">Buscar solicitud</label><input id="buscar-solicitud" type="search" placeholder="Nombre, correo o institución" class="mt-2 min-h-12 w-full rounded-xl border border-[#DCD8EA] px-3" /></div>
      <div><label for="filtro-estado-solicitud">Estado de la solicitud</label><select id="filtro-estado-solicitud" class="mt-2 min-h-12 w-full rounded-xl border border-[#DCD8EA] px-3">
        <option value="">Todos los estados</option><option value="pendiente">Pendientes</option><option value="aprobado">Aprobadas</option><option value="rechazado">Rechazadas</option><option value="revocado">Revocadas</option>
      </select></div>
    </div>
    <div class="mt-4 flex flex-wrap gap-3"><Button id="invitados-limpiar" variant="outline">Limpiar filtros</Button><Button id="invitados-recargar" variant="outline">Actualizar listado</Button></div>
  </Card>
  <p id="invitados-carga" role="status" class="text-neutral-600">Cargando solicitudes…</p>
  <p id="invitados-error" hidden role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-800"></p>
  <p id="invitados-exito" hidden role="status" class="rounded-xl border border-green-200 bg-green-50 p-4 text-green-800"></p>
  <h2 class="text-lg font-semibold">Solicitudes recibidas</h2>
  <p id="invitados-vacio" hidden role="status" class="rounded-xl border border-dashed border-[#DCD8EA] bg-white p-6 text-center text-neutral-500"></p>
  <div id="invitados-lista" class="grid gap-4 lg:grid-cols-2"></div>
  <dialog id="invitados-dialogo" aria-labelledby="invitados-dialogo-titulo" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-[#DCD8EA] p-6 backdrop:bg-black/40">
    <h2 id="invitados-dialogo-titulo" class="text-xl font-bold"></h2>
    <p id="invitados-dialogo-texto" class="mt-3 break-words text-neutral-600"></p>
    <p id="invitados-dialogo-error" hidden role="alert" class="mt-3 text-rose-800"></p>
    <div class="mt-5 flex flex-wrap gap-3"><Button id="invitados-confirmar">Confirmar</Button><Button id="invitados-cancelar" variant="outline">Cancelar</Button></div>
  </dialog>
</section>
<script>
  import { iniciarSolicitudesInvitado } from '../../lib/invitados/interfaz';
  void iniciarSolicitudesInvitado();
</script>
