---
import Icono from '../ui/Icono.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

const claseControl =
  'min-h-12 w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary disabled:cursor-not-allowed disabled:bg-neutral-50';

const metricas = [
  { titulo: 'Solicitantes', acento: 'acento-morado', icono: 'bg-primary/10 text-primary' },
  { titulo: 'Pendientes', acento: 'acento-amarillo', icono: 'bg-brand-yellow/20 text-[#946200]' },
  { titulo: 'Aprobadas', acento: 'acento-verde', icono: 'bg-brand-green/10 text-brand-green' },
];
---

<section id="solicitudes-invitado" class="min-w-0 space-y-6">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="Resumen de solicitudes">
    {metricas.map((metrica, indice) => (
      <Card class={`tarjeta-acento ${metrica.acento} p-4`}>
        <div class="flex items-center gap-3">
          <span class={`rounded-xl p-3 ${metrica.icono}`} aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{metrica.titulo}</p>
            <p id={`invitados-metrica-${indice}`} class="mt-1 text-2xl font-bold text-neutral-900">—</p>
          </div>
        </div>
      </Card>
    ))}
  </div>

  <Card class="p-4 md:p-5">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-neutral-900">Filtrar solicitudes</h2>
      <p class="mt-1 text-sm text-neutral-500">Busca por nombre, correo o institución y filtra por estado.</p>
    </div>
    <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2">
      <div class="space-y-1.5">
        <label for="buscar-solicitud" class="block text-sm font-medium text-neutral-800">Nombre, correo o institución</label>
        <input id="buscar-solicitud" type="search" autocomplete="off" placeholder="Ej. María o Universidad" class={claseControl} />
      </div>
      <div class="space-y-1.5">
        <label for="filtro-estado-solicitud" class="block text-sm font-medium text-neutral-800">Estado</label>
        <select id="filtro-estado-solicitud" class={claseControl}>
          <option value="">Todos los estados</option>
          <option value="pendiente">Pendientes</option>
          <option value="aprobado">Aprobadas</option>
          <option value="rechazado">Rechazadas</option>
          <option value="revocado">Revocadas</option>
        </select>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
      <p id="invitados-conteo" role="status" aria-live="polite" class="text-sm text-neutral-500"></p>
      <div class="flex flex-wrap gap-2">
        <Button id="invitados-limpiar" variant="outline" size="lg"><Icono nombre="limpiar" />Limpiar filtros</Button>
      </div>
    </div>
  </Card>

  <div id="invitados-error-caja" hidden class="flex flex-col gap-3 rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger sm:flex-row sm:items-center sm:justify-between">
    <p id="invitados-error" role="alert"></p>
    <Button id="invitados-reintentar" variant="outline" size="lg" class="shrink-0">Reintentar</Button>
  </div>
  <p id="invitados-exito" hidden role="status" class="rounded-xl border border-success/20 bg-success/10 p-4 text-sm text-success"></p>

  <section aria-labelledby="invitados-listado-titulo" class="space-y-4">
    <h2 id="invitados-listado-titulo" class="text-lg font-semibold text-neutral-900">Listado de solicitudes</h2>
    <p id="invitados-carga" role="status" class="flex items-center justify-center gap-3 rounded-2xl border border-[#E4E0F2] bg-white p-6 text-sm text-neutral-500">
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-[#D8D3E8] border-t-primary" aria-hidden="true"></span>
      Cargando solicitudes…
    </p>
    <p id="invitados-vacio" hidden role="status" class="rounded-2xl border border-dashed border-[#DCD8EA] bg-white p-6 text-center text-sm text-neutral-500"></p>
    <div id="invitados-lista" class="grid gap-3 lg:grid-cols-2"></div>
  </section>

  <dialog id="invitados-historial" aria-labelledby="invitados-historial-titulo" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-[#DCD8EA] p-6 backdrop:bg-black/40">
    <h2 id="invitados-historial-titulo" class="text-xl font-semibold text-neutral-900">Historial de solicitudes</h2>
    <p id="invitados-historial-subtitulo" class="mt-1 break-words text-sm text-neutral-500"></p>
    <ol id="invitados-historial-lista" class="mt-5 max-h-[60vh] space-y-3 overflow-y-auto"></ol>
    <div class="mt-6 flex justify-end">
      <Button id="invitados-historial-cerrar" variant="outline">Cerrar</Button>
    </div>
  </dialog>

  <dialog id="invitados-dialogo" aria-labelledby="invitados-dialogo-titulo" class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-[#DCD8EA] p-6 backdrop:bg-black/40">
    <h2 id="invitados-dialogo-titulo" class="text-xl font-semibold text-neutral-900"></h2>
    <p id="invitados-dialogo-texto" class="mt-3 break-words text-sm leading-6 text-neutral-600"></p>
    <p id="invitados-dialogo-error" hidden role="alert" class="mt-3 text-sm text-danger"></p>
    <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <Button id="invitados-cancelar" variant="outline">Cancelar</Button>
      <Button id="invitados-confirmar">Confirmar</Button>
    </div>
  </dialog>
</section>

<script>
  import { iniciarSolicitudesInvitado } from '../../lib/invitados/interfaz';
  void iniciarSolicitudesInvitado();
</script>
