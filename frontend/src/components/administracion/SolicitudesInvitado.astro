---
import Card from '../ui/Card.astro';
---

<section id="solicitudes-invitado" class="guest-admin" aria-live="polite">
  <div class="guest-stats" aria-label="Resumen de solicitudes">
    <Card class="guest-stat"><span>Solicitudes consultadas</span><strong id="guest-total">—</strong></Card>
    <Card class="guest-stat guest-stat-pending"><span>Pendientes</span><strong id="guest-pending">—</strong></Card>
    <Card class="guest-stat guest-stat-approved"><span>Aprobadas</span><strong id="guest-approved">—</strong></Card>
  </div>

  <Card class="guest-filter-card">
    <div class="guest-filter-heading">
      <div>
        <h2>Consultar solicitudes</h2>
        <p>Busca por nombre, correo o institución y filtra por estado. Se consultan las últimas 200 solicitudes.</p>
      </div>
      <button id="guest-reload" type="button" class="guest-button guest-button-secondary">Recargar</button>
    </div>
    <div class="guest-filters">
      <label>Buscar solicitud
        <input id="guest-search" type="search" placeholder="Nombre, correo o institución" autocomplete="off" />
      </label>
      <label>Estado de la solicitud
        <select id="guest-status">
          <option value="">Todos los estados</option>
          <option value="pendiente">Pendientes</option>
          <option value="aprobado">Aprobadas</option>
          <option value="rechazado">Rechazadas</option>
          <option value="revocado">Revocadas</option>
        </select>
      </label>
    </div>
    <p id="guest-feedback" class="guest-feedback" role="status" hidden></p>
  </Card>

  <section aria-labelledby="guest-list-heading">
    <h2 id="guest-list-heading" class="guest-list-heading">Solicitudes recibidas</h2>
    <div id="guest-list" class="guest-list" aria-live="polite">
      <div class="guest-empty">Cargando solicitudes…</div>
    </div>
  </section>
</section>

<script>
  import { getSupabaseClient } from '../../lib/supabase';
  import { createAuthTransport } from '../../lib/auth/transporte';

  type Guest = {
    id_invitado: string;
    nombre: string;
    correo: string;
    institucion?: string | null;
    motivo?: string | null;
    estado: 'pendiente' | 'aprobado' | 'rechazado' | 'revocado';
    version: number;
    created_at: string;
    updated_at: string;
    aprobado_en?: string | null;
    utilizado_en?: string | null;
    expira_en?: string | null;
  };

  const transport = createAuthTransport(import.meta.env.PUBLIC_API_BASE_URL ?? 'http://127.0.0.1:4000');
  const list = document.getElementById('guest-list');
  const feedback = document.getElementById('guest-feedback');
  const search = document.getElementById('guest-search') as HTMLInputElement | null;
  const statusFilter = document.getElementById('guest-status') as HTMLSelectElement | null;
  const reloadButton = document.getElementById('guest-reload') as HTMLButtonElement | null;
  let guests: Guest[] = [];
  let busy = false;

  function announce(message: string, kind: 'error' | 'success' | 'info' = 'info') {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = `guest-feedback guest-feedback-${kind}`;
    feedback.hidden = false;
  }

  function hideAnnouncement() {
    if (!feedback) return;
    feedback.hidden = true;
    feedback.textContent = '';
  }

  async function accessToken() {
    const { data, error } = await getSupabaseClient().auth.getSession();
    if (error || !data.session?.access_token) throw new Error('Tu sesión expiró. Inicia sesión nuevamente.');
    return data.session.access_token;
  }

  function updateStats() {
    const set = (id: string, value: number) => {
      const element = document.getElementById(id);
      if (element) element.textContent = String(value);
    };
    set('guest-total', guests.length);
    set('guest-pending', guests.filter((guest) => guest.estado === 'pendiente').length);
    set('guest-approved', guests.filter((guest) => guest.estado === 'aprobado').length);
  }

  function date(value: string) {
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? 'Fecha no disponible' : new Intl.DateTimeFormat('es-CL', {
      dateStyle: 'medium', timeStyle: 'short',
    }).format(parsed);
  }

  function button(label: string, action: string, secondary = false) {
    const element = document.createElement('button');
    element.type = 'button';
    element.className = `guest-button ${secondary ? 'guest-button-secondary' : 'guest-button-primary'}`;
    element.dataset.action = action;
    element.textContent = label;
    element.disabled = busy;
    return element;
  }

  function render() {
    if (!list) return;
    updateStats();
    const needle = search?.value.trim().toLocaleLowerCase('es-CL') ?? '';
    const selectedStatus = statusFilter?.value ?? '';
    const visible = guests.filter((guest) => {
      const matchesText = !needle || [guest.nombre, guest.correo, guest.institucion ?? '']
        .some((value) => value.toLocaleLowerCase('es-CL').includes(needle));
      return matchesText && (!selectedStatus || guest.estado === selectedStatus);
    });

    list.replaceChildren();
    if (!visible.length) {
      const empty = document.createElement('div');
      empty.className = 'guest-empty';
      empty.textContent = guests.length ? 'No hay solicitudes que coincidan con esos filtros.' : 'Aún no hay solicitudes para mostrar.';
      list.append(empty);
      return;
    }

    for (const guest of visible) {
      const article = document.createElement('article');
      article.className = 'guest-card';

      const title = document.createElement('div');
      title.className = 'guest-card-title';
      const name = document.createElement('h3');
      name.textContent = guest.nombre;
      const badge = document.createElement('span');
      badge.className = `guest-badge guest-badge-${guest.estado}`;
      badge.textContent = ({ pendiente: 'Pendiente', aprobado: 'Aprobada', rechazado: 'Rechazada', revocado: 'Revocada' } as const)[guest.estado];
      title.append(name, badge);

      const details = document.createElement('dl');
      details.className = 'guest-details';
      const addDetail = (label: string, value?: string | null) => {
        if (!value) return;
        const wrapper = document.createElement('div');
        const term = document.createElement('dt');
        term.textContent = label;
        const description = document.createElement('dd');
        description.textContent = value;
        wrapper.append(term, description);
        details.append(wrapper);
      };
      addDetail('Correo', guest.correo);
      addDetail('Institución u organización', guest.institucion);
      addDetail('Motivo', guest.motivo);
      addDetail('Recibida', date(guest.created_at));
      if (guest.utilizado_en) addDetail('Primer acceso', date(guest.utilizado_en));
      if (guest.expira_en) addDetail('Acceso vigente hasta', date(guest.expira_en));

      const actions = document.createElement('div');
      actions.className = 'guest-actions';
      if (guest.estado === 'pendiente') {
        actions.append(button('Aprobar y enviar enlace', 'approve'), button('Rechazar', 'reject', true));
      } else if (guest.estado === 'aprobado' && !guest.utilizado_en) {
        actions.append(button('Reenviar enlace de acceso', 'approve', true), button('Revocar enlace', 'revoke', true));
      } else if (guest.estado === 'aprobado') {
        actions.append(button('Revocar acceso', 'revoke', true));
      }
      if (actions.childElementCount) actions.dataset.guestId = guest.id_invitado;

      article.append(title, details);
      if (actions.childElementCount) article.append(actions);
      list.append(article);
    }
  }

  async function load(showMessage = false) {
    if (busy) return;
    if (reloadButton) reloadButton.disabled = true;
    hideAnnouncement();
    if (list && guests.length === 0) {
      list.replaceChildren(Object.assign(document.createElement('div'), { className: 'guest-empty', textContent: 'Cargando solicitudes…' }));
    }
    try {
      const result = await transport.request<{ guests: Guest[] }>('/api/v1/guests', { accessToken: await accessToken() });
      guests = Array.isArray(result.data.guests) ? result.data.guests : [];
      render();
      if (showMessage) announce('Solicitudes actualizadas.', 'success');
    } catch (error) {
      if (list && guests.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'guest-empty guest-empty-error';
        empty.textContent = error instanceof Error ? error.message : 'No fue posible consultar las solicitudes.';
        list.replaceChildren(empty);
      }
      announce(error instanceof Error ? error.message : 'No fue posible consultar las solicitudes.', 'error');
    } finally {
      if (reloadButton) reloadButton.disabled = false;
    }
  }

  async function performAction(guestId: string, action: 'approve' | 'reject' | 'revoke') {
    const guest = guests.find((item) => item.id_invitado === guestId);
    if (!guest || busy) return;
    const labels = { approve: 'aprobar y enviar el enlace a', reject: 'rechazar', revoke: 'revocar el acceso de' };
    if (!window.confirm(`¿Confirmas ${labels[action]} a ${guest.nombre}?`)) return;

    busy = true;
    hideAnnouncement();
    render();
    try {
      const result = await transport.request<{ guest: Guest }>(`/api/v1/guests/${encodeURIComponent(guest.id_invitado)}/${action}`, {
        method: 'POST',
        accessToken: await accessToken(),
        body: { version_esperada: guest.version },
      });
      guests = guests.map((item) => item.id_invitado === guest.id_invitado ? result.data.guest : item);
      render();
      announce(action === 'approve'
        ? 'Solicitud aprobada. Supabase Auth aceptó el envío del enlace de acceso.'
        : action === 'reject' ? 'Solicitud rechazada.' : 'Acceso revocado.', 'success');
      await refreshAfterAction();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No fue posible actualizar la solicitud.';
      announce(message, 'error');
      // La aprobación se persiste antes de solicitar el correo. Al fallar el envío,
      // recargamos la versión y dejamos disponible «Reenviar enlace de acceso».
      await refreshAfterAction();
    } finally {
      busy = false;
      render();
    }
  }

  async function refreshAfterAction() {
    try {
      const result = await transport.request<{ guests: Guest[] }>('/api/v1/guests', { accessToken: await accessToken() });
      guests = Array.isArray(result.data.guests) ? result.data.guests : [];
    } catch {
      // Conserva la respuesta actual; el botón Recargar permite volver a sincronizar.
    }
  }

  search?.addEventListener('input', render);
  statusFilter?.addEventListener('change', render);
  reloadButton?.addEventListener('click', () => void load(true));
  list?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;
    const action = target.dataset.action;
    const guestId = target.closest<HTMLElement>('[data-guest-id]')?.dataset.guestId;
    if (guestId && (action === 'approve' || action === 'reject' || action === 'revoke')) {
      void performAction(guestId, action);
    }
  });

  void load();
</script>

<style>
  .guest-admin { display: grid; gap: 1.5rem; min-width: 0; }
  .guest-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .guest-stat { display: grid; gap: .35rem; border-left: 4px solid #4c4688; padding: 1rem 1.25rem; }
  .guest-stat span { color: #777482; font-size: .8rem; text-transform: uppercase; letter-spacing: .035em; }
  .guest-stat strong { color: #17151d; font-size: 1.7rem; }
  .guest-stat-pending { border-left-color: #d69b24; }
  .guest-stat-approved { border-left-color: #359767; }
  .guest-filter-card { padding: 1.15rem 1.25rem; }
  .guest-filter-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .guest-filter-heading h2, .guest-list-heading { margin: 0; color: #201e27; font-size: 1.1rem; font-weight: 650; }
  .guest-filter-heading p { margin: .25rem 0 0; color: #777482; font-size: .9rem; }
  .guest-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .guest-filters label { display: grid; gap: .4rem; color: #383165; font-size: .86rem; font-weight: 600; }
  .guest-filters input, .guest-filters select { width: 100%; min-height: 2.8rem; border: 1px solid #dcd8ea; border-radius: .7rem; background: white; padding: .65rem .8rem; color: #272432; font: inherit; font-weight: 400; }
  .guest-filters input:focus, .guest-filters select:focus { outline: 3px solid #4c468822; border-color: #4c4688; }
  .guest-button { min-height: 2.5rem; border: 1px solid #4c4688; border-radius: .7rem; padding: .55rem .85rem; font: inherit; cursor: pointer; transition: opacity .15s ease; }
  .guest-button:disabled { cursor: wait; opacity: .55; }
  .guest-button-primary { background: #4c4688; color: #fff; }
  .guest-button-secondary { background: #fff; color: #4c4688; }
  .guest-feedback { margin: 1rem 0 0; border-radius: .7rem; padding: .75rem .9rem; font-size: .9rem; }
  .guest-feedback-error { border: 1px solid #ffc4c4; background: #fff4f4; color: #a32323; }
  .guest-feedback-success { border: 1px solid #b7edca; background: #f1fff5; color: #176a38; }
  .guest-feedback-info { border: 1px solid #d8d2f0; background: #efedfa; color: #383165; }
  .guest-list-heading { margin-bottom: .85rem; }
  .guest-list { display: grid; gap: .85rem; }
  .guest-card { display: grid; gap: 1rem; border: 1px solid #e7e3ef; border-radius: 1rem; background: #fff; padding: 1.15rem 1.25rem; box-shadow: 0 5px 18px #2924420b; }
  .guest-card-title { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; }
  .guest-card-title h3 { margin: 0; color: #1d1b24; font-size: 1.08rem; font-weight: 650; }
  .guest-badge { border: 1px solid #e2deec; border-radius: 999px; padding: .25rem .65rem; color: #4a4660; background: #f6f4fa; font-size: .78rem; }
  .guest-badge-pendiente { color: #825800; border-color: #f2d997; background: #fff9e9; }
  .guest-badge-aprobado { color: #176a38; border-color: #b7edca; background: #f1fff5; }
  .guest-badge-rechazado, .guest-badge-revocado { color: #7c3434; border-color: #f1caca; background: #fff5f5; }
  .guest-details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem 1.2rem; margin: 0; }
  .guest-details dt { color: #777482; font-size: .72rem; font-weight: 600; text-transform: uppercase; }
  .guest-details dd { margin: .2rem 0 0; color: #25232c; font-size: .92rem; overflow-wrap: anywhere; white-space: pre-wrap; }
  .guest-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .55rem; border-top: 1px solid #f0edf5; padding-top: .85rem; }
  .guest-empty { border: 1px dashed #d8d3e8; border-radius: 1rem; background: #fff; padding: 2.25rem 1rem; color: #777482; text-align: center; }
  .guest-empty-error { color: #a32323; }
  @media (max-width: 700px) { .guest-stats { grid-template-columns: 1fr; } .guest-filters, .guest-details { grid-template-columns: 1fr; } .guest-filter-heading { align-items: flex-start; flex-direction: column; } }
</style>
