
---
import Card from '../ui/Card.astro';
---

<section id="solicitudes-invitado" class="min-w-0 space-y-6">

  <!-- Indicadores -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <Card class="border-l-4 border-l-primary p-4">
      <p class="text-sm font-medium text-neutral-500">Total de solicitudes</p>
      <p class="mt-2 text-3xl font-bold text-neutral-400">—</p>
    </Card>

    <Card class="border-l-4 border-l-[#D69B24] p-4">
      <p class="text-sm font-medium text-neutral-500">Pendientes</p>
      <p class="mt-2 text-3xl font-bold text-neutral-400">—</p>
    </Card>

    <Card class="border-l-4 border-l-brand-green p-4">
      <p class="text-sm font-medium text-neutral-500">Aprobadas</p>
      <p class="mt-2 text-3xl font-bold text-neutral-400">—</p>
    </Card>
  </div>

  <!-- Filtros -->
  <Card class="p-4 md:p-5">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-neutral-900">
        Consultar solicitudes
      </h2>
      <p class="mt-1 text-sm text-neutral-500">
        Busca por nombre, correo o institución y filtra por estado.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="space-y-1.5">
        <label for="buscar-solicitud" class="text-sm font-medium text-neutral-800">
          Buscar solicitud
        </label>
        <input
          id="buscar-solicitud"
          type="search"
          disabled
          placeholder="Nombre, correo o institución"
          class="min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-neutral-50 px-3 text-sm text-neutral-400 disabled:cursor-not-allowed"
        />
      </div>

      <div class="space-y-1.5">
        <label for="filtro-estado-solicitud" class="text-sm font-medium text-neutral-800">
          Estado de la solicitud
        </label>
        <select
          id="filtro-estado-solicitud"
          disabled
          class="min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-neutral-50 px-3 text-sm text-neutral-400 disabled:cursor-not-allowed"
        >
          <option value="">Todos los estados</option>
          <option value="pendiente">Pendientes</option>
          <option value="aprobada">Aprobadas</option>
          <option value="rechazada">Rechazadas</option>
        </select>
      </div>
    </div>

    <div class="mt-4 border-t border-neutral-100 pt-3">
      <p role="status" class="text-sm text-neutral-500">
        La consulta estará disponible cuando se conecte el servicio de solicitudes.
      </p>
    </div>
  </Card>

  <!-- Listado -->
  <section aria-labelledby="listado-solicitudes-title" class="space-y-4">
    <h2
      id="listado-solicitudes-title"
      class="text-lg font-semibold text-neutral-900"
    >
      Solicitudes recibidas
    </h2>

    <div
      class="rounded-2xl border border-dashed border-[#D8D3E8] bg-white p-8 text-center"
    >
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-[#EFEDFA] text-primary">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <circle cx="11" cy="11" r="7" />
          <path stroke-linecap="round" d="m16 16 4 4" />
        </svg>
      </div>

      <h3 class="font-semibold text-neutral-900">
        Aún no hay solicitudes para mostrar
      </h3>

      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-neutral-500">
        Cuando se conecte el servicio de solicitudes de Invitado,
        podrás consultar los registros y gestionar su aprobación o rechazo desde aquí.
      </p>
    </div>
  </section>
</section>
