---
import Card from '../ui/Card.astro';
---

<div class="space-y-5">
  <!-- Información general -->
  <Card class="border-t-4 border-t-[#4C4688]">
    <div class="mb-5">
      <h2 class="text-lg font-bold text-neutral-900">Información general</h2>
      <p class="mt-1 text-sm text-neutral-500">Datos principales del plan de intervención.</p>
    </div>

    <dl class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Organización</dt>
        <dd class="mt-2 break-words text-sm font-semibold">
          <a
            data-plan="organizacion"
            href="#"
            class="text-neutral-900 underline decoration-[#BDB7DA] underline-offset-2 transition hover:text-primary hover:decoration-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >—</a>
        </dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Programa institucional</dt>
        <dd class="mt-2 break-words text-sm font-semibold">
          <a
            data-plan="programa"
            href="#"
            class="text-neutral-900 underline decoration-[#BDB7DA] underline-offset-2 transition hover:text-primary hover:decoration-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >—</a>
        </dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Período anual</dt>
        <dd data-plan="periodo_anual" class="mt-2 text-sm font-semibold text-neutral-900">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Responsable</dt>
        <dd data-plan="responsable_nombre" class="mt-2 break-words text-sm font-semibold text-neutral-900">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Fecha de inicio</dt>
        <dd data-plan="fecha_inicio" class="mt-2 text-sm font-semibold text-neutral-900">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#F3F0FA] p-4">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-600">Fecha de término</dt>
        <dd data-plan="fecha_termino" class="mt-2 text-sm font-semibold text-neutral-900">—</dd>
      </div>
    </dl>
  </Card>

  <!-- Definición del plan -->
  <Card class="border-t-4 border-t-[#199D6B]">
    <div class="mb-5">
      <h2 class="text-lg font-bold text-neutral-900">Definición del plan</h2>
      <p class="mt-1 text-sm text-neutral-500">Propósito, objetivos y resultados esperados de la intervención.</p>
    </div>

    <dl class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="min-w-0 rounded-xl bg-[#E8F6EF] p-4 md:p-5">
        <dt class="text-xs font-semibold uppercase tracking-wide text-[#267451]">Situación o necesidad</dt>
        <dd data-plan="situacion_necesidad" class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#E8F6EF] p-4 md:p-5">
        <dt class="text-xs font-semibold uppercase tracking-wide text-[#267451]">Objetivo general</dt>
        <dd data-plan="objetivo_general" class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#E8F6EF] p-4 md:p-5">
        <dt class="text-xs font-semibold uppercase tracking-wide text-[#267451]">Objetivos específicos</dt>
        <dd data-plan="objetivos_especificos" class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800">—</dd>
      </div>

      <div class="min-w-0 rounded-xl bg-[#E8F6EF] p-4 md:p-5">
        <dt class="text-xs font-semibold uppercase tracking-wide text-[#267451]">Resultado esperado</dt>
        <dd data-plan="resultado_esperado" class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800">—</dd>
      </div>
    </dl>
  </Card>
</div>
