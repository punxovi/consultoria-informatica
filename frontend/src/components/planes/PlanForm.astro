---
import BackButton from '../ui/BackButton.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Input from '../ui/Input.astro';

interface Props { idPlan?: string }
const { idPlan = '' } = Astro.props;

const textos = [
  { id: 'situacion_necesidad', label: 'Situación o necesidad', max: 5000 },
  { id: 'objetivo_general', label: 'Objetivo general', max: 3000 },
  { id: 'objetivos_especificos', label: 'Objetivos específicos', max: 5000 },
  { id: 'resultado_esperado', label: 'Resultado esperado', max: 5000 },
];
---

<section class="w-full space-y-6">
  <div class="flex items-start gap-4">
    <BackButton class="mt-1 shrink-0" />
    <div>
      <p class="text-sm font-medium text-primary">Planes de Intervención</p>
      <h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">{idPlan ? 'Editar plan' : 'Crear plan'}</h1>
      <p class="mt-2 text-sm text-neutral-500">
        Registra el plan, su organización, programa, objetivos y período de ejecución.
      </p>
    </div>
  </div>

  <p id="plan-estado" role="status" aria-live="polite" class="text-sm text-neutral-700">
    Cargando organizaciones y programas…
  </p>
  <div id="plan-errores" role="alert" tabindex="-1" hidden class="rounded-lg border border-red-700 bg-red-50 p-4 text-red-800"></div>
  <div id="plan-reintentar" hidden><Button id="recargar-plan" variant="outline">Reintentar carga</Button></div>
  <a href="/planes" class="inline-flex min-h-[48px] items-center text-primary underline">Volver al listado de planes</a>

  <form id="plan-form" data-id-plan={idPlan} novalidate aria-busy="true">
    <fieldset id="plan-campos" disabled>
      <Card class="w-full md:p-6">
        <div class="space-y-8">
          <section class="space-y-5">
            <div>
              <h2 class="text-lg font-semibold text-neutral-900">Información del plan</h2>
              <p class="mt-1 text-sm text-neutral-500">Todos los campos son obligatorios.</p>
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <div class="space-y-1.5">
                <label for="id_organizacion" class="block text-sm font-medium text-neutral-800">Organización <span class="text-danger">*</span></label>
                <select id="id_organizacion" name="id_organizacion" required class="min-h-[48px] w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary">
                  <option value="">Selecciona una organización</option>
                </select>
              </div>
              <div class="space-y-1.5">
                <label for="id_programa" class="block text-sm font-medium text-neutral-800">Programa institucional <span class="text-danger">*</span></label>
                <select id="id_programa" name="id_programa" required class="min-h-[48px] w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary">
                  <option value="">Selecciona un programa</option>
                </select>
              </div>
              <div class="md:col-span-2">
                <Input id="nombre" label="Nombre del plan" required maxlength={150} />
              </div>
              <Input id="periodo_anual" label="Período anual (año)" type="number" required hint="Año al que corresponde el plan." />
              <Input id="responsable_nombre" label="Responsable" required maxlength={150} />
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <Input id="fecha_inicio" label="Fecha de inicio" type="date" required />
                <Input id="fecha_termino" label="Fecha de término" type="date" required />
              </div>
            </div>
          </section>

          <section class="grid grid-cols-1 gap-5 border-t border-neutral-100 pt-6 md:grid-cols-2">
            {textos.map(({ id, label, max }) => (
              <div class="space-y-1.5">
                <label for={id} class="block text-sm font-medium text-neutral-800">{label} <span class="text-danger">*</span></label>
                <textarea id={id} name={id} required maxlength={max} rows="5" class="w-full resize-y rounded-lg border border-neutral-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
              </div>
            ))}
          </section>

          <div class="flex flex-wrap justify-end gap-3 border-t border-neutral-100 pt-6">
            <Button href="/planes" variant="outline">Cancelar</Button>
            <Button id="guardar-plan" type="submit">Guardar plan</Button>
          </div>
        </div>
      </Card>
    </fieldset>
  </form>
</section>

<script>
  import { crearPlanSchema } from '../../lib/validaciones/planes';
  import { crearPlan, actualizarPlan, obtenerPlan, listarOrganizacionesParaPlan, listarProgramasParaPlan } from '../../lib/planes/cliente';
  import { ErrorSolicitudPlan } from '../../lib/planes/transporte';

  const form = document.querySelector<HTMLFormElement>('#plan-form')!;
  const campos = document.querySelector<HTMLFieldSetElement>('#plan-campos')!;
  const estado = document.querySelector<HTMLElement>('#plan-estado')!;
  const errores = document.querySelector<HTMLElement>('#plan-errores')!;
  const guardar = document.querySelector<HTMLButtonElement>('#guardar-plan')!;
  const selectOrganizacion = document.querySelector<HTMLSelectElement>('#id_organizacion')!;
  const selectPrograma = document.querySelector<HTMLSelectElement>('#id_programa')!;
  const idPlan = form.dataset.idPlan ?? '';
  let version: number | undefined;
  let enviando = false;
  const reintentar = document.querySelector<HTMLElement>('#plan-reintentar')!;

  function limpiarValidacion() {
    errores.hidden = true;
    form.querySelectorAll('[data-error-campo]').forEach(elemento => elemento.remove());
    form.querySelectorAll('[aria-invalid="true"]').forEach(elemento => {
      elemento.setAttribute('aria-invalid', 'false');
      elemento.removeAttribute('aria-describedby');
    });
  }

  function marcarCampos(detalles: { campo: string; mensaje: string }[]) {
    for (const { campo, mensaje } of detalles) {
      const control = form.elements.namedItem(campo.replace(/^cambios\./, ''));
      if (!(control instanceof HTMLElement) || control.getAttribute('aria-invalid') === 'true') continue;
      const aviso = document.createElement('p');
      aviso.id = `${control.id}-validacion`;
      aviso.dataset.errorCampo = '';
      aviso.className = 'mt-1 text-sm text-red-800';
      aviso.textContent = mensaje;
      control.setAttribute('aria-invalid', 'true');
      control.setAttribute('aria-describedby', aviso.id);
      control.after(aviso);
    }
  }

  function mostrarError(mensaje: string, detalles: string[] = []) {
    errores.replaceChildren();
    const titulo = document.createElement('p');
    titulo.className = 'font-semibold';
    titulo.textContent = mensaje;
    errores.append(titulo);
    if (detalles.length) {
      const lista = document.createElement('ul');
      lista.className = 'mt-2 list-disc space-y-1 pl-5';
      for (const detalle of detalles) {
        const item = document.createElement('li');
        item.textContent = detalle;
        lista.append(item);
      }
      errores.append(lista);
    }
    errores.hidden = false;
    errores.focus();
  }

  async function cargarCatalogos() {
    reintentar.hidden = true;
    limpiarValidacion();
    campos.disabled = true;
    form.setAttribute('aria-busy', 'true');
    estado.textContent = idPlan ? 'Cargando plan, organizaciones y programas…' : 'Cargando organizaciones y programas…';
    try {
      const [organizaciones, programas, plan] = await Promise.all([
        listarOrganizacionesParaPlan(),
        listarProgramasParaPlan(),
        idPlan ? obtenerPlan(idPlan) : Promise.resolve(null),
      ]);
      selectOrganizacion.length = 1;
      selectPrograma.length = 1;
      for (const organizacion of organizaciones) {
        selectOrganizacion.add(new Option(organizacion.nombre, organizacion.id_organizacion));
      }
      for (const programa of programas) {
        selectPrograma.add(new Option(programa.nombre, programa.id_programa));
      }
      if (plan) {
        version = plan.version;
        // Conserva el vínculo histórico si el catálogo ya no incluye esta entidad.
        if (!organizaciones.some(item => item.id_organizacion === plan.id_organizacion)) {
          selectOrganizacion.add(new Option(`${plan.organizacion.nombre} (actual, no disponible)`, plan.id_organizacion));
        }
        if (!programas.some(item => item.id_programa === plan.id_programa)) {
          selectPrograma.add(new Option(`${plan.programa.nombre} (actual, no disponible)`, plan.id_programa));
        }
        for (const [campo, valor] of Object.entries(plan)) {
          const control = form.elements.namedItem(campo);
          if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement) {
            control.value = String(valor ?? '');
          }
        }
      }
      campos.disabled = false;
      form.setAttribute('aria-busy', 'false');
      estado.textContent = (plan || (organizaciones.length && programas.length))
        ? 'Formulario listo.'
        : 'Necesitas al menos una organización y un programa registrados para crear el plan.';
      guardar.disabled = !plan && (!organizaciones.length || !programas.length);
    } catch (error) {
      estado.textContent = '';
      mostrarError(error instanceof Error ? error.message : 'No fue posible preparar el formulario.');
      reintentar.hidden = false;
    } finally {
      form.setAttribute('aria-busy', 'false');
    }
  }

  form.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (enviando || campos.disabled || guardar.disabled) return;
    limpiarValidacion();
    const datos = Object.fromEntries(new FormData(form).entries());
    const validacion = crearPlanSchema.safeParse({ ...datos, periodo_anual: Number(datos.periodo_anual) });
    if (!validacion.success) {
      marcarCampos(validacion.error.issues.map(issue => ({ campo: issue.path.join('.'), mensaje: issue.message })));
      mostrarError('Revisa los campos indicados antes de guardar.', validacion.error.issues.map(issue => issue.message));
      return;
    }

    enviando = true;
    campos.disabled = true;
    form.setAttribute('aria-busy', 'true');
    estado.textContent = 'Guardando plan…';
    try {
      if (idPlan) {
        if (version === undefined) throw new Error('Recarga el plan antes de editarlo.');
        await actualizarPlan({ id_plan: idPlan, version_esperada: version, cambios: validacion.data });
      } else {
        await crearPlan(validacion.data);
      }
      window.location.assign('/planes?resultado=guardado');
    } catch (error) {
      const detalles = error instanceof ErrorSolicitudPlan
        ? error.campos.map(campo => campo.mensaje)
        : [];
      if (error instanceof ErrorSolicitudPlan) marcarCampos(error.campos);
      mostrarError(error instanceof Error ? error.message : 'No fue posible guardar el plan.', detalles);
      campos.disabled = false;
      form.setAttribute('aria-busy', 'false');
      estado.textContent = '';
      enviando = false;
      if (error instanceof ErrorSolicitudPlan && error.codigo === 'CONFLICTO_CONCURRENCIA') {
        reintentar.hidden = false;
        estado.textContent = 'Tus cambios siguen en el formulario. Al recargar se reemplazarán por la versión guardada.';
        guardar.disabled = true;
      }
    }
  });

  document.querySelector('#recargar-plan')!.addEventListener('click', () => void cargarCatalogos());
  void cargarCatalogos();
</script>
