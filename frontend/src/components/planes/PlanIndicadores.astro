---
import Card from '../ui/Card.astro';
---

<section aria-label="Resumen del plan" class="grid grid-cols-1 gap-4 md:grid-cols-3">
  <!-- Acciones registradas -->
  <Card class="border-t-4 border-t-[#4C4688]">
    <div class="flex min-w-0 items-center gap-4">
      <div class="shrink-0 rounded-xl bg-primary/10 p-3 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 4h8l4 4v12H4V4h4Zm7 0v5h5M8 13h8m-8 4h8" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Acciones registradas</p>
        <p id="plan-acciones-total" class="mt-1 text-2xl font-bold text-neutral-900">—</p>
      </div>
    </div>
  </Card>

  <!-- Responsable -->
  <Card class="border-t-4 border-t-[#199D6B]">
    <div class="flex min-w-0 items-center gap-4">
      <div class="shrink-0 rounded-xl bg-brand-green/10 p-3 text-brand-green">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m8-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Responsable</p>
        <p data-plan="responsable_nombre" class="mt-1 break-words text-lg font-bold text-neutral-900">—</p>
      </div>
    </div>
  </Card>

  <!-- Fecha de término -->
  <Card class="border-t-4 border-t-[#1BAAC1]">
    <div class="flex min-w-0 items-center gap-4">
      <div class="shrink-0 rounded-xl bg-brand-cyan/10 p-3 text-brand-cyan">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 3v4M8 3v4M3 11h18" />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Fecha de término</p>
        <p data-plan="fecha_termino" class="mt-1 break-words text-lg font-bold text-neutral-900">—</p>
      </div>
    </div>
  </Card>
</section>
