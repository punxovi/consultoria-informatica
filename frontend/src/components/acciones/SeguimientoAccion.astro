---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
---

<template id="plantilla-seguimiento-accion">
  <Card class="space-y-4">
    <div>
      <p
        data-plan
        class="text-xs font-medium text-neutral-500"
      ></p>

      <h2
        data-nombre
        class="mt-2 break-words text-lg font-semibold text-neutral-900"
      ></h2>

      <p
        data-descripcion
        class="mt-2 text-sm leading-6 text-neutral-600"
      ></p>
    </div>

    <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-neutral-500">Responsable</dt>

        <dd
          data-responsable
          class="mt-1 break-words font-medium text-neutral-800"
        ></dd>
      </div>

      <div>
        <dt class="text-neutral-500">Fecha de término</dt>

        <dd
          data-termino
          class="mt-1 font-medium text-neutral-800"
        ></dd>
      </div>
    </dl>

    <div
      class="grid grid-cols-1 gap-4 border-t border-neutral-100 pt-4 sm:grid-cols-2"
    >
      <div class="space-y-2">
        <p class="text-xs font-medium text-neutral-500">
          Estado operativo
        </p>

        <span data-estado-badge>
          <Badge variant="info">
            <span data-estado-etiqueta>Estado</span>
          </Badge>
        </span>
      </div>

      <div class="space-y-2">
        <p class="text-xs font-medium text-neutral-500">
          Nivel de urgencia
        </p>

        <span data-urgencia-badge>
          <Badge variant="neutral">
            <span data-urgencia-etiqueta>
              Sin calcular
            </span>
          </Badge>
        </span>
      </div>
    </div>

    <div class="pt-1">
      <Button
        href="#"
        variant="outline"
        size="md"
        class="w-full sm:w-auto"
      >
        Ver acción
      </Button>
    </div>
  </Card>
</template>