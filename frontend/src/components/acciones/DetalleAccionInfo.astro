---
import Card from '../ui/Card.astro';
---

<Card class="p-5 md:p-6">
  <header class="mb-5">
    <h2 class="text-lg font-bold text-neutral-900">Información general</h2>
    <p class="mt-1 text-sm text-neutral-500">Datos principales y planificación de la acción.</p>
  </header>

  <dl class="grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-2 xl:grid-cols-3">
    <!-- Responsable -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-brand-pink/10 p-2.5 text-brand-pink" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2m8-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        </svg>
      </span>
      <div class="min-w-0">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Responsable</dt>
        <dd data-accion="responsable_nombre" class="mt-1 break-words text-sm font-semibold text-neutral-900"></dd>
      </div>
    </div>

    <!-- Plan asociado -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-brand-green/10 p-2.5 text-brand-green" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16M8 7h2m4 0h2M8 11h2m4 0h2M9 21v-5h6v5" />
        </svg>
      </span>
      <div class="min-w-0">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Plan de intervención</dt>
        <dd data-accion="plan-detalle" class="mt-1 break-words text-sm font-semibold text-neutral-900"></dd>
      </div>
    </div>

    <!-- Fechas agrupadas en un solo bloque para reducir el espacio vertical -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-brand-cyan/10 p-2.5 text-brand-cyan" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 3v4M8 3v4M3 11h18" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Fechas</dt>
        <dd class="mt-2">
          <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="min-w-0">
              <dt class="text-xs text-neutral-500">Inicio</dt>
              <dd data-accion="fecha_inicio" class="mt-1 break-words text-sm font-semibold text-neutral-900"></dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs text-neutral-500">Término</dt>
              <dd data-accion="fecha_termino" class="mt-1 break-words text-sm font-semibold text-neutral-900"></dd>
            </div>
          </dl>
        </dd>
      </div>
    </div>

    <!-- Descripción -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-primary/10 p-2.5 text-primary" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H5V3h2Zm7 0v5h5M8 13h8m-8 4h8" />
        </svg>
      </span>
      <div class="min-w-0">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Descripción</dt>
        <dd data-accion="descripcion" class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800"></dd>
      </div>
    </div>

    <!-- Observaciones o motivo de cancelación -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-[#FCE8F0] p-2.5 text-[#AD174F]" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 3.9a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" />
        </svg>
      </span>
      <div class="min-w-0">
        <dt id="motivo-titulo" class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Observaciones</dt>
        <dd data-accion="observacion_motivo" class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800"></dd>
      </div>
    </div>

    <!-- Resultado esperado: ahora ocupa la sexta posición de la cuadrícula -->
    <div class="flex min-w-0 items-start gap-3">
      <span class="shrink-0 rounded-xl bg-[#F0EEF9] p-2.5 text-primary" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="9" />
          <circle cx="12" cy="12" r="5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="m12 12 7-7m-4 0h4v4" />
        </svg>
      </span>
      <div class="min-w-0">
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Resultado esperado</dt>
        <dd data-accion="resultado_esperado" class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-800"></dd>
      </div>
    </div>
  </dl>
</Card>
