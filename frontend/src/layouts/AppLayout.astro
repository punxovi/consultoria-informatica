
---
// frontend/src/layouts/AppLayout.astro
import Layout from './Layout.astro';
import Header from '../components/ui/Header.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import type { NavItem } from '../config/nav';

interface Props {
  title?: string;
  navItems: NavItem[];
  allowedRoles?: string[];
}

const { title, navItems, allowedRoles = [] } = Astro.props;
const hasBreadcrumb = Astro.slots.has('breadcrumb');
const hasHeaderBreadcrumb = Astro.slots.has('headerBreadcrumb');
---

<Layout title={title}>
  <div class="flex h-screen overflow-hidden bg-[#F7F6FA]">
    <!-- Menú lateral de altura completa -->
    <Sidebar items={navItems} />

    <!-- Columna principal: encabezado y contenido -->
    <div class="flex min-w-0 flex-1 flex-col md:ml-64">
      <Header
        title={title ?? 'Fundación Gestionar Esperanzas'}
        showBreadcrumb={hasHeaderBreadcrumb}
      >
        <slot name="actions" slot="actions" />

        {
          hasHeaderBreadcrumb && (
            <Fragment slot="breadcrumb">
              <slot name="headerBreadcrumb" />
            </Fragment>
          )
        }
      </Header>

      <main
        id="main-content"
        class="min-w-0 flex-1 overflow-y-auto box-border
          bg-[#F7F6FA] p-4 opacity-0 transition-opacity duration-300
          md:p-8"
      >
        <div id="page-content">
          {hasBreadcrumb && (
            <div class="mb-4 flex items-center gap-1.5
              text-xs text-neutral-500 md:text-sm">
              <slot name="breadcrumb" />
            </div>
          )}

          <slot />
        </div>

        <!-- Mensaje de acceso denegado -->
        <div
          id="unauthorized-message"
          class="hidden h-full flex-col items-center
            justify-center text-center"
        >
          <div class="mb-4 rounded-xl bg-danger/10 p-4 text-danger">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mx-auto h-10 w-10"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              />
            </svg>
          </div>

          <h2 class="mb-2 text-xl font-bold text-neutral-900">
            Acceso no autorizado
          </h2>

          <p class="max-w-sm text-sm text-neutral-500">
            No tienes los permisos necesarios para visualizar esta sección.
            Si crees que esto es un error, contacta al administrador.
          </p>
        </div>
      </main>

      <!-- Roles permitidos para la página actual -->
      <div
        id="auth-config"
        data-allowed-roles={JSON.stringify(allowedRoles)}
        class="hidden"
        aria-hidden="true"
      ></div>
    </div>
  </div>
</Layout>

<script>
  import { verificarSesion } from '../lib/auth/cliente';
  import { getUserRoles } from '../lib/supabase';

  async function validateSession() {
    const hasSession = await verificarSesion();

    if (!hasSession) {
      window.location.replace('/login');
      return;
    }

    const configEl = document.getElementById('auth-config');
    let allowedRoles: string[] = [];

    if (configEl?.dataset.allowedRoles) {
      try {
        allowedRoles = JSON.parse(configEl.dataset.allowedRoles);
      } catch (error) {
        console.error('Error parseando roles permitidos', error);
      }
    }

    const mainContent = document.getElementById('main-content');
    const pageContent = document.getElementById('page-content');
    const unauthorizedMsg = document.getElementById('unauthorized-message');

    if (allowedRoles.length > 0) {
      try {
        const roles = await getUserRoles();
        const userHasRole = roles.some((role) =>
          allowedRoles.includes(role.codigo)
        );

        if (!userHasRole) {
          pageContent?.classList.add('hidden');
          unauthorizedMsg?.classList.remove('hidden');
          unauthorizedMsg?.classList.add('flex');
        }
      } catch (error) {
        console.error('Error validando roles:', error);
        pageContent?.classList.add('hidden');
        unauthorizedMsg?.classList.remove('hidden');
        unauthorizedMsg?.classList.add('flex');
      }
    }

    mainContent?.classList.remove('opacity-0');
  }

  validateSession();

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      validateSession();
    }
  });
</script>
<script>
  import { iniciarCapitalizacionCampos } from '../lib/capitalizacion-campos';

  iniciarCapitalizacionCampos();
</script>