---
import AppLayout from '../../layouts/AppLayout.astro';
import { mainNavItems } from '../../config/nav';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import BackButton from '../../components/ui/BackButton.astro';
import { obtenerProgramaPorIdSchema } from '../../lib/validaciones/programas';

const { id } = Astro.params;
const idValido = obtenerProgramaPorIdSchema.safeParse({ id_programa: id }).success;
if (!idValido) Astro.response.status = 404;
const secciones = [ 
  ['objetivo_general', 'Objetivo general'], 
  ['objetivos_especificos', 'Objetivos específicos'], 
  ['descripcion', 'Descripción / contexto'], 
  ['referencias_ods', 'Referencias ODS'], 
  ['referencias_esg', 'Referencias ESG'] 
];
---

<AppLayout title="Detalle de programa" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="breadcrumb">
    <div class="flex items-center gap-4">
      <BackButton href="/programas" />

      <div class="flex min-w-0 items-center gap-2 text-sm">
        <a href="/programas" class="text-neutral-500 transition-colors hover:text-primary" >Programas Institucionales </a>
        <span class="text-neutral-400">&rsaquo;</span>
        <span id="programa-breadcrumb" class="truncate font-medium text-neutral-900">Detalle</span>
      </div>
    </div>
  </Fragment>
  <section id="programa-detalle" data-id={id} class="mx-auto max-w-5xl space-y-6">
    <div id="programa-recuperacion" hidden class="flex flex-wrap gap-3">
      <Button id="recargar-programa" variant="outline">Reintentar</Button>
      <a href="/login" class="inline-flex items-center text-primary underline">Iniciar sesión</a>
    </div>
    <p id="detalle-estado" role="status">Cargando programa…</p>
    <p id="programa-confirmacion" role="status" hidden class="rounded-lg bg-green-50 p-4 text-green-800"></p>
    <p id="detalle-error" role="alert" hidden class="rounded-lg bg-red-50 p-4 text-red-800"></p>
    
    <div id="detalle-contenido" hidden class="space-y-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <h1 id="detalle-nombre" class="text-2xl font-bold md:text-3xl"></h1>
        <div id="editar-programa-enlace" hidden><Button href={`/programas/${id}/editar`}>Editar programa</Button></div>
      </div>
      <img id="detalle-imagen" hidden alt="Imagen representativa del programa" class="max-h-80 max-w-full rounded-xl object-contain" />
      <p id="detalle-imagen-estado" role="status" aria-live="polite"></p>
      <div id="detalle-imagen-recuperacion" hidden class="space-y-3">
        <p id="detalle-imagen-error" role="alert" class="rounded-lg bg-red-50 p-4 text-red-800"></p>
        <Button id="reintentar-imagen" variant="outline">Reintentar imagen</Button>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {secciones.map(([campo, titulo]) => (
          <Card>
            <h2 class="text-lg font-semibold">{titulo}</h2>
            <p data-campo={campo} class="mt-3 whitespace-pre-line break-words text-neutral-700"></p>
          </Card>
        ))}
      </div>
      
      <Card>
        <h2 class="text-lg font-semibold">Líneas de acción y resultados esperados</h2>
        <dl id="detalle-lineas" class="mt-4 space-y-4"></dl>
        <p id="detalle-sin-lineas" hidden class="mt-4 text-sm text-neutral-700">Este programa no cuenta con líneas de acción estructuradas. Su información se mantiene como texto general.</p>
        <div id="detalle-legado" hidden class="mt-4 rounded-lg bg-neutral-50 p-4 text-sm">
          <h3 class="font-semibold">Componentes registrados</h3>
          <p id="detalle-componentes" class="whitespace-pre-wrap"></p>
          <h3 class="mt-3 font-semibold">Resultados registrados</h3>
          <p id="detalle-resultados" class="whitespace-pre-wrap"></p>
        </div>
      </Card>

      <div id="eliminar-programa-panel" hidden>
        <Card>
          <h2 class="text-lg font-semibold">Eliminar programa</h2>
          <p class="my-3 text-neutral-700">Se quitará del catálogo activo. Sus planes, líneas de acción y archivos se conservarán como historial.</p>
          <Button id="eliminar-programa" variant="outline" class="!border-red-800 !text-red-800">Eliminar programa</Button>
          <p id="eliminar-estado" role="status" aria-live="polite" class="mt-3 text-neutral-700"></p>
        </Card>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  import { obtenerPrograma, archivarPrograma } from '../../lib/programas/cliente';
  import { obtenerImagen } from '../../lib/programas/imagen';
  import { getUserRoles } from '../../lib/supabase';
  import { ErrorSolicitudPrograma } from '../../lib/programas/transporte';
  import { obtenerProgramaPorIdSchema } from '../../lib/validaciones/programas';

  const recargar = document.querySelector<HTMLButtonElement>('#recargar-programa')!;
  const raiz = document.querySelector<HTMLElement>('#programa-detalle')!;
  const contenido = document.querySelector<HTMLElement>('#detalle-contenido')!;
  const imagen = document.querySelector<HTMLImageElement>('#detalle-imagen')!;
  const imagenEstado = document.querySelector<HTMLElement>('#detalle-imagen-estado')!;
  const imagenError = document.querySelector<HTMLElement>('#detalle-imagen-error')!;
  const imagenRecuperacion = document.querySelector<HTMLElement>('#detalle-imagen-recuperacion')!;
  const reintentarImagen = document.querySelector<HTMLButtonElement>('#reintentar-imagen')!;
  let cargando = false;
  let secuenciaImagen = 0;

  function mostrarErrorImagen(mensaje: string) {
    imagen.hidden = true;
    imagenEstado.textContent = '';
    imagenError.textContent = mensaje;
    imagenRecuperacion.hidden = false;
  }

  async function cargarImagen() {
    const solicitud = ++secuenciaImagen;
    reintentarImagen.disabled = true;
    imagenRecuperacion.hidden = true;
    imagen.hidden = true;
    imagen.removeAttribute('src');
    imagenEstado.textContent = 'Cargando imagen…';
    try {
      const url = await obtenerImagen(raiz.dataset.id!);
      if (solicitud !== secuenciaImagen) return;
      if (!url) { imagenEstado.textContent = ''; return; }
      imagen.onload = () => { if (solicitud === secuenciaImagen) imagenEstado.textContent = ''; };
      imagen.onerror = () => {
        if (solicitud === secuenciaImagen) mostrarErrorImagen('No se pudo cargar la imagen actual. Vuelve a intentarlo.');
      };
      imagen.src = url;
      imagen.hidden = false;
    } catch (fallo) {
      if (solicitud === secuenciaImagen) {
        mostrarErrorImagen(fallo instanceof Error ? fallo.message : 'No se pudo cargar la imagen actual.');
      }
    } finally {
      if (solicitud === secuenciaImagen) reintentarImagen.disabled = false;
    }
  }
  reintentarImagen.addEventListener('click', () => void cargarImagen());

  async function cargar() {
    if (cargando) return;
    cargando = true; recargar.disabled = true;
    
    const estado = document.querySelector<HTMLElement>('#detalle-estado')!;
    const error = document.querySelector<HTMLElement>('#detalle-error')!;
    const recuperacion = document.querySelector<HTMLElement>('#programa-recuperacion')!;
    
    estado.textContent = 'Cargando programa…';
    error.hidden = true;
    recuperacion.hidden = true;
    raiz.setAttribute('aria-busy', 'true');
    contenido.hidden = true;
    document.querySelector<HTMLElement>('#editar-programa-enlace')!.hidden = true;
    document.querySelector<HTMLElement>('#eliminar-programa-panel')!.hidden = true;
    document.querySelector<HTMLElement>('#programa-confirmacion')!.hidden = true;
    ++secuenciaImagen;
    imagen.hidden = true;
    imagen.removeAttribute('src');
    imagenRecuperacion.hidden = true;

    try {
      if (!obtenerProgramaPorIdSchema.safeParse({ id_programa: raiz.dataset.id }).success) {
        throw new ErrorSolicitudPrograma('NO_ENCONTRADO', 'Programa no encontrado.');
      }
      const programa = await obtenerPrograma(raiz.dataset.id!);
      
      document.querySelector('#detalle-nombre')!.textContent = programa.nombre;
      document.querySelector('#programa-breadcrumb')!.textContent = programa.nombre;
      
      raiz.querySelectorAll<HTMLElement>('[data-campo]').forEach(el => { 
        el.textContent = String(programa[el.dataset.campo as keyof typeof programa] || 'Sin referencias registradas.');
      });

      document.querySelector('#detalle-componentes')!.textContent = programa.componentes_linea_accion || '';
      document.querySelector('#detalle-resultados')!.textContent = programa.resultados_esperados || '';
      
      const lineas = document.querySelector('#detalle-lineas')!;
      lineas.replaceChildren();
      programa.lineas_accion.forEach(linea => {
        const grupo = document.createElement('div'); grupo.className = 'rounded-lg bg-neutral-50 p-4';
        const titulo = document.createElement('dt'); titulo.className = 'font-medium'; titulo.textContent = linea.linea_accion;
        const resultado = document.createElement('dd'); resultado.className = 'mt-2 whitespace-pre-line break-words text-neutral-700'; resultado.textContent = linea.resultado_esperado;
        grupo.append(titulo, resultado); lineas.append(grupo);
      });
      
      const tieneLineas = programa.lineas_accion.length > 0;
      document.querySelector<HTMLElement>('#detalle-sin-lineas')!.hidden = tieneLineas;
      document.querySelector<HTMLElement>('#detalle-legado')!.hidden = tieneLineas;

      const confirmacion = document.querySelector<HTMLElement>('#programa-confirmacion')!;
      if (new URLSearchParams(window.location.search).get('resultado') === 'guardado') {
        confirmacion.textContent = 'Programa guardado correctamente.';
        confirmacion.hidden = false;
        history.replaceState(null, '', `/programas/${programa.id_programa}`);
      }

      contenido.hidden = false;
      document.title = `${programa.nombre} | Programas`;
      estado.textContent = '';
      
      const roles = await getUserRoles();
      if (roles.some(rol => rol.codigo === 'ADMIN')) {
        document.querySelector<HTMLElement>('#editar-programa-enlace')!.hidden = false;
        document.querySelector<HTMLElement>('#eliminar-programa-panel')!.hidden = false;
        const boton = document.querySelector<HTMLButtonElement>('#eliminar-programa')!;
        const mensaje = document.querySelector<HTMLElement>('#eliminar-estado')!;
        boton.disabled = false;
        mensaje.textContent = '';
        boton.onclick = async () => {
          if (boton.disabled || !confirm(`¿Eliminar «${programa.nombre}» del catálogo activo? Sus planes y archivos se conservarán.`)) return;
          boton.disabled = true;
          mensaje.textContent = 'Eliminando programa…';
          try {
            await archivarPrograma(programa.id_programa, programa.version);
            document.querySelector<HTMLElement>('#editar-programa-enlace')!.hidden = true;
            mensaje.textContent = 'Programa eliminado del catálogo. Su historial se conserva. Puedes volver al listado de programas.';
            boton.textContent = 'Programa eliminado';
            window.location.replace('/programas?resultado=eliminado');
          } catch (error) {
            mensaje.textContent = error instanceof Error ? error.message : 'No se pudo eliminar el programa.';
            boton.disabled = false;
          }
        };
      }
      void cargarImagen();
    } catch (fallo) { 
      const inexistente = fallo instanceof ErrorSolicitudPrograma && fallo.codigo === 'NO_ENCONTRADO';
      estado.textContent = inexistente ? 'Programa no encontrado' : 'No fue posible cargar el programa';
      error.textContent = fallo instanceof Error ? fallo.message : 'Vuelve a intentarlo.';
      error.hidden = false; recuperacion.hidden = inexistente;
      contenido.hidden = true;
      document.title = estado.textContent;
    } finally {
      cargando = false; recargar.disabled = false;
      raiz.setAttribute('aria-busy', 'false');
    }
  }

  recargar.addEventListener('click', cargar);
  window.addEventListener('pageshow', evento => { if (evento.persisted) void cargar(); });
  void cargar();
</script>
