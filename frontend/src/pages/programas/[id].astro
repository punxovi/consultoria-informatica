---
import AppLayout from '../../layouts/AppLayout.astro';
import { mainNavItems } from '../../config/nav';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { obtenerProgramaPorIdSchema } from '../../actions/programas/programas.schema';
const id = Astro.params.id ?? '';
const idValido = obtenerProgramaPorIdSchema.safeParse({ id_programa: id }).success;
if (!idValido) Astro.response.status = 404;
---

<AppLayout title="Detalle del programa" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="breadcrumb">
    <a href="/programas" class="hover:text-primary">Programas Institucionales</a>
    <span>&rsaquo;</span><span id="programa-breadcrumb">Detalle del programa</span>
  </Fragment>
  <section id="programa-detalle" data-id={id} data-id-valido={String(idValido)} aria-busy={idValido ? 'true' : 'false'} class="space-y-6">
    <div id="detalle-estado-panel" class="rounded-xl border border-neutral-200 bg-white p-6">
      <h1 id="detalle-estado" role="status" aria-live="polite" class="text-xl font-semibold">{idValido ? 'Cargando programa…' : 'Programa no encontrado'}</h1>
      <p id="detalle-error" role="alert" hidden class="mt-3 text-red-800"></p>
      <div id="detalle-reintentar" hidden class="mt-4"><Button id="recargar-programa" variant="outline">Reintentar</Button></div>
    </div>
    <p id="programa-confirmacion" role="status" hidden class="rounded-lg bg-green-50 p-4 text-green-800">Programa guardado correctamente.</p>
    <div id="detalle-contenido" hidden class="space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-primary">Programa institucional</p>
          <h1 id="detalle-nombre" class="mt-1 break-words text-2xl font-bold md:text-3xl"></h1>
        </div>
        <div id="editar-programa-panel" hidden><Button href={`/programas/${id}/editar`}>Editar programa</Button></div>
      </div>
      <div class="grid gap-5 lg:grid-cols-2">
        <Card><h2 class="text-lg font-semibold">Objetivo general</h2><p id="detalle-objetivo" class="mt-3 whitespace-pre-wrap break-words text-neutral-600"></p></Card>
        <Card><h2 class="text-lg font-semibold">Objetivos específicos</h2><p id="detalle-objetivos" class="mt-3 whitespace-pre-wrap break-words text-neutral-600"></p></Card>
      </div>
      <Card><h2 class="text-lg font-semibold">Descripción y contexto</h2><p id="detalle-descripcion" class="mt-3 whitespace-pre-wrap break-words text-neutral-600"></p></Card>
      <Card>
        <h2 class="text-lg font-semibold">Líneas de acción y resultados esperados</h2>
        <dl id="detalle-lineas" class="mt-4 grid gap-4 md:grid-cols-2"></dl>
        <p id="detalle-sin-lineas" hidden class="mt-3 text-neutral-600">Este programa aún no tiene líneas de acción con resultados individuales registrados.</p>
      </Card>
      <div id="detalle-legado" hidden class="grid gap-5 lg:grid-cols-2">
        <Card><h2 class="text-lg font-semibold">Componentes registrados</h2><p id="detalle-componentes" class="mt-3 whitespace-pre-wrap break-words text-neutral-600"></p></Card>
        <Card><h2 class="text-lg font-semibold">Resultados esperados generales</h2><p id="detalle-resultados" class="mt-3 whitespace-pre-wrap break-words text-neutral-600"></p></Card>
      </div>
    </div>
    <Button variant="ghost" href="/programas">← Volver a programas</Button>
  </section>
</AppLayout>

<template id="plantilla-detalle-linea">
  <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4">
    <dt class="whitespace-pre-wrap break-words font-semibold"></dt>
    <dd class="mt-2 whitespace-pre-wrap break-words text-sm text-neutral-600"></dd>
  </div>
</template>

<script>
  import { obtenerPrograma } from '../../lib/programas/cliente';
  import { ErrorSolicitudPrograma } from '../../lib/programas/transporte';
  import { getUserRoles } from '../../lib/supabase';
  const detalle = document.querySelector<HTMLElement>('#programa-detalle')!;
  const panel = document.querySelector<HTMLElement>('#detalle-estado-panel')!;
  const estado = document.querySelector<HTMLElement>('#detalle-estado')!;
  const error = document.querySelector<HTMLElement>('#detalle-error')!;
  const contenido = document.querySelector<HTMLElement>('#detalle-contenido')!;
  const reintentar = document.querySelector<HTMLElement>('#detalle-reintentar')!;
  let cargando = false;
  async function cargar() {
    if (cargando || detalle.dataset.idValido !== 'true') return;
    cargando = true; detalle.setAttribute('aria-busy', 'true');
    panel.hidden = false; contenido.hidden = true; error.hidden = true; reintentar.hidden = true;
    document.querySelector<HTMLElement>('#programa-confirmacion')!.hidden = true;
    estado.textContent = 'Cargando programa…';
    try {
      const programa = await obtenerPrograma(detalle.dataset.id!);
      for (const [selector, valor] of Object.entries({
        '#detalle-nombre': programa.nombre, '#programa-breadcrumb': programa.nombre,
        '#detalle-objetivo': programa.objetivo_general, '#detalle-objetivos': programa.objetivos_especificos,
        '#detalle-descripcion': programa.descripcion, '#detalle-componentes': programa.componentes_linea_accion,
        '#detalle-resultados': programa.resultados_esperados,
      })) document.querySelector(selector)!.textContent = valor;
      const lineas = document.querySelector('#detalle-lineas')!;
      lineas.replaceChildren();
      const plantilla = document.querySelector<HTMLTemplateElement>('#plantilla-detalle-linea')!;
      for (const linea of programa.lineas_accion) {
        const fila = plantilla.content.cloneNode(true) as DocumentFragment;
        fila.querySelector('dt')!.textContent = linea.linea_accion;
        fila.querySelector('dd')!.textContent = linea.resultado_esperado;
        lineas.append(fila);
      }
      const tieneLineas = programa.lineas_accion.length > 0;
      document.querySelector<HTMLElement>('#detalle-sin-lineas')!.hidden = tieneLineas;
      document.querySelector<HTMLElement>('#detalle-legado')!.hidden = tieneLineas;
      document.querySelector<HTMLElement>('#programa-confirmacion')!.hidden = new URLSearchParams(location.search).get('resultado') !== 'guardado';
      document.title = `${programa.nombre} | Programas`;
      panel.hidden = true; contenido.hidden = false;
    } catch (fallo) {
      const inexistente = fallo instanceof ErrorSolicitudPrograma && fallo.codigo === 'NO_ENCONTRADO';
      estado.textContent = inexistente ? 'Programa no encontrado' : 'No fue posible cargar el programa';
      error.textContent = fallo instanceof Error ? fallo.message : 'Vuelve a intentarlo.';
      error.hidden = false; reintentar.hidden = inexistente;
      document.title = estado.textContent;
    } finally { cargando = false; detalle.setAttribute('aria-busy', 'false'); }
  }
  document.querySelector('#recargar-programa')!.addEventListener('click', cargar);
  window.addEventListener('pageshow', evento => { if (evento.persisted) void cargar(); });
  void cargar();
  void getUserRoles().then(roles => {
    document.querySelector<HTMLElement>('#editar-programa-panel')!.hidden = !roles.some(rol => rol.codigo === 'ADMIN');
  }).catch(() => {});
</script>
