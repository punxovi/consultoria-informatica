---
// frontend/src/pages/organizaciones/nueva.astro
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import Button from '../../components/ui/Button.astro';
import { mainNavItems } from '../../config/nav';

// NOTA: Países provisionales a la espera de conectar consulta real con Supabase (getPaises).
const paisesPlaceholder = [
  { value: 'cl', label: 'Chile' },
  { value: 'ar', label: 'Argentina' },
  { value: 'uy', label: 'Uruguay' },
];

const tiposOrganizacion = [
  { value: 'comedor_merendero', label: 'Comedor solidario / Merendero' },
  { value: 'centro_comunitario', label: 'Centro comunitario' },
  { value: 'emprendimiento_uv', label: 'Emprendimiento UV+' },
  { value: 'otra', label: 'Otra' },
];
---

<AppLayout title="Nueva Organización" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="breadcrumb">
    <a href="/organizaciones" class="hover:text-primary">Organizaciones</a>
    <span>&rsaquo;</span>
    <span class="text-neutral-900 font-medium">Nueva Organización</span>
  </Fragment>

  <div class="max-w-3xl">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-neutral-900">Nueva Organización</h1>
      <p class="text-sm text-neutral-500 mt-1">
        Registra una nueva Organización acompañada por FGE (RF22).
      </p>
    </div>

    <Card>
      <!-- NOTA: Interfaz pendiente de vincular con backend (KAN-137) al integrar países reales. -->
      <form id="form-nueva-organizacion" class="flex flex-col gap-5">
        <Input
          id="nombre"
          name="nombre"
          label="Nombre de la Organización"
          placeholder="Ej: Comedor Los Aromos"
          required
          maxlength={150}
        />

        <Input
          id="nombre_representante"
          name="nombre_representante"
          label="Nombre del representante, dirigente o líder"
          required
          maxlength={150}
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <Input
            id="telefono"
            name="telefono"
            label="Teléfono de contacto"
            type="tel"
            placeholder="+56 9 1234 5678"
            required
          />
          <Input
            id="correo"
            name="correo"
            label="Correo electrónico"
            type="email"
            required
          />
        </div>

        <Select
          id="id_pais"
          name="id_pais"
          label="País"
          options={paisesPlaceholder}
          placeholder="Selecciona un país"
          required
          hint="Opciones provisionales: aún falta conectar el listado real de países."
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <Input
            id="region_departamento"
            name="region_departamento"
            label="Región / Departamento"
            required
            maxlength={120}
          />
          <Input
            id="comuna_municipio_ciudad"
            name="comuna_municipio_ciudad"
            label="Comuna / Municipio / Ciudad"
            required
            maxlength={120}
          />
        </div>

        <Input
          id="direccion"
          name="direccion"
          label="Dirección"
          required
          maxlength={250}
        />

        <Select
          id="tipo_organizacion"
          name="tipo_organizacion"
          label="Tipo de Organización"
          options={tiposOrganizacion}
          placeholder="Selecciona un tipo"
          required
        />

        <!-- Campo condicional: solo visible si tipo_organizacion = "otra" (RF24) -->
        <div id="grupo-tipo-otro" class="hidden">
          <Input
            id="tipo_organizacion_otro"
            name="tipo_organizacion_otro"
            label='Especifica el tipo de Organización ("Otra")'
            maxlength={100}
          />
        </div>

        <div>
          <label for="publico_objetivo" class="text-sm font-medium text-neutral-800">
            Público objetivo <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <textarea
            id="publico_objetivo"
            name="publico_objetivo"
            required
            maxlength={500}
            rows={3}
            class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        </div>

        <Input
          id="numero_beneficiarios"
          name="numero_beneficiarios"
          label="Número de beneficiarios atendidos"
          type="number"
          required
        />

        <div>
          <label for="descripcion_breve" class="text-sm font-medium text-neutral-800">
            Descripción general <span class="text-danger" aria-hidden="true">*</span>
          </label>
          <textarea
            id="descripcion_breve"
            name="descripcion_breve"
            required
            maxlength={1000}
            rows={4}
            class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          ></textarea>
        </div>

        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2 border-t border-neutral-100">
          <Button variant="outline" href="/organizaciones">Cancelar</Button>
          <Button type="submit">Guardar</Button>
        </div>
      </form>
    </Card>
  </div>
</AppLayout>

<script>
  // Muestra/oculta el campo "tipo_organizacion_otro" según RF24.
  const selectTipo = document.getElementById('tipo_organizacion') as HTMLSelectElement | null;
  const grupoOtro = document.getElementById('grupo-tipo-otro');
  const inputOtro = document.getElementById('tipo_organizacion_otro') as HTMLInputElement | null;

  function actualizarVisibilidadOtro() {
    const esOtra = selectTipo?.value === 'otra';
    grupoOtro?.classList.toggle('hidden', !esOtra);
    if (inputOtro) {
      inputOtro.required = esOtra;
      if (!esOtra) inputOtro.value = '';
    }
  }

  selectTipo?.addEventListener('change', actualizarVisibilidadOtro);
  actualizarVisibilidadOtro();

  // NOTA: Pendiente conectar con crearOrganizacionAction cuando exista el listado real de países.
  const form = document.getElementById('form-nueva-organizacion');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    // eslint-disable-next-line no-console
    console.warn(
      'Formulario aún no conectado al backend (falta id_pais real). Ver KAN-137.',
    );
  });
</script>
