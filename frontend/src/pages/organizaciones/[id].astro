---
import AppLayout from '../../layouts/AppLayout.astro';
import { mainNavItems } from '../../config/nav';
import Card from '../../components/ui/Card.astro';

interface OrganizacionDemo {
  id_organizacion: string;
  nombre: string;
  pais: string;
  codigo_pais: string;
  tipo_organizacion: string;
  nombre_representante: string;
  telefono: string;
  correo: string;
  region_departamento: string;
  comuna_municipio_ciudad: string;
  direccion: string;
  publico_objetivo: string;
  descripcion_breve: string;
  numero_beneficiarios: number;
}

/*
 * ============================================================
 * DATOS TEMPORALES DE DEMOSTRACIÓN
 * ============================================================
 *
 * Estos datos serán reemplazados posteriormente por la
 * Action de Backend cuando esté disponible.
 *
 * NO conectar directamente a Supabase desde esta página.
 */

const organizacionesDemo: Record<string, OrganizacionDemo> = {
  'a1000000-0000-0000-0000-000000000001': {
    id_organizacion:
      'a1000000-0000-0000-0000-000000000001',
    nombre: 'Organización demostración Norte',
    pais: 'Chile',
    codigo_pais: 'CL',
    tipo_organizacion: 'Centro comunitario',
    nombre_representante: 'María González',
    telefono: '+56 9 1234 5678',
    correo: 'contacto@norte.cl',
    region_departamento: 'Región Metropolitana',
    comuna_municipio_ciudad: 'Maipú',
    direccion: 'Av. Principal 123',
    publico_objetivo:
      'Niños, niñas, adolescentes y familias de la comunidad.',
    descripcion_breve:
      'Organización comunitaria orientada al acompañamiento y desarrollo de familias en contextos vulnerables.',
    numero_beneficiarios: 120,
  },

  'a1000000-0000-0000-0000-000000000002': {
    id_organizacion:
      'a1000000-0000-0000-0000-000000000002',
    nombre: 'Organización demostración Centro',
    pais: 'Chile',
    codigo_pais: 'CL',
    tipo_organizacion: 'Comedor / Merendero',
    nombre_representante: 'Juan Pérez',
    telefono: '+56 9 8765 4321',
    correo: 'contacto@centro.cl',
    region_departamento: 'Región Metropolitana',
    comuna_municipio_ciudad: 'Santiago',
    direccion: 'Calle Central 456',
    publico_objetivo:
      'Familias y personas en situación de vulnerabilidad.',
    descripcion_breve:
      'Organización dedicada a entregar apoyo alimentario y acompañamiento comunitario.',
    numero_beneficiarios: 85,
  },

  'a1000000-0000-0000-0000-000000000003': {
    id_organizacion:
      'a1000000-0000-0000-0000-000000000003',
    nombre: 'Organización demostración Sur',
    pais: 'Chile',
    codigo_pais: 'CL',
    tipo_organizacion: 'Emprendimiento UV',
    nombre_representante: 'Ana Martínez',
    telefono: '+56 9 1122 3344',
    correo: 'contacto@sur.cl',
    region_departamento: 'Región de Los Lagos',
    comuna_municipio_ciudad: 'Puerto Montt',
    direccion: 'Av. Los Lagos 789',
    publico_objetivo:
      'Personas y familias de la comunidad local.',
    descripcion_breve:
      'Organización enfocada en generar oportunidades de desarrollo y fortalecimiento comunitario.',
    numero_beneficiarios: 65,
  },
};

const idOrganizacion = Astro.params.id ?? '';

/*
 * Por ahora utilizamos datos de demostración.
 *
 * Cuando Gabriel termine las Actions, esta sección será
 * reemplazada por la llamada correspondiente al Backend.
 */
const organizacion = organizacionesDemo[idOrganizacion];

const existeOrganizacion = Boolean(organizacion);
---

<AppLayout
  title={
    existeOrganizacion
      ? organizacion!.nombre
      : 'Organización no encontrada'
  }
  navItems={mainNavItems}
  allowedRoles={['ADMIN', 'COORD']}
>
  <Fragment slot="breadcrumb">
    <a
      href="/organizaciones"
      class="text-primary transition-colors hover:underline"
    >
      Organizaciones
    </a>

    <span>&rsaquo;</span>

    <span class="font-medium text-neutral-900">
      {organizacion?.nombre ?? 'Organización'}
    </span>
  </Fragment>

  <section class="space-y-6">

    {
      existeOrganizacion ? (
        <>
          <!-- =====================================================
               ENCABEZADO
          ====================================================== -->

          <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">

            <div class="min-w-0">

              <p class="mb-1 text-sm font-medium text-primary">
                Gestión institucional
              </p>

              <div class="flex flex-wrap items-center gap-3">

                <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
                  {organizacion.nombre}
                </h1>

                <span class="inline-flex items-center gap-1.5 rounded-full bg-success/10 px-3 py-1 text-xs font-semibold text-success">
                  <span aria-hidden="true">●</span>
                  Activa
                </span>

              </div>

              <p class="mt-2 text-sm text-neutral-500">
                {organizacion.tipo_organizacion}
                <span class="mx-1">·</span>
                {organizacion.pais}
              </p>

            </div>

          </div>


          <!-- =====================================================
               TABS
          ====================================================== -->

          <div class="overflow-x-auto">
            <nav
              class="flex min-w-max border-b border-neutral-200"
              aria-label="Secciones de organización"
            >

              <button
                type="button"
                data-tab="informacion"
                class="tab-organizacion border-b-2 border-primary px-5 py-3 text-sm font-semibold text-primary"
              >
                Información
              </button>

              <button
                type="button"
                data-tab="programas"
                class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
              >
                Programas
              </button>

              <button
                type="button"
                data-tab="intervenciones"
                class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
              >
                Intervenciones
              </button>

              <button
                type="button"
                data-tab="seguimiento"
                class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
              >
                Seguimiento
              </button>

            </nav>
          </div>


          <!-- =====================================================
               INFORMACIÓN
          ====================================================== -->

          <div
            id="tab-informacion"
            class="contenido-tab space-y-6"
          >

            <!-- Información general -->
            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Información general
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Datos principales de la organización.
                </p>

              </div>

              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Nombre de la organización
                  </p>

                  <p class="mt-1 text-sm font-medium text-neutral-900">
                    {organizacion.nombre}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    País
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.pais}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Tipo de organización
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.tipo_organizacion}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Representante
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.nombre_representante}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Número de beneficiarios
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.numero_beneficiarios}
                  </p>
                </div>

              </div>

            </Card>


            <!-- Contacto -->
            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Información de contacto
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Datos de contacto y ubicación de la organización.
                </p>

              </div>

              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Correo electrónico
                  </p>

                  <p class="mt-1 break-words text-sm text-neutral-900">
                    {organizacion.correo}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Teléfono
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.telefono}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Región / Departamento
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.region_departamento}
                  </p>
                </div>


                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Comuna / Municipio / Ciudad
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.comuna_municipio_ciudad}
                  </p>
                </div>


                <div class="md:col-span-2">

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Dirección
                  </p>

                  <p class="mt-1 text-sm text-neutral-900">
                    {organizacion.direccion}
                  </p>

                </div>

              </div>

            </Card>


            <!-- Contexto -->
            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Contexto de la organización
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Información relacionada con su trabajo y público objetivo.
                </p>

              </div>

              <div class="space-y-6">

                <div>

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Público objetivo
                  </p>

                  <p class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700">
                    {organizacion.publico_objetivo}
                  </p>

                </div>


                <div>

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Descripción
                  </p>

                  <p class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700">
                    {organizacion.descripcion_breve}
                  </p>

                </div>

              </div>

            </Card>

          </div>


          <!-- =====================================================
               PROGRAMAS
          ====================================================== -->

          <div
            id="tab-programas"
            class="contenido-tab hidden"
          >

            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Programas asociados
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Programas institucionales asociados a esta organización.
                </p>

              </div>

              <div class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center">

                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <span class="text-xl">+</span>
                </div>

                <p class="mt-4 text-sm font-medium text-neutral-700">
                  No hay programas asociados todavía.
                </p>

                <p class="mt-1 text-sm text-neutral-500">
                  Los programas asociados aparecerán aquí.
                </p>

              </div>

            </Card>

          </div>


          <!-- =====================================================
               INTERVENCIONES
          ====================================================== -->

          <div
            id="tab-intervenciones"
            class="contenido-tab hidden"
          >

            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Intervenciones
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Planes de intervención y acciones relacionadas con esta organización.
                </p>

              </div>

              <div class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center">

                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <span class="text-xl">+</span>
                </div>

                <p class="mt-4 text-sm font-medium text-neutral-700">
                  No hay intervenciones registradas todavía.
                </p>

                <p class="mt-1 text-sm text-neutral-500">
                  Los planes y acciones asociados aparecerán aquí.
                </p>

              </div>

            </Card>

          </div>


          <!-- =====================================================
               SEGUIMIENTO
          ====================================================== -->

          <div
            id="tab-seguimiento"
            class="contenido-tab hidden"
          >

            <Card>

              <div class="mb-6">

                <h2 class="text-lg font-semibold text-neutral-900">
                  Seguimiento
                </h2>

                <p class="mt-1 text-sm text-neutral-500">
                  Información de seguimiento de la organización.
                </p>

              </div>

              <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Evidencias
                  </p>

                  <p class="mt-2 text-sm text-neutral-500">
                    Sin información disponible.
                  </p>

                </div>


                <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Indicadores
                  </p>

                  <p class="mt-2 text-sm text-neutral-500">
                    Sin información disponible.
                  </p>

                </div>


                <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">

                  <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                    Recursos
                  </p>

                  <p class="mt-2 text-sm text-neutral-500">
                    Sin información disponible.
                  </p>

                </div>

              </div>

            </Card>

          </div>

        </>
      ) : (

        <Card>

          <div class="py-12 text-center">

            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-danger/10 text-danger">
              !
            </div>

            <h1 class="mt-4 text-xl font-semibold text-neutral-900">
              Organización no encontrada
            </h1>

            <p class="mx-auto mt-2 max-w-lg text-sm text-neutral-500">
              No existe una organización de demostración asociada al identificador solicitado.
            </p>

            <a
              href="/organizaciones"
              class="mt-6 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              Volver a organizaciones
            </a>

          </div>

        </Card>
      )
    }

  </section>
</AppLayout>


<script>
  const tabs =
    document.querySelectorAll<HTMLButtonElement>(
      '.tab-organizacion',
    );

  const contenidos =
    document.querySelectorAll<HTMLElement>(
      '.contenido-tab',
    );

  tabs.forEach((tab) => {

    tab.addEventListener('click', () => {

      const tabSeleccionada =
        tab.dataset.tab;

      if (!tabSeleccionada) {
        return;
      }

      tabs.forEach((item) => {

        const activa =
          item.dataset.tab === tabSeleccionada;

        item.classList.toggle(
          'border-primary',
          activa,
        );

        item.classList.toggle(
          'text-primary',
          activa,
        );

        item.classList.toggle(
          'font-semibold',
          activa,
        );

        item.classList.toggle(
          'border-transparent',
          !activa,
        );

        item.classList.toggle(
          'text-neutral-500',
          !activa,
        );

        item.classList.toggle(
          'font-medium',
          !activa,
        );

      });

      contenidos.forEach((contenido) => {

        contenido.classList.toggle(
          'hidden',
          contenido.id !== `tab-${tabSeleccionada}`,
        );

      });

    });

  });
</script>