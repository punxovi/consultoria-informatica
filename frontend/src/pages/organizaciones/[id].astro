---
import AppLayout from '../../layouts/AppLayout.astro';
import { mainNavItems } from '../../config/nav';
import Card from '../../components/ui/Card.astro';
import { actions } from 'astro:actions';
import type { Organizacion } from '../../lib/server/organizaciones';

const idOrganizacion = Astro.params.id;
let organizacion: Organizacion | null = null;
let organizacionInexistente = false;
let mensajeError = 'No fue posible cargar la organización.';

if (!idOrganizacion) {
  organizacionInexistente = true;
  mensajeError = 'La organización solicitada no existe.';
} else {
  const resultado = await Astro.callAction(
    actions.obtenerOrganizacionPorId,
    { id_organizacion: idOrganizacion },
  );

  if (resultado.error) {
    mensajeError = resultado.error.message;
  } else if (!resultado.data.ok) {
    organizacionInexistente = resultado.data.codigo === 'NO_ENCONTRADA';
    mensajeError = resultado.data.mensaje;
  } else {
    organizacion = resultado.data.datos;
  }
}

const tituloPagina = organizacion?.nombre ??
  (organizacionInexistente
    ? 'Organización no encontrada'
    : 'No fue posible cargar la organización');

const tipoOrganizacion = organizacion
  ? organizacion.tipo_organizacion === 'comedor_merendero'
    ? 'Comedor / Merendero'
    : organizacion.tipo_organizacion === 'centro_comunitario'
      ? 'Centro comunitario'
      : organizacion.tipo_organizacion === 'emprendimiento_uv'
        ? 'Emprendimiento UV'
        : organizacion.tipo_organizacion_otro ?? 'Otra organización'
  : '';
---

<AppLayout
  title={tituloPagina}
  navItems={mainNavItems}
  allowedRoles={['ADMIN', 'COORD']}
>
  <Fragment slot="breadcrumb">
    <a
      href="/organizaciones"
      class="text-primary transition-colors hover:underline"
    >
      Organizaciones
    </a>
    <span>&rsaquo;</span>
    <span class="font-medium text-neutral-900">
      {tituloPagina}
    </span>
  </Fragment>

  {organizacion ? (
    <section class="space-y-6">
    <!-- Encabezado -->
    <div>
      <p class="mb-1 text-sm font-medium text-primary">
        Gestión institucional
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
          {organizacion.nombre}
        </h1>

        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-success/10 px-3 py-1 text-xs font-semibold text-success"
        >
          <span aria-hidden="true">●</span>
          Activa
        </span>
      </div>

      <p class="mt-2 text-sm text-neutral-500">
        {tipoOrganizacion}
        <span class="mx-1">·</span>
        {organizacion.pais.nombre}
      </p>
    </div>

    <!-- Tabs -->
    <div class="overflow-x-auto">
      <nav
        class="flex min-w-max border-b border-neutral-200"
        aria-label="Secciones de organización"
      >
        <button
          type="button"
          data-tab="informacion"
          class="tab-organizacion border-b-2 border-primary px-5 py-3 text-sm font-semibold text-primary"
        >
          Información
        </button>

        <button
          type="button"
          data-tab="programas"
          class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
        >
          Programas
        </button>

        <button
          type="button"
          data-tab="intervenciones"
          class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
        >
          Intervenciones
        </button>

        <button
          type="button"
          data-tab="seguimiento"
          class="tab-organizacion border-b-2 border-transparent px-5 py-3 text-sm font-medium text-neutral-500 transition-colors hover:text-primary"
        >
          Seguimiento
        </button>
      </nav>
    </div>

    <!-- Información -->
    <div id="tab-informacion" class="contenido-tab space-y-6">
      <!-- Información general -->
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Información general
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Datos principales de la organización.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Nombre de la organización
            </p>
            <p class="mt-1 text-sm font-medium text-neutral-900">
              {organizacion.nombre}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              País
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.pais.nombre}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Tipo de organización
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {tipoOrganizacion}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Representante
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.nombre_representante}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Número de beneficiarios
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.numero_beneficiarios}
            </p>
          </div>
        </div>
      </Card>

      <!-- Información de contacto -->
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Información de contacto
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Datos de contacto y ubicación de la organización.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Correo electrónico
            </p>
            <p class="mt-1 break-words text-sm text-neutral-900">
              {organizacion.correo}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Teléfono
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.telefono}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Región / Departamento
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.region_departamento}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Comuna / Municipio / Ciudad
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.comuna_municipio_ciudad}
            </p>
          </div>

          <div class="md:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Dirección
            </p>
            <p class="mt-1 text-sm text-neutral-900">
              {organizacion.direccion}
            </p>
          </div>
        </div>
      </Card>

      <!-- Contexto -->
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Contexto de la organización
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Información relacionada con su trabajo y público objetivo.
          </p>
        </div>

        <div class="space-y-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Público objetivo
            </p>
            <p class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700">
              {organizacion.publico_objetivo}
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Descripción
            </p>
            <p class="mt-2 whitespace-pre-line text-sm leading-6 text-neutral-700">
              {organizacion.descripcion_breve}
            </p>
          </div>
        </div>
      </Card>
    </div>

    <!-- Programas -->
    <div id="tab-programas" class="contenido-tab hidden">
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Programas asociados
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Programas institucionales asociados a esta organización.
          </p>
        </div>

        <div
          class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center"
        >
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
          >
            <span class="text-xl">+</span>
          </div>

          <p class="mt-4 text-sm font-medium text-neutral-700">
            No hay programas asociados todavía.
          </p>
          <p class="mt-1 text-sm text-neutral-500">
            Los programas asociados aparecerán aquí.
          </p>
        </div>
      </Card>
    </div>

    <!-- Intervenciones -->
    <div id="tab-intervenciones" class="contenido-tab hidden">
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Intervenciones
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Planes de intervención y acciones relacionadas con esta
            organización.
          </p>
        </div>

        <div
          class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center"
        >
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
          >
            <span class="text-xl">+</span>
          </div>

          <p class="mt-4 text-sm font-medium text-neutral-700">
            No hay intervenciones registradas todavía.
          </p>
          <p class="mt-1 text-sm text-neutral-500">
            Los planes y acciones asociados aparecerán aquí.
          </p>
        </div>
      </Card>
    </div>

    <!-- Seguimiento -->
    <div id="tab-seguimiento" class="contenido-tab hidden">
      <Card>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-neutral-900">
            Seguimiento
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Información de seguimiento de la organización.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Evidencias
            </p>
            <p class="mt-2 text-sm text-neutral-500">
              Sin información disponible.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Indicadores
            </p>
            <p class="mt-2 text-sm text-neutral-500">
              Sin información disponible.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Recursos
            </p>
            <p class="mt-2 text-sm text-neutral-500">
              Sin información disponible.
            </p>
          </div>
        </div>
      </Card>
    </div>
    </section>
  ) : (
    <section class="space-y-6">
      <Card>
        <div class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center">
          <h1 class="text-lg font-semibold text-neutral-900">
            {tituloPagina}
          </h1>
          <p class="mt-2 text-sm text-neutral-500">
            {mensajeError}
          </p>
          <a
            href="/organizaciones"
            class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            Volver a organizaciones
          </a>
        </div>
      </Card>
    </section>
  )}
</AppLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-organizacion');
  const contenidos =
    document.querySelectorAll<HTMLElement>('.contenido-tab');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabSeleccionada = tab.dataset.tab;
      if (!tabSeleccionada) return;

      tabs.forEach((item) => {
        const activa = item.dataset.tab === tabSeleccionada;

        item.classList.toggle('border-primary', activa);
        item.classList.toggle('text-primary', activa);
        item.classList.toggle('font-semibold', activa);
        item.classList.toggle('border-transparent', !activa);
        item.classList.toggle('text-neutral-500', !activa);
        item.classList.toggle('font-medium', !activa);
      });

      contenidos.forEach((contenido) => {
        contenido.classList.toggle(
          'hidden',
          contenido.id !== `tab-${tabSeleccionada}`,
        );
      });
    });
  });
</script>
