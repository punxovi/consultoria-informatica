---
import AppLayout from '../../layouts/AppLayout.astro';
import { mainNavItems } from '../../config/nav';

export const prerender = false;

const { id } = Astro.params;
---

<AppLayout title="Detalle de organización" navItems={mainNavItems}>

  <Fragment slot="breadcrumb">
    <a href="/organizaciones" class="hover:text-[#4f428c]">
      Organizaciones
    </a>

    <span>&rsaquo;</span>

    <span class="text-neutral-900 font-medium">
      Organización {id}
    </span>
  </Fragment>

  <section>
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-neutral-900">
        Organización {id}
      </h1>

      <p class="text-sm text-neutral-500 mt-1">
        Información y gestión de la organización seleccionada.
      </p>
    </div>

    <div class="bg-white border border-neutral-200 rounded-xl p-6">
      <h2 class="text-sm font-semibold text-neutral-800 mb-4">
        Detalle de la organización
      </h2>

      <p class="text-sm text-neutral-500">
        Pantalla preparada para incorporar posteriormente
        la información, programas, intervenciones y seguimiento
        de la organización.
      </p>
    </div>
  </section>

</AppLayout>