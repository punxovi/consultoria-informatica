---
import BackButton from '../../components/ui/BackButton.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { mainNavItems } from '../../config/nav';
import AppLayout from '../../layouts/AppLayout.astro';
import AccionesPlan from '../../components/acciones/AccionesPlan.astro';

const idPlan = Astro.params.id ?? '';
---

<AppLayout title="Detalle del plan" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="breadcrumb">
    <div class="flex items-center gap-4">
      <BackButton />
      <a href="/planes" class="text-sm text-neutral-500 hover:text-primary">Planes de Intervención</a>
      <span class="text-neutral-400">›</span>
      <span id="plan-breadcrumb" class="truncate text-sm font-medium text-neutral-900">Detalle</span>
    </div>
  </Fragment>

  <section data-id-plan={idPlan} class="space-y-6">
    <p id="detalle-estado" role="status" aria-live="polite">Cargando plan…</p>
    <div id="detalle-error" hidden role="alert" class="rounded-lg border border-red-700 bg-red-50 p-4 text-red-800"></div>

    <div id="detalle-plan" hidden class="space-y-6">
      <div>
        <p class="mb-1 text-sm font-medium text-primary">Gestión de intervenciones</p>
        <div class="flex flex-wrap items-center gap-3">
          <h1 data-plan="nombre" class="text-2xl font-bold text-neutral-900 md:text-3xl"></h1>
          <span data-plan="estado" class="inline-flex rounded-full px-3 py-1 text-xs font-semibold"></span>
        </div>
        <p data-plan="resumen" class="mt-2 text-sm text-neutral-500"></p>
        <div class="mt-4"><Button href={`/planes/${encodeURIComponent(idPlan)}/editar`} variant="outline">Editar plan</Button></div>
      </div>

      <Card>
        <h2 class="mb-5 text-lg font-semibold text-neutral-900">Información general</h2>
        <dl class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Organización</dt><dd data-plan="organizacion" class="mt-1 text-sm font-medium"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Programa</dt><dd data-plan="programa" class="mt-1 text-sm font-medium"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Responsable</dt><dd data-plan="responsable_nombre" class="mt-1 text-sm font-medium"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Fecha de inicio</dt><dd data-plan="fecha_inicio" class="mt-1 text-sm font-medium"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Fecha de término</dt><dd data-plan="fecha_termino" class="mt-1 text-sm font-medium"></dd></div>
        </dl>
      </Card>

      <Card>
        <h2 class="mb-5 text-lg font-semibold text-neutral-900">Definición del plan</h2>
        <dl class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Situación o necesidad</dt><dd data-plan="situacion_necesidad" class="mt-2 whitespace-pre-wrap text-sm leading-6 text-neutral-700"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Objetivo general</dt><dd data-plan="objetivo_general" class="mt-2 whitespace-pre-wrap text-sm leading-6 text-neutral-700"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Objetivos específicos</dt><dd data-plan="objetivos_especificos" class="mt-2 whitespace-pre-wrap text-sm leading-6 text-neutral-700"></dd></div>
          <div><dt class="text-xs font-semibold uppercase text-neutral-500">Resultado esperado</dt><dd data-plan="resultado_esperado" class="mt-2 whitespace-pre-wrap text-sm leading-6 text-neutral-700"></dd></div>
        </dl>
      </Card>

      <Card>
        <AccionesPlan idPlan={idPlan} />
      </Card>
    </div>
  </section>
</AppLayout>

<script>
  import { obtenerPlan } from '../../lib/planes/cliente';

  const seccion = document.querySelector<HTMLElement>('[data-id-plan]')!;
  const estado = document.querySelector<HTMLElement>('#detalle-estado')!;
  const error = document.querySelector<HTMLElement>('#detalle-error')!;
  const contenido = document.querySelector<HTMLElement>('#detalle-plan')!;

  function estadoPlan(inicio: string, termino: string) {
    const hoy = new Date().toISOString().slice(0, 10);
    if (termino < hoy) return { texto: 'Finalizado', clase: 'bg-neutral-100 text-neutral-600' };
    if (inicio > hoy) return { texto: 'Pendiente', clase: 'bg-amber-50 text-amber-700' };
    return { texto: 'En ejecución', clase: 'bg-emerald-50 text-emerald-700' };
  }

  void obtenerPlan(seccion.dataset.idPlan ?? '').then(plan => {
    document.querySelector<HTMLElement>('#plan-breadcrumb')!.textContent = plan.nombre;
    const valores: Record<string, string> = {
      nombre: plan.nombre,
      resumen: `${plan.organizacion.nombre} · ${plan.fecha_inicio.slice(0, 4)}`,
      organizacion: plan.organizacion.nombre,
      programa: plan.programa.nombre,
      responsable_nombre: plan.responsable_nombre,
      fecha_inicio: new Date(`${plan.fecha_inicio}T00:00:00`).toLocaleDateString('es-CL'),
      fecha_termino: new Date(`${plan.fecha_termino}T00:00:00`).toLocaleDateString('es-CL'),
      situacion_necesidad: plan.situacion_necesidad,
      objetivo_general: plan.objetivo_general,
      objetivos_especificos: plan.objetivos_especificos,
      resultado_esperado: plan.resultado_esperado,
    };
    for (const [campo, valor] of Object.entries(valores)) {
      document.querySelector<HTMLElement>(`[data-plan="${campo}"]`)!.textContent = valor;
    }
    const etiqueta = document.querySelector<HTMLElement>('[data-plan="estado"]')!;
    const calculado = estadoPlan(plan.fecha_inicio, plan.fecha_termino);
    etiqueta.textContent = calculado.texto;
    etiqueta.classList.add(...calculado.clase.split(' '));
    estado.textContent = '';
    contenido.hidden = false;
  }).catch(fallo => {
    estado.textContent = '';
    error.textContent = fallo instanceof Error ? fallo.message : 'No fue posible cargar el plan.';
    error.hidden = false;
  });
</script>
