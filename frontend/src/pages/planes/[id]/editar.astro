---
import BackButton from '../../../components/ui/BackButton.astro';
import PlanForm from '../../../components/planes/PlanForm.astro';
import { mainNavItems } from '../../../config/nav';
import AppLayout from '../../../layouts/AppLayout.astro';

const idPlan = Astro.params.id ?? '';
const rutaPlan = `/planes/${encodeURIComponent(idPlan)}`;
---

<AppLayout title="Editar plan" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="headerBreadcrumb">
    <BackButton href={rutaPlan} />
    <a href="/planes" class="truncate text-sm text-neutral-500 transition-colors hover:text-primary">
      Planes de Intervención
    </a>
    <span aria-hidden="true" class="text-neutral-300">›</span>
    <a href={rutaPlan} class="truncate text-sm text-neutral-500 transition-colors hover:text-primary">
      Detalle del plan
    </a>
    <span aria-hidden="true" class="text-neutral-300">›</span>
    <span class="truncate text-sm font-semibold text-neutral-900">Editar plan</span>
  </Fragment>
  <PlanForm idPlan={idPlan} />
</AppLayout>
