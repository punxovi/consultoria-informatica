---
import Icono from '../../../../components/ui/Icono.astro';
import Button from '../../../../components/ui/Button.astro';
import DetalleAccionInfo from '../../../../components/acciones/DetalleAccionInfo.astro';
import AccionLayout from '../../../../layouts/AccionLayout.astro';
import EliminarRegistro from '../../../../components/ui/EliminarRegistro.astro';
import IndicadoresAccion from '../../../../components/indicadores/IndicadoresAccion.astro';
import EvidenciasAccion from '../../../../components/evidencias/EvidenciasAccion.astro';

const idPlan = Astro.params.id ?? '';
const idAccion = Astro.params.idAccion ?? '';
const rutaAccion = `/planes/${encodeURIComponent(idPlan)}/acciones/${encodeURIComponent(idAccion)}`;
---

<AccionLayout idPlan={idPlan} title="Detalle de acción">
  <section id="accion-detalle" data-id-plan={idPlan} data-id-accion={idAccion} class="-mt-3 w-full space-y-5">
    <p id="detalle-estado" role="status" aria-live="polite" class="text-sm text-neutral-500">Cargando acción…</p>
    <p id="detalle-error" hidden role="alert" class="rounded-xl border border-danger/30 bg-danger/5 p-4 text-sm text-danger"></p>
    <div id="detalle-reintentar" hidden>
      <Button id="recargar-accion" variant="outline">Reintentar carga</Button>
    </div>

    <div id="detalle-contenido" hidden class="space-y-5">
      <p
        id="accion-confirmacion"
        hidden
        role="status"
        aria-live="polite"
        class="rounded-xl border border-success/20 bg-success/10 p-4 text-sm font-medium text-success"
      >
        Acción modificada correctamente.
      </p>

      <header class="flex flex-col justify-between gap-4 xl:flex-row xl:items-start">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 data-accion="nombre" class="break-words text-2xl font-bold text-neutral-900 md:text-3xl"></h1>
            <span data-accion="estado" class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary"></span>
            <span id="accion-vencida" hidden class="inline-flex rounded-full bg-brand-pink/10 px-3 py-1 text-xs font-semibold text-[#AD174F]">Vencida</span>
          </div>
          <p class="mt-2 text-sm text-neutral-600 md:text-base">
            Plan de intervención: <span data-accion="plan" class="font-medium text-neutral-800"></span>
          </p>
        </div>

        <!-- Visible solo si la sesión gestiona el país de la Organización del plan. -->
        <div id="gestion-accion" hidden class="flex shrink-0 flex-wrap items-center gap-3">
          <EliminarRegistro
            tipo="accion"
            id={idAccion}
            regreso={`/planes/${encodeURIComponent(idPlan)}?resultado=accion-eliminada#acciones-plan`}
          />
          <Button href={`${rutaAccion}/editar`} variant="outline">
            <Icono nombre="editar" />
            Editar acción
          </Button>
        </div>
      </header>

      <div class="overflow-x-auto rounded-2xl border border-[#E5E1EF] bg-white p-2">
        <div id="accion-tabs" class="flex min-w-max flex-wrap gap-2" role="tablist" aria-label="Secciones de la acción">
          <button id="tab-detalle" type="button" role="tab" aria-selected="true" aria-controls="panel-detalle" data-tab="detalle" class="shrink-0 rounded-full bg-[#4C4688] px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors">Detalle de acción</button>
          <button id="tab-indicadores" type="button" role="tab" aria-selected="false" aria-controls="panel-indicadores" data-tab="indicadores" tabindex="-1" class="shrink-0 rounded-full bg-[#F2F0F7] px-5 py-3 text-sm font-medium text-neutral-600 transition-colors hover:bg-[#E8E4F3] hover:text-primary">Indicadores y resultados</button>
          <button id="tab-evidencias" type="button" role="tab" aria-selected="false" aria-controls="panel-evidencias" data-tab="evidencias" tabindex="-1" class="shrink-0 rounded-full bg-[#F2F0F7] px-5 py-3 text-sm font-medium text-neutral-600 transition-colors hover:bg-[#E8E4F3] hover:text-primary">Evidencias</button>
        </div>
      </div>

      <section id="panel-detalle" role="tabpanel" aria-labelledby="tab-detalle" data-panel="detalle" class="min-w-0">
        <DetalleAccionInfo />
      </section>

      <section id="panel-indicadores" role="tabpanel" aria-labelledby="tab-indicadores" data-panel="indicadores" hidden class="min-w-0">
        <IndicadoresAccion idAccion={idAccion} />
      </section>

      <section id="panel-evidencias" role="tabpanel" aria-labelledby="tab-evidencias" data-panel="evidencias" hidden class="min-w-0">
        <EvidenciasAccion idAccion={idAccion} />
      </section>
    </div>
  </section>
</AccionLayout>

<script>
  import { obtenerAccion } from '../../../../lib/acciones/cliente';
  import { obtenerPlan } from '../../../../lib/planes/cliente';
  import { obtenerAlcanceGestion, puedeGestionarPais } from '../../../../lib/territorio/permisos';
  import { etiquetaEstado, estaVencida, mostrarFecha } from '../../../../lib/acciones/presentacion';

  const seccion = document.querySelector<HTMLElement>('#accion-detalle')!;
  const estado = document.querySelector<HTMLElement>('#detalle-estado')!;
  const error = document.querySelector<HTMLElement>('#detalle-error')!;
  const contenido = document.querySelector<HTMLElement>('#detalle-contenido')!;
  const reintentar = document.querySelector<HTMLElement>('#detalle-reintentar')!;
  const botonesTab = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panelesTab = document.querySelectorAll<HTMLElement>('[data-panel]');
  let cargando = false;

  function activarTab(nombre: string) {
    botonesTab.forEach((boton) => {
      const activo = boton.dataset.tab === nombre;
      boton.setAttribute('aria-selected', String(activo));
      boton.tabIndex = activo ? 0 : -1;
      boton.className = activo
        ? 'shrink-0 rounded-full bg-[#4C4688] px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors'
        : 'shrink-0 rounded-full bg-[#F2F0F7] px-5 py-3 text-sm font-medium text-neutral-600 transition-colors hover:bg-[#E8E4F3] hover:text-primary';
    });

    panelesTab.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== nombre;
    });
  }

  botonesTab.forEach((boton, indice) => {
    boton.addEventListener('click', () => activarTab(boton.dataset.tab ?? 'detalle'));
    boton.addEventListener('keydown', (evento) => {
      if (evento.key !== 'ArrowLeft' && evento.key !== 'ArrowRight') return;
      evento.preventDefault();
      const paso = evento.key === 'ArrowRight' ? 1 : -1;
      const siguiente = (indice + paso + botonesTab.length) % botonesTab.length;
      botonesTab[siguiente]?.focus();
      botonesTab[siguiente]?.click();
    });
  });

  async function cargar() {
    if (cargando) return;
    cargando = true;
    seccion.setAttribute('aria-busy', 'true');
    contenido.hidden = true;
    reintentar.hidden = true;
    error.hidden = true;
    estado.textContent = 'Cargando acción…';

    try {
      const [accion, plan, alcance] = await Promise.all([
        obtenerAccion(seccion.dataset.idAccion!),
        obtenerPlan(seccion.dataset.idPlan!),
        obtenerAlcanceGestion(),
      ]);
      if (accion.id_plan !== seccion.dataset.idPlan) {
        throw new Error('La acción solicitada no pertenece a este plan.');
      }
      document.querySelector<HTMLElement>('#gestion-accion')!.hidden =
        !puedeGestionarPais(alcance, plan.organizacion.id_pais);

      const raizEliminar = document.querySelector<HTMLElement>('#eliminar-registro');
      if (raizEliminar) raizEliminar.dataset.version = String(accion.version);

      const datos: Record<string, string> = {
        nombre: accion.nombre,
        plan: accion.plan.nombre,
        'plan-detalle': accion.plan.nombre,
        estado: etiquetaEstado(accion.estado),
        descripcion: accion.descripcion || 'Sin descripción registrada.',
        responsable_nombre: accion.responsable_nombre,
        fecha_inicio: mostrarFecha(accion.fecha_inicio),
        fecha_termino: mostrarFecha(accion.fecha_termino),
        observacion_motivo: accion.observacion_motivo || 'Sin observaciones.',
        resultado_esperado: accion.resultado_esperado || 'Sin resultado esperado registrado.',
      };

      for (const [campo, valor] of Object.entries(datos)) {
        seccion.querySelectorAll<HTMLElement>(`[data-accion="${campo}"]`).forEach((elemento) => {
          elemento.textContent = valor;
        });
      }

      const motivoTitulo = seccion.querySelector<HTMLElement>('#motivo-titulo');
      if (motivoTitulo) motivoTitulo.textContent = accion.estado === 'cancelada' ? 'Motivo de cancelación' : 'Observaciones';
      document.querySelector<HTMLElement>('#accion-vencida')!.hidden = !estaVencida(accion);

      contenido.hidden = false;
      seccion.dataset.cargada = 'true';

      const parametros = new URLSearchParams(window.location.search);
      const resultado = parametros.get('resultado');
      const confirmacion = document.querySelector<HTMLElement>('#accion-confirmacion');
      if (resultado === 'accion-actualizada' && confirmacion) {
        confirmacion.hidden = false;
        history.replaceState(null, '', `${window.location.pathname}${window.location.hash}`);
      }

      window.dispatchEvent(new Event('accion:lista-para-evidencias'));
      window.dispatchEvent(new Event('accion:detalle-cargado'));
      estado.textContent = '';
    } catch (fallo) {
      estado.textContent = '';
      error.textContent = fallo instanceof Error ? fallo.message : 'No fue posible cargar la acción.';
      error.hidden = false;
      reintentar.hidden = false;
    } finally {
      cargando = false;
      seccion.setAttribute('aria-busy', 'false');
    }
  }

  document.querySelector<HTMLButtonElement>('#recargar-accion')?.addEventListener('click', () => void cargar());
  window.addEventListener('pageshow', (evento) => {
    if (evento.persisted) void cargar();
  });
  void cargar();
</script>
