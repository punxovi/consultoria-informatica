---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { mainNavItems } from '../config/nav';
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Planes de Intervención" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <Fragment slot="headerBreadcrumb">
    <span class="text-sm font-semibold text-neutral-900">Planes de Intervención</span>
  </Fragment>

  <section class="space-y-6">
    <p
      id="plan-confirmacion"
      hidden
      role="status"
      class="rounded-xl border border-success/20 bg-success/10 p-4 text-sm text-success"
    ></p>

    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary">Gestión institucional</p>
        <h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">Planes de Intervención</h1>
        <p class="mt-2 max-w-2xl text-sm text-neutral-500">
          Consulta, filtra y administra los planes asociados a organizaciones y programas institucionales.
        </p>
      </div>
      <Button href="/planes/nuevo" class="shrink-0">
        <span aria-hidden="true">+</span> Nuevo plan
      </Button>
    </header>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <Card class="border-l-4 border-l-primary p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-primary/10 p-3 text-primary" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4h8l4 4v12H4V4h4Zm7 0v5h5M8 13h8m-8 4h8" /></svg>
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Planes encontrados</p>
            <p id="planes-total" class="mt-1 text-2xl font-bold text-neutral-900">—</p>
          </div>
        </div>
      </Card>
      <Card class="border-l-4 border-l-brand-green p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-brand-green/10 p-3 text-brand-green" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" /></svg>
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">En ejecución</p>
            <p id="planes-ejecucion" class="mt-1 text-2xl font-bold text-neutral-900">—</p>
          </div>
        </div>
      </Card>
      <Card class="border-l-4 border-l-brand-yellow p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-brand-yellow/20 p-3 text-[#946200]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" /></svg>
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Pendientes</p>
            <p id="planes-pendientes" class="mt-1 text-2xl font-bold text-neutral-900">—</p>
          </div>
        </div>
      </Card>
    </div>

    <Card class="p-4 md:p-5">
      <div class="mb-4 flex items-start gap-3">
        <span class="rounded-xl bg-primary/10 p-2.5 text-primary" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16M7 12h10m-7 7h4" /></svg>
        </span>
        <div>
          <h2 class="text-lg font-semibold text-neutral-900">Filtrar planes</h2>
          <p class="mt-1 text-sm text-neutral-500">Combina año, programa y organización para encontrar los planes que necesitas.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-3">
        <div class="space-y-1.5">
          <label for="filtro-anio" class="block text-sm font-medium text-neutral-800">Año del plan</label>
          <select id="filtro-anio" class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="">Todos los años</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label for="filtro-programa" class="block text-sm font-medium text-neutral-800">Programa institucional</label>
          <select id="filtro-programa" class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="">Todos los programas</option>
          </select>
        </div>
        <div class="space-y-1.5">
          <label for="filtro-organizacion" class="block text-sm font-medium text-neutral-800">Organización</label>
          <select id="filtro-organizacion" class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="">Todas las organizaciones</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
        <p id="planes-estado" role="status" aria-live="polite" class="text-sm text-neutral-500">Cargando planes…</p>
        <Button id="limpiar-filtros" variant="outline" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M5.5 9A7 7 0 0 1 18 6l2 4M19 15a7 7 0 0 1-12.5 3L4 14" /></svg>
          Limpiar filtros
        </Button>
      </div>
      <p id="planes-error" role="alert" hidden class="mt-3 rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger"></p>
    </Card>

    <section aria-labelledby="planes-listado-titulo" class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="planes-listado-titulo" class="text-lg font-semibold text-neutral-900">Listado de planes</h2>
          <p class="mt-1 text-sm text-neutral-500">Selecciona un plan para consultar su información y sus acciones.</p>
        </div>
        <Button id="recargar-planes" variant="outline" class="shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7v5h-5M4 17v-5h5m-4.5-3A8 8 0 0 1 18 6l2 6M4 12l2 6a8 8 0 0 0 12.5-1" />
          </svg>
          Actualizar listado
        </Button>
      </div>
      <div id="planes-listado" aria-busy="true" class="grid grid-cols-1 gap-3"></div>
      <div id="planes-vacio" hidden class="rounded-2xl border border-dashed border-neutral-300 bg-white p-8 text-center">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4h8l4 4v12H4V4h4Zm7 0v5h5M8 13h8m-8 4h5" /></svg>
        </span>
        <h3 id="planes-vacio-titulo" class="mt-3 font-semibold text-neutral-900">No hay planes para mostrar</h3>
        <p id="planes-vacio-descripcion" class="mt-1 text-sm text-neutral-500">Prueba cambiando los filtros o registra un nuevo plan.</p>
      </div>
    </section>
  </section>
</AppLayout>

<template id="plantilla-plan">
  <article class="group rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm transition hover:border-[#D8D3F2] hover:shadow-md sm:p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4h8l4 4v12H4V4h4Zm7 0v5h5M8 13h8m-8 4h8" /></svg>
          </span>
          <h3 data-nombre class="min-w-0 break-words text-lg font-bold text-neutral-900"></h3>
          <span data-estado class="inline-flex shrink-0 items-center rounded-full px-3 py-1 text-xs font-semibold"></span>
        </div>

        <dl class="mt-4 grid grid-cols-1 gap-4 pl-0 sm:grid-cols-2 xl:grid-cols-4">
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Organización</dt>
            <dd data-organizacion class="mt-1 break-words text-sm font-medium text-neutral-800"></dd>
          </div>
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Programa</dt>
            <dd data-programa class="mt-1 break-words text-sm font-medium text-neutral-800"></dd>
          </div>
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Año del plan</dt>
            <dd data-anio class="mt-1 text-sm font-medium text-neutral-800"></dd>
          </div>
          <div class="min-w-0">
            <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Vigencia</dt>
            <dd data-vigencia class="mt-1 text-sm font-medium text-neutral-800"></dd>
          </div>
        </dl>
      </div>

      <div class="flex shrink-0 justify-end border-t border-neutral-100 pt-3 lg:border-l lg:border-t-0 lg:pl-5 lg:pt-0">
        <a data-detalle class="inline-flex min-h-[44px] items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-primary transition hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Ver detalle <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</template>

<script>
  import { listarPlanes } from '../lib/planes/cliente';

  type PlanListado = Awaited<ReturnType<typeof listarPlanes>>[number];

  const listado = document.querySelector<HTMLElement>('#planes-listado')!;
  const estado = document.querySelector<HTMLElement>('#planes-estado')!;
  const error = document.querySelector<HTMLElement>('#planes-error')!;
  const recargar = document.querySelector<HTMLButtonElement>('#recargar-planes')!;
  const filtroAnio = document.querySelector<HTMLSelectElement>('#filtro-anio')!;
  const filtroPrograma = document.querySelector<HTMLSelectElement>('#filtro-programa')!;
  const filtroOrganizacion = document.querySelector<HTMLSelectElement>('#filtro-organizacion')!;
  const limpiarFiltros = document.querySelector<HTMLButtonElement>('#limpiar-filtros')!;
  const planesVacio = document.querySelector<HTMLElement>('#planes-vacio')!;
  const planesVacioTitulo = document.querySelector<HTMLElement>('#planes-vacio-titulo')!;
  const planesVacioDescripcion = document.querySelector<HTMLElement>('#planes-vacio-descripcion')!;
  const plantilla = document.querySelector<HTMLTemplateElement>('#plantilla-plan')!;
  const total = document.querySelector<HTMLElement>('#planes-total')!;
  const enEjecucion = document.querySelector<HTMLElement>('#planes-ejecucion')!;
  const pendientes = document.querySelector<HTMLElement>('#planes-pendientes')!;

  let planes: PlanListado[] = [];
  let cargando = false;

  function obtenerEstado(inicio: string, termino: string) {
    const hoy = new Date().toISOString().slice(0, 10);
    if (termino < hoy) return { texto: 'Finalizado', clase: 'bg-neutral-100 text-neutral-600', clave: 'finalizado' };
    if (inicio > hoy) return { texto: 'Pendiente', clase: 'bg-brand-yellow/20 text-[#946200]', clave: 'pendiente' };
    return { texto: 'En ejecución', clase: 'bg-brand-green/10 text-[#16794F]', clave: 'ejecucion' };
  }

  function periodo(inicio: string, termino: string) {
    const desde = inicio.slice(0, 4);
    const hasta = termino.slice(0, 4);
    return desde === hasta ? desde : `${desde}–${hasta}`;
  }

  function llenarOpciones(
    selector: HTMLSelectElement,
    etiquetaInicial: string,
    opciones: { valor: string; etiqueta: string }[],
    valorAnterior: string,
  ) {
    selector.replaceChildren(new Option(etiquetaInicial, ''));
    for (const opcion of opciones) selector.add(new Option(opcion.etiqueta, opcion.valor));
    if (opciones.some(opcion => opcion.valor === valorAnterior)) selector.value = valorAnterior;
  }

  function poblarFiltros() {
    const anioAnterior = filtroAnio.value;
    const programaAnterior = filtroPrograma.value;
    const organizacionAnterior = filtroOrganizacion.value;

    const anios = [...new Set(planes.map(plan => String(plan.periodo_anual)))].sort((a, b) => Number(b) - Number(a));
    const programas = new Map<string, string>();
    const organizaciones = new Map<string, string>();

    for (const plan of planes) {
      programas.set(String(plan.id_programa), plan.programa.nombre);
      organizaciones.set(String(plan.id_organizacion), plan.organizacion.nombre);
    }

    llenarOpciones(filtroAnio, 'Todos los años', anios.map(anio => ({ valor: anio, etiqueta: anio })), anioAnterior);
    llenarOpciones(
      filtroPrograma,
      'Todos los programas',
      [...programas.entries()].map(([valor, etiqueta]) => ({ valor, etiqueta })).sort((a, b) => a.etiqueta.localeCompare(b.etiqueta, 'es')),
      programaAnterior,
    );
    llenarOpciones(
      filtroOrganizacion,
      'Todas las organizaciones',
      [...organizaciones.entries()].map(([valor, etiqueta]) => ({ valor, etiqueta })).sort((a, b) => a.etiqueta.localeCompare(b.etiqueta, 'es')),
      organizacionAnterior,
    );
  }

  function obtenerFiltrados() {
    return planes.filter(plan =>
      (!filtroAnio.value || String(plan.periodo_anual) === filtroAnio.value) &&
      (!filtroPrograma.value || String(plan.id_programa) === filtroPrograma.value) &&
      (!filtroOrganizacion.value || String(plan.id_organizacion) === filtroOrganizacion.value)
    );
  }

  function actualizarContadores(resultados: PlanListado[]) {
    const estados = resultados.map(plan => obtenerEstado(plan.fecha_inicio, plan.fecha_termino).clave);
    total.textContent = new Intl.NumberFormat('es-CL').format(resultados.length);
    enEjecucion.textContent = new Intl.NumberFormat('es-CL').format(estados.filter(valor => valor === 'ejecucion').length);
    pendientes.textContent = new Intl.NumberFormat('es-CL').format(estados.filter(valor => valor === 'pendiente').length);
  }

  function renderizar() {
    const resultados = obtenerFiltrados();
    listado.replaceChildren();
    actualizarContadores(resultados);

    for (const plan of resultados) {
      const tarjeta = plantilla.content.cloneNode(true) as DocumentFragment;
      tarjeta.querySelector<HTMLElement>('[data-nombre]')!.textContent = plan.nombre;
      tarjeta.querySelector<HTMLElement>('[data-organizacion]')!.textContent = plan.organizacion.nombre;
      tarjeta.querySelector<HTMLElement>('[data-programa]')!.textContent = plan.programa.nombre;
      tarjeta.querySelector<HTMLElement>('[data-anio]')!.textContent = String(plan.periodo_anual);
      tarjeta.querySelector<HTMLElement>('[data-vigencia]')!.textContent = periodo(plan.fecha_inicio, plan.fecha_termino);

      const etiqueta = tarjeta.querySelector<HTMLElement>('[data-estado]')!;
      const calculado = obtenerEstado(plan.fecha_inicio, plan.fecha_termino);
      etiqueta.textContent = calculado.texto;
      etiqueta.classList.add(...calculado.clase.split(' '));

      const enlace = tarjeta.querySelector<HTMLAnchorElement>('[data-detalle]')!;
      enlace.href = `/planes/${encodeURIComponent(plan.id_plan)}`;
      enlace.setAttribute('aria-label', `Ver detalle de ${plan.nombre}`);
      listado.append(tarjeta);
    }

    const hayFiltros = Boolean(filtroAnio.value || filtroPrograma.value || filtroOrganizacion.value);
    limpiarFiltros.disabled = !hayFiltros;
    planesVacio.hidden = resultados.length !== 0;
    if (!resultados.length) {
      planesVacioTitulo.textContent = planes.length ? 'No hay planes que coincidan con los filtros' : 'Todavía no hay planes registrados';
      planesVacioDescripcion.textContent = planes.length
        ? 'Prueba con otros criterios o limpia los filtros para volver a ver todos los planes.'
        : 'Crea el primer plan para comenzar a organizar las intervenciones.';
    }

    estado.textContent = planes.length
      ? `${resultados.length} de ${planes.length} ${planes.length === 1 ? 'plan registrado' : 'planes registrados'}.`
      : 'No hay planes registrados actualmente.';
    listado.setAttribute('aria-busy', 'false');
  }

  async function cargar() {
    const confirmacion = document.querySelector<HTMLElement>('#plan-confirmacion')!;
    const resultado = new URLSearchParams(window.location.search).get('resultado');
    if (resultado === 'guardado' || resultado === 'eliminado') {
      confirmacion.textContent = resultado === 'eliminado' ? 'Plan eliminado correctamente.' : 'Plan guardado correctamente.';
      confirmacion.hidden = false;
      history.replaceState(null, '', '/planes');
    }

    if (cargando) return;
    cargando = true;
    recargar.disabled = true;
    listado.setAttribute('aria-busy', 'true');
    error.hidden = true;
    estado.textContent = 'Cargando planes…';

    try {
      planes = await listarPlanes();
      poblarFiltros();
      renderizar();
    } catch (fallo) {
      estado.textContent = '';
      error.textContent = fallo instanceof Error ? fallo.message : 'No fue posible cargar los planes.';
      error.hidden = false;
    } finally {
      cargando = false;
      recargar.disabled = false;
      listado.setAttribute('aria-busy', 'false');
    }
  }

  filtroAnio.addEventListener('change', renderizar);
  filtroPrograma.addEventListener('change', renderizar);
  filtroOrganizacion.addEventListener('change', renderizar);
  limpiarFiltros.addEventListener('click', () => {
    filtroAnio.value = '';
    filtroPrograma.value = '';
    filtroOrganizacion.value = '';
    renderizar();
  });
  recargar.addEventListener('click', () => void cargar());
  window.addEventListener('pageshow', evento => { if (evento.persisted) void cargar(); });
  void cargar();
</script>
