---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { mainNavItems } from '../config/nav';
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Planes de Intervención" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <span slot="breadcrumb" class="font-medium text-neutral-900">Planes de Intervención</span>

  <section class="space-y-6">
    <p id="plan-confirmacion" hidden role="status" class="rounded-lg border border-primary bg-primary/5 p-4 text-primary"></p>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="mb-1 text-sm font-medium text-primary">Gestión de intervenciones</p>
        <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">Planes de Intervención</h1>
        <p class="mt-1 text-sm text-neutral-500">Consulta y registra planes asociados a organizaciones y programas institucionales.</p>
      </div>
      <Button href="/planes/nuevo">+ Nuevo plan</Button>
    </div>

    <Card>
      <div class="space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-neutral-900">Planes registrados</h2>
          <Button id="recargar-planes" variant="outline">Actualizar listado</Button>
        </div>
        <p id="planes-estado" role="status" aria-live="polite">Cargando planes…</p>
        <p id="planes-error" role="alert" hidden class="rounded-lg bg-red-50 p-4 text-red-800"></p>
        <div id="planes-listado" aria-busy="true" class="grid grid-cols-1 gap-4"></div>
      </div>
    </Card>
  </section>
</AppLayout>

<template id="plantilla-plan">
  <article class="flex flex-col gap-5 rounded-xl border border-neutral-200 bg-white p-5 transition-shadow hover:shadow-sm md:flex-row md:items-center md:justify-between">
    <div class="min-w-0 flex-1 space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h3 class="break-words text-lg font-semibold text-neutral-900"></h3>
        <span data-estado class="inline-flex shrink-0 items-center rounded-full px-3 py-1 text-xs font-medium"></span>
      </div>
      <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
        <div><dt class="mb-1 font-medium text-neutral-500">Organización</dt><dd data-organizacion class="break-words text-neutral-800"></dd></div>
        <div><dt class="mb-1 font-medium text-neutral-500">Programa</dt><dd data-programa class="break-words text-neutral-800"></dd></div>
        <div><dt class="mb-1 font-medium text-neutral-500">Período</dt><dd data-periodo class="text-neutral-800"></dd></div>
      </dl>
    </div>
    <div class="flex shrink-0 justify-end border-t border-neutral-100 pt-3 md:border-l md:border-t-0 md:pl-4 md:pt-0">
      <a class="inline-flex items-center rounded-lg px-4 py-3 font-semibold text-primary hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">Ver detalle →</a>
    </div>
  </article>
</template>

<script>
  import { listarPlanes } from '../lib/planes/cliente';

  const listado = document.querySelector<HTMLElement>('#planes-listado')!;
  const estado = document.querySelector<HTMLElement>('#planes-estado')!;
  const error = document.querySelector<HTMLElement>('#planes-error')!;
  const recargar = document.querySelector<HTMLButtonElement>('#recargar-planes')!;
  let cargando = false;

  function obtenerEstado(inicio: string, termino: string) {
    const hoy = new Date().toISOString().slice(0, 10);
    if (termino < hoy) return { texto: 'Finalizado', clase: 'bg-neutral-100 text-neutral-600' };
    if (inicio > hoy) return { texto: 'Pendiente', clase: 'bg-amber-50 text-amber-700' };
    return { texto: 'En ejecución', clase: 'bg-emerald-50 text-emerald-700' };
  }

  function periodo(inicio: string, termino: string) {
    const desde = inicio.slice(0, 4);
    const hasta = termino.slice(0, 4);
    return desde === hasta ? desde : `${desde}–${hasta}`;
  }

  async function cargar() {
    const confirmacion = document.querySelector<HTMLElement>('#plan-confirmacion')!;
    const resultado = new URLSearchParams(window.location.search).get('resultado');
    if (resultado === 'guardado' || resultado === 'eliminado') {
      confirmacion.textContent = resultado === 'eliminado' ? 'Plan eliminado correctamente.' : 'Plan guardado correctamente.';
      confirmacion.hidden = false;
      history.replaceState(null, '', '/planes');
    }

    if (cargando) return;
    cargando = true;
    recargar.disabled = true;
    listado.setAttribute('aria-busy', 'true');
    listado.replaceChildren();
    error.hidden = true;
    estado.textContent = 'Cargando planes…';

    try {
      const planes = await listarPlanes();
      const plantilla = document.querySelector<HTMLTemplateElement>('#plantilla-plan')!;
      for (const plan of planes) {
        const tarjeta = plantilla.content.cloneNode(true) as DocumentFragment;
        tarjeta.querySelector('h3')!.textContent = plan.nombre;
        tarjeta.querySelector<HTMLElement>('[data-organizacion]')!.textContent = plan.organizacion.nombre;
        tarjeta.querySelector<HTMLElement>('[data-programa]')!.textContent = plan.programa.nombre;
        tarjeta.querySelector<HTMLElement>('[data-periodo]')!.textContent = `${plan.periodo_anual} · ${periodo(plan.fecha_inicio, plan.fecha_termino)}`;
        const etiqueta = tarjeta.querySelector<HTMLElement>('[data-estado]')!;
        const estadoPlan = obtenerEstado(plan.fecha_inicio, plan.fecha_termino);
        etiqueta.textContent = estadoPlan.texto;
        etiqueta.classList.add(...estadoPlan.clase.split(' '));
        const enlace = tarjeta.querySelector<HTMLAnchorElement>('a')!;
        enlace.href = `/planes/${encodeURIComponent(plan.id_plan)}`;
        enlace.setAttribute('aria-label', `Ver detalle de ${plan.nombre}`);
        listado.append(tarjeta);
      }
      estado.textContent = planes.length
        ? `${planes.length} ${planes.length === 1 ? 'plan registrado' : 'planes registrados'}.`
        : 'No hay planes registrados actualmente. Usa “Nuevo plan” para crear el primero.';
    } catch (fallo) {
      estado.textContent = '';
      error.textContent = fallo instanceof Error ? fallo.message : 'No fue posible cargar los planes.';
      error.hidden = false;
    } finally {
      cargando = false;
      recargar.disabled = false;
      listado.setAttribute('aria-busy', 'false');
    }
  }

  recargar.addEventListener('click', cargar);
  window.addEventListener('pageshow', evento => { if (evento.persisted) void cargar(); });
  void cargar();
</script>
