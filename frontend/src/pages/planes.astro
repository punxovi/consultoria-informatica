
---
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

// Datos temporales para desarrollar y revisar la interfaz.
// Posteriormente serán reemplazados por la integración con el backend.
const planesDemo = [
  {
    id: 'demo-1',
    nombre: 'Plan de intervención 2026',
    organizacion: 'Organización de ejemplo',
    programa: 'Programa institucional de ejemplo',
    periodo: '2026',
    estado: 'En ejecución',
  },
  {
    id: 'demo-2',
    nombre: 'Plan de apoyo comunitario',
    organizacion: 'Comedor de ejemplo',
    programa: 'Programa institucional de ejemplo',
    periodo: '2026',
    estado: 'Pendiente',
  },
  {
    id: 'demo-3',
    nombre: 'Plan de fortalecimiento organizacional',
    organizacion: 'Fundación de ejemplo',
    programa: 'Programa institucional de ejemplo',
    periodo: '2026',
    estado: 'Finalizado',
  },
];
---

<AppLayout
  title="Planes de Intervención"
  navItems={mainNavItems}
  allowedRoles={['ADMIN', 'COORD']}
>
  <span slot="breadcrumb" class="font-medium text-neutral-900">
    Planes de Intervención
  </span>

  <section class="space-y-6">
    <!-- Encabezado -->
    <div>
      <p class="mb-1 text-sm font-medium text-primary">
        Gestión de intervenciones
      </p>

      <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
        Planes de Intervención
      </h1>

      <p class="mt-1 text-sm text-neutral-500">
        Consulta los planes registrados y revisa sus organizaciones,
        programas, períodos y estados.
      </p>
    </div>

    <!-- Listado -->
    <Card>
      <div class="space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold text-neutral-900">
              Planes registrados
            </h2>

            <p class="mt-1 text-sm text-neutral-500">
              {planesDemo.length}
              {planesDemo.length === 1 ? 'plan disponible' : 'planes disponibles'}
            </p>
          </div>
        </div>

        <!-- Lista de planes -->
        {
          planesDemo.length > 0 ? (
            <div class="grid grid-cols-1 gap-4">
              {planesDemo.map((plan) => (
                <article
                  class="flex flex-col gap-5 rounded-xl border border-neutral-200 bg-white p-5 transition-shadow hover:shadow-sm md:flex-row md:items-center md:justify-between"
                >
                  <div class="min-w-0 flex-1 space-y-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <h3 class="break-words text-lg font-semibold text-neutral-900">
                        {plan.nombre}
                      </h3>

                      <span
                        class:list={[
                          'inline-flex shrink-0 items-center rounded-full px-3 py-1 text-xs font-medium',
                          plan.estado === 'En ejecución'
                            ? 'bg-emerald-50 text-emerald-700'
                            : plan.estado === 'Finalizado'
                              ? 'bg-neutral-100 text-neutral-600'
                              : 'bg-amber-50 text-amber-700',
                        ]}
                      >
                        {plan.estado}
                      </span>
                    </div>

                    <dl class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2 lg:grid-cols-3">
                      <div class="min-w-0">
                        <dt class="mb-1 font-medium text-neutral-500">
                          Organización
                        </dt>
                        <dd class="break-words text-neutral-800">
                          {plan.organizacion}
                        </dd>
                      </div>

                      <div class="min-w-0">
                        <dt class="mb-1 font-medium text-neutral-500">
                          Programa
                        </dt>
                        <dd class="break-words text-neutral-800">
                          {plan.programa}
                        </dd>
                      </div>

                      <div>
                        <dt class="mb-1 font-medium text-neutral-500">
                          Período
                        </dt>
                        <dd class="text-neutral-800">
                          {plan.periodo}
                        </dd>
                      </div>
                    </dl>
                  </div>

                  <div class="flex shrink-0 justify-end border-t border-neutral-100 pt-3 md:border-l md:border-t-0 md:pl-4 md:pt-0">
                    <a
                      href={`/planes/${encodeURIComponent(plan.id)}`}
                      aria-label={`Ver detalle de ${plan.nombre}`}
                      class="mt-5 inline-flex items-center self-end rounded-lg px-4 py-3 font-semibold text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      Ver detalle →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div
              role="status"
              class="rounded-xl border border-dashed border-neutral-300 px-5 py-12 text-center"
            >
              <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-neutral-100">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-neutral-500"
                  aria-hidden="true"
                >
                  <path d="M8 6h13" />
                  <path d="M8 12h13" />
                  <path d="M8 18h13" />
                  <path d="M3 6h.01" />
                  <path d="M3 12h.01" />
                  <path d="M3 18h.01" />
                </svg>
              </div>

              <h3 class="font-semibold text-neutral-900">
                No hay planes registrados
              </h3>

              <p class="mt-1 text-sm text-neutral-500">
                Actualmente no existen planes de intervención para mostrar.
              </p>
            </div>
          )
        }
      </div>
    </Card>
  </section>
</AppLayout>