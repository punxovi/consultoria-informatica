---
// frontend/src/pages/dashboard.astro
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import { mainNavItems } from '../config/nav';
---

<AppLayout title="Dashboard General" navItems={mainNavItems}>
  <Fragment slot="actions">
    <div class="flex items-center gap-3">
      <button class="p-2 rounded-full border border-neutral-200 bg-white hover:bg-neutral-50 transition-colors" aria-label="Buscar">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button class="p-2 rounded-full border border-neutral-200 bg-white hover:bg-neutral-50 transition-colors" aria-label="Notificaciones">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
      </button>
      <div class="w-8 h-8 rounded-full bg-[#4f428c] text-white flex items-center justify-center font-bold text-xs">
        MC
      </div>
    </div>
  </Fragment>

  <Fragment slot="breadcrumb">
    <span>Chile</span>
    <span>&rsaquo;</span>
    <span class="text-neutral-900 font-medium">Dashboard General</span>
  </Fragment>

  <!-- Banner Superior de Bienvenida -->
  <section class="bg-gradient-to-r from-[#2c2552] to-[#4f428c] text-white rounded-2xl p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-6 shadow-sm">
    <div>
      <span class="text-[10px] uppercase tracking-widest opacity-80 font-semibold">COORDINADORA REGIONAL — CHILE</span>
      <h1 class="text-2xl md:text-3xl font-bold mt-1">Buenos días, María</h1>
      <p class="text-xs md:text-sm opacity-90 mt-1">Jueves 4 de septiembre, 2024</p>
    </div>
    <div class="flex gap-6 text-center border-t md:border-t-0 md:border-l border-white/20 pt-4 md:pt-0 md:pl-6 w-full md:w-auto justify-around md:justify-start">
      <div>
        <strong class="text-xl md:text-2xl block font-bold">0</strong>
        <small class="text-[9px] tracking-wider opacity-80 uppercase">ORGANIZACIONES</small>
      </div>
      <div>
        <strong class="text-xl md:text-2xl block font-bold">0</strong>
        <small class="text-[9px] tracking-wider opacity-80 uppercase">PLANES ACTIVOS</small>
      </div>
      <div>
        <strong class="text-xl md:text-2xl block font-bold">0</strong>
        <small class="text-[9px] tracking-wider opacity-80 uppercase">ALERTAS</small>
      </div>
    </div>
  </section>

  <!-- Selector de Países -->
  <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
    <button class="px-4 py-2 bg-white border border-[#4f428c] text-[#4f428c] font-semibold rounded-lg text-sm shadow-sm">CL Chile</button>
    <button class="px-4 py-2 bg-white border border-neutral-200 text-neutral-600 rounded-lg text-sm hover:bg-neutral-100 transition-colors">AR Argentina</button>
    <button class="px-4 py-2 bg-white border border-neutral-200 text-neutral-600 rounded-lg text-sm hover:bg-neutral-100 transition-colors">UY Uruguay</button>
  </div>

  <h3 class="text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-3">Métricas Clave</h3>

  <!-- Tarjetas de Métricas Principales (Vacías / En espera de datos) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

    <Card class="border-t-4 border-t-[#4f428c]">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Organizaciones</span>
          <div class="text-3xl font-bold text-neutral-900 mt-1">0</div>
        </div>
        <div class="p-2 bg-[#f3f0fc] rounded-lg text-[#4f428c]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0H5m14 0h2m-16 0H3m2 0h12M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
      </div>
      <div class="text-xs font-medium text-neutral-400 mt-3">
        Sin registros recientes
      </div>
    </Card>

    <Card class="border-t-4 border-t-[#4f428c]">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Planes Activos</span>
          <div class="text-3xl font-bold text-neutral-900 mt-1">0</div>
        </div>
        <div class="p-2 bg-[#f3f0fc] rounded-lg text-[#4f428c]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
      </div>
      <div class="text-xs font-medium text-neutral-400 mt-3">
        Sin registros recientes
      </div>
    </Card>

    <Card class="border-t-4 border-t-[#4f428c]">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Beneficiarios</span>
          <div class="text-3xl font-bold text-neutral-900 mt-1">0</div>
        </div>
        <div class="p-2 bg-[#f3f0fc] rounded-lg text-[#4f428c]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
      </div>
      <div class="text-xs font-medium text-neutral-400 mt-3">
        Sin registros recientes
      </div>
    </Card>

    <Card class="border-t-4 border-t-neutral-300">
      <div class="flex justify-between items-start">
        <div>
          <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider">Alertas Activas</span>
          <div class="text-3xl font-bold text-neutral-900 mt-1">0</div>
        </div>
        <div class="p-2 bg-neutral-100 rounded-lg text-neutral-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
      </div>
      <div class="text-xs font-medium text-neutral-400 mt-3">
        Sin alertas pendientes
      </div>
    </Card>

  </div>

  <!-- Sección Intermedia: Avance general y Alertas -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

    <Card class="lg:col-span-2">
      <h3 class="text-sm font-bold text-neutral-800 mb-4">Avance general del período</h3>
      <div class="flex flex-col sm:flex-row items-center justify-around py-4 gap-6">

        <div class="relative w-32 h-32 rounded-full flex flex-col items-center justify-center bg-[conic-gradient(#e5e7eb_0%_100%)] shadow-inner">
          <div class="absolute w-24 h-24 bg-white rounded-full flex flex-col items-center justify-center">
            <span class="text-xl font-bold text-neutral-900">0%</span>
            <span class="text-[9px] text-neutral-500 uppercase font-semibold tracking-wider">Avance</span>
          </div>
        </div>

        <div class="text-center sm:text-left flex flex-col gap-2">
          <p class="text-sm text-neutral-600">0 de 0 planes completados</p>
          <div>
            <Badge variant="neutral">Sin datos</Badge>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 text-center border-t border-neutral-100 pt-4 mt-2">
        <div>
          <strong class="text-base block text-neutral-900 font-bold">0</strong>
          <span class="text-[10px] text-neutral-500 uppercase tracking-wider">Cumplidos</span>
        </div>
        <div class="border-l border-neutral-100">
          <strong class="text-base block text-neutral-900 font-bold">0</strong>
          <span class="text-[10px] text-neutral-500 uppercase tracking-wider">Vencidos</span>
        </div>
      </div>
    </Card>

    <Card>
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-sm font-bold text-neutral-800">Alertas y Tareas</h3>
        <a href="#ver-todo" class="text-xs font-medium text-[#4f428c] hover:underline">Ver todo</a>
      </div>

      <div class="flex flex-col items-center justify-center py-10 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-neutral-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <p class="text-xs text-neutral-500 font-medium">No hay alertas registradas</p>
      </div>
    </Card>

  </div>

  <!-- Sección Inferior: Acciones por mes -->
  <Card>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-2">
      <div>
        <h3 class="text-sm font-bold text-neutral-800">Acciones por mes</h3>
        <p class="text-xs text-neutral-500">Ene – Sep 2024</p>
      </div>
      <div class="flex items-center gap-4 text-xs text-neutral-600">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-[#4f428c]"></span>
          <span>Completadas</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
          <span>Pendientes</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-9 gap-3 pt-4 pb-2 items-end h-40 border-b border-neutral-100">
      {['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'].map((mes) => (
        <div class="flex flex-col items-center h-full justify-end gap-1">
          <div class="w-full bg-neutral-100 rounded-t-md h-[15%]"></div>
          <span class="text-[11px] text-neutral-500 mt-2">{mes}</span>
        </div>
      ))}
    </div>
    <div class="text-center pt-3">
      <span class="text-xs text-neutral-400 italic">Esperando conexión a base de datos para renderizar métricas mensuales...</span>
    </div>
  </Card>
</AppLayout>
