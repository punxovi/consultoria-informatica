---
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { mainNavItems } from '../config/nav';

const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'];
---

<AppLayout title="Dashboard General" navItems={mainNavItems}>
  <Fragment slot="actions">
    <div class="flex items-center gap-3">
      <button
        class="icon-button"
        aria-label="Buscar"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
      </button>

      <button
        class="icon-button"
        aria-label="Notificaciones"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0 1 18 14.158V11a6.002 6.002 0 0 0-4-5.659V5a2 2 0 1 0-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 1 1-6 0v-1m6 0H9" />
        </svg>
      </button>

      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-xs font-bold text-white">
        MC
      </div>
    </div>
  </Fragment>

  <Fragment slot="breadcrumb">
    <span>Chile</span>
    <span>›</span>
    <span class="font-medium text-neutral-900">Dashboard General</span>
  </Fragment>

  <section class="mb-6 flex flex-col justify-between gap-6 rounded-2xl bg-gradient-to-r from-secondary to-primary p-6 text-white shadow-sm md:flex-row md:items-center md:p-8">
    <div>
      <span class="text-[10px] font-semibold uppercase tracking-widest opacity-80">
        COORDINADORA REGIONAL — CHILE
      </span>
      <h1 class="mt-1 text-2xl font-bold md:text-3xl">Buenos días, María</h1>
      <p class="mt-1 text-xs opacity-90 md:text-sm">Jueves 4 de septiembre, 2024</p>
    </div>

    <div class="flex w-full justify-around gap-6 border-t border-white/20 pt-4 text-center md:w-auto md:justify-start md:border-l md:border-t-0 md:pl-6 md:pt-0">
      <div>
        <strong class="block text-xl font-bold md:text-2xl">0</strong>
        <small class="text-[9px] uppercase tracking-wider opacity-80">Organizaciones</small>
      </div>
      <div>
        <strong class="block text-xl font-bold md:text-2xl">0</strong>
        <small class="text-[9px] uppercase tracking-wider opacity-80">Planes activos</small>
      </div>
      <div>
        <strong class="block text-xl font-bold md:text-2xl">0</strong>
        <small class="text-[9px] uppercase tracking-wider opacity-80">Alertas</small>
      </div>
    </div>
  </section>

  <div class="mb-6 flex gap-2 overflow-x-auto pb-2">
    <Button variant="outline" size="sm">CL Chile</Button>
    <Button variant="ghost" size="sm" class="text-neutral-600 hover:bg-neutral-100">AR Argentina</Button>
    <Button variant="ghost" size="sm" class="text-neutral-600 hover:bg-neutral-100">UY Uruguay</Button>
  </div>

  <h2 class="mb-3 text-[11px] font-bold uppercase tracking-wider text-neutral-500">
    Métricas clave
  </h2>

  <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <Card class="border-t-4 border-t-primary p-5">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Organizaciones</span>
          <strong class="mt-1 block text-3xl font-bold text-neutral-900">0</strong>
        </div>
        <div class="rounded-lg bg-primary/10 p-2 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0H5m14 0h2m-16 0H3m2 0h12M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5m-4 0h4" />
          </svg>
        </div>
      </div>
      <span class="mt-3 block text-xs font-medium text-neutral-400">Sin registros recientes</span>
    </Card>

    <Card class="border-t-4 border-t-primary p-5">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Planes activos</span>
          <strong class="mt-1 block text-3xl font-bold text-neutral-900">0</strong>
        </div>
        <div class="rounded-lg bg-primary/10 p-2 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
          </svg>
        </div>
      </div>
      <span class="mt-3 block text-xs font-medium text-neutral-400">Sin registros recientes</span>
    </Card>

    <Card class="border-t-4 border-t-primary p-5">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Beneficiarios</span>
          <strong class="mt-1 block text-3xl font-bold text-neutral-900">0</strong>
        </div>
        <div class="rounded-lg bg-primary/10 p-2 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 0 0-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 0 1 5.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 0 1 9.288 0M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM7 10a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
          </svg>
        </div>
      </div>
      <span class="mt-3 block text-xs font-medium text-neutral-400">Sin registros recientes</span>
    </Card>

    <Card class="border-t-4 border-t-neutral-300 p-5">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Alertas activas</span>
          <strong class="mt-1 block text-3xl font-bold text-neutral-900">0</strong>
        </div>
        <div class="rounded-lg bg-neutral-100 p-2 text-neutral-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3Z" />
          </svg>
        </div>
      </div>
      <span class="mt-3 block text-xs font-medium text-neutral-400">Sin alertas pendientes</span>
    </Card>
  </div>

  <div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <Card class="lg:col-span-2">
      <h3 class="mb-4 text-sm font-bold text-neutral-800">Avance general del período</h3>

      <div class="flex flex-col items-center justify-around gap-6 py-4 sm:flex-row">
        <div class="relative flex h-32 w-32 flex-col items-center justify-center rounded-full bg-[conic-gradient(#e5e7eb_0%_100%)] shadow-inner">
          <div class="absolute flex h-24 w-24 flex-col items-center justify-center rounded-full bg-white">
            <span class="text-xl font-bold text-neutral-900">0%</span>
            <span class="text-[9px] font-semibold uppercase tracking-wider text-neutral-500">Avance</span>
          </div>
        </div>

        <div class="flex flex-col gap-2 text-center sm:text-left">
          <p class="text-sm text-neutral-600">0 de 0 planes completados</p>
          <Badge variant="neutral">Sin datos</Badge>
        </div>
      </div>

      <div class="mt-2 grid grid-cols-2 border-t border-neutral-100 pt-4 text-center">
        <div>
          <strong class="block text-base font-bold text-neutral-900">0</strong>
          <span class="text-[10px] uppercase tracking-wider text-neutral-500">Cumplidos</span>
        </div>
        <div class="border-l border-neutral-100">
          <strong class="block text-base font-bold text-neutral-900">0</strong>
          <span class="text-[10px] uppercase tracking-wider text-neutral-500">Vencidos</span>
        </div>
      </div>
    </Card>

    <Card>
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-sm font-bold text-neutral-800">Alertas y Tareas</h3>
        <a href="#ver-todo" class="text-xs font-medium text-primary hover:underline">Ver todo</a>
      </div>

      <div class="flex flex-col items-center justify-center py-10 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mb-2 h-10 w-10 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" />
        </svg>
        <p class="text-xs font-medium text-neutral-500">No hay alertas registradas</p>
      </div>
    </Card>
  </div>

  <Card>
    <div class="mb-6 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
      <div>
        <h3 class="text-sm font-bold text-neutral-800">Acciones por mes</h3>
        <p class="text-xs text-neutral-500">Ene – Sep 2024</p>
      </div>

      <div class="flex items-center gap-4 text-xs text-neutral-600">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-primary"></span>
          <span>Completadas</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span>Pendientes</span>
        </div>
      </div>
    </div>

    <div class="grid h-40 grid-cols-3 items-end gap-3 border-b border-neutral-100 pb-2 pt-4 sm:grid-cols-9">
      {meses.map((mes) => (
        <div class="flex h-full flex-col items-center justify-end gap-1">
          <div class="h-[15%] w-full rounded-t-md bg-neutral-100"></div>
          <span class="mt-2 text-[11px] text-neutral-500">{mes}</span>
        </div>
      ))}
    </div>

    <div class="pt-3 text-center">
      <span class="text-xs italic text-neutral-400">
        Esperando conexión a base de datos para renderizar métricas mensuales...
      </span>
    </div>
  </Card>
</AppLayout>

<style>
  .icon-button {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-neutral-200);
    border-radius: 9999px;
    background: white;
    color: var(--color-neutral-600);
    transition: background-color .2s, color .2s;
  }

  .icon-button:hover {
    background: var(--color-neutral-50);
    color: var(--color-primary);
  }
</style>