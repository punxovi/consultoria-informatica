---
import Icono from '../components/ui/Icono.astro';
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import {mainNavItems} from '../config/nav';
---
<AppLayout title="Solicitudes de cotización" navItems={mainNavItems} allowedRoles={['ADMIN','COORD']}>
 <Fragment slot="headerBreadcrumb"><span class="text-sm font-semibold">Solicitudes de cotización</span></Fragment>
 <section id="solicitudes" class="space-y-6">
  <header class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-medium text-primary">Cotización</p><h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">Solicitudes de cotización</h1><p class="mt-2 text-neutral-600">Revisa las solicitudes recibidas y gestiona su estado dentro de tu alcance territorial.</p></div></header>
  <div class="grid gap-4 sm:grid-cols-3">{[['total','Recibidas','acento-morado'],['nuevas','Nuevas','acento-amarillo'],['gestionadas','Gestionadas','acento-verde']].map(([id,titulo,color])=><Card class={`tarjeta-acento ${color} p-5`}><p class="text-sm text-neutral-600">{titulo}</p><p id={`sol-${id}`} class="mt-2 text-3xl font-bold">—</p></Card>)}</div>
  <Card class="p-4 md:p-5">
      <div class="mb-4 flex items-start gap-3">
        <span class="rounded-xl bg-primary/10 p-2.5 text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16M7 12h10m-7 7h4" /></svg></span>
        <div>
          <h2 class="text-lg font-semibold text-neutral-900">Filtrar solicitudes</h2>
          <p class="mt-1 text-sm text-neutral-500">Muestra las solicitudes según su estado.</p>
        </div>
      </div>
   <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-3">
    <div class="min-w-0 space-y-1.5">
     <label for="sol-filtro" class="block text-sm font-medium text-neutral-800">Estado de la solicitud</label>
     <select id="sol-filtro" class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary"><option value="todas">Todas las solicitudes</option><option value="nuevas">Nuevas</option><option value="en_gestion">En gestión</option><option value="cotizada">Cotizadas</option><option value="cerrada">Cerradas</option><option value="rechazada">Rechazadas</option><option value="gestionadas">Todas las gestionadas (no nuevas)</option></select>
    </div>
   </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
        <p id="sol-carga" role="status" aria-live="polite" class="text-sm text-neutral-500"></p>
        <Button id="sol-limpiar" type="button" variant="outline" disabled>
          <Icono nombre="limpiar" />
          Limpiar filtros
        </Button>
      </div>
  </Card>
  <p id="sol-confirmacion" hidden role="status" class="rounded-xl border border-success/30 bg-success/10 p-4"></p>
  <div id="sol-error" hidden role="alert" class="rounded-xl border border-danger/30 bg-white p-5"><p id="sol-error-texto"></p><Button id="sol-reintentar" variant="outline" size="lg" class="mt-3">Reintentar</Button></div>
  <div id="sol-lista" aria-busy="false" class="grid gap-4 lg:grid-cols-2"></div>
  <dialog id="sol-dialogo" aria-labelledby="sol-titulo" class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-2xl border border-[#DCD8EA] p-5 backdrop:bg-black/40 md:p-7">
   <div class="flex items-start justify-between gap-3"><h2 id="sol-titulo" class="text-2xl font-bold">Detalle de solicitud</h2><Button id="sol-cerrar" variant="outline" size="lg">Cerrar</Button></div>
   <p id="sol-detalle-carga" role="status" class="my-4 text-neutral-600"></p>
   <div id="sol-detalle-error" hidden role="alert" class="my-4 text-danger"></div>
   <div id="sol-detalle" class="mt-4 space-y-4"></div>
   <section id="sol-evidencias" hidden class="mt-6 space-y-3 border-t border-[#DCD8EA] pt-5" aria-labelledby="sol-evidencias-titulo">
    <div><h3 id="sol-evidencias-titulo" class="text-lg font-semibold">Evidencia de la solicitud</h3><p class="mt-1 text-sm text-neutral-600">Adjunta imágenes, PDF o documentos Word (máximo 20 MB por archivo).</p></div>
    <form id="sol-evidencia-form" class="flex flex-wrap items-end gap-3">
     <div class="min-w-0 flex-1"><label for="sol-evidencia-archivo" class="mb-1 block text-sm font-medium">Archivo</label><input id="sol-evidencia-archivo" type="file" accept="image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required class="block min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-white p-2 text-sm" /></div>
     <Button id="sol-evidencia-subir" type="submit" variant="outline" size="lg">Agregar evidencia</Button>
    </form>
    <p id="sol-evidencia-mensaje" role="status" aria-live="polite" class="text-sm text-neutral-600"></p>
    <ul id="sol-evidencia-lista" class="space-y-2"></ul>
   </section>
   <form id="sol-form" hidden class="mt-6 space-y-3 border-t border-[#DCD8EA] pt-5">
    <label for="sol-estado" class="block font-semibold">Actualizar estado</label>
    <select id="sol-estado" aria-describedby="sol-estado-error" class="min-h-12 w-full rounded-xl border border-[#DCD8EA] bg-white px-3"></select>
    <p id="sol-estado-error" hidden role="alert" class="text-sm text-danger"></p>
    <Button id="sol-guardar" type="submit" size="lg">Guardar estado</Button>
   </form>
   <p id="sol-solo-lectura" hidden class="mt-4 text-neutral-600">No hay cambios de estado autorizados para esta solicitud.</p>
  </dialog>
 </section>
</AppLayout>
<script>
 import {iniciarSolicitudes} from '../lib/solicitudes-cotizacion/interfaz';
 void iniciarSolicitudes();
</script>
