---
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

const programas = [
  {
    id: '1',
    nombre: 'Formalización',
    objetivo:
      'Fortalecimiento de la gestión y regularización de organizaciones.',
  },
  {
    id: '2',
    nombre: 'Espacios con Valor',
    objetivo:
      'Mejora y recuperación de espacios comunitarios.',
  },
  {
    id: '3',
    nombre: 'Referentes al Frente',
    objetivo:
      'Formación y fortalecimiento de liderazgos comunitarios.',
  },
  {
    id: '4',
    nombre: 'Una Vuelta +',
    objetivo:
      'Iniciativas de acompañamiento y participación comunitaria.',
  },
  {
    id: '5',
    nombre: 'Alimentación Saludable',
    objetivo:
      'Promoción de alimentación y bienestar en comunidades.',
  },
  {
    id: '6',
    nombre: 'Gestión y Formación',
    objetivo:
      'Capacitación para equipos y mejora de la gestión institucional.',
  },
];
---

<AppLayout
  title="Programas Institucionales"
  navItems={mainNavItems}
  allowedRoles={['ADMIN', 'COORD']}
>
  <Fragment slot="breadcrumb">
    <span>Chile</span>
    <span>&rsaquo;</span>
    <span class="font-medium text-neutral-900">
      Programas Institucionales
    </span>
  </Fragment>

  <section class="space-y-6">
    <div>
      <p class="mb-1 text-sm font-medium text-primary">
        Gestión institucional
      </p>

      <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
        Programas Institucionales
      </h1>

      <p class="mt-1 text-sm text-neutral-500">
        Gestión de los programas institucionales de la fundación.
      </p>
    </div>

    <Card>
      <div class="space-y-5">
        <div>
          <h2 class="text-lg font-semibold text-neutral-900">
            Programas registrados
          </h2>

          <p class="mt-1 text-sm text-neutral-500">
            Consulta los programas institucionales disponibles.
          </p>
        </div>

        {programas.length === 0 && (
          <div
            class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center"
          >
            <p class="text-sm font-medium text-neutral-700">
              No hay programas registrados actualmente.
            </p>

            <p class="mt-1 text-sm text-neutral-500">
              Los programas institucionales aparecerán aquí.
            </p>
          </div>
        )}

        {programas.length > 0 && (
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {programas.map((programa) => (
              <Card class="!p-5">
                <div class="flex h-full flex-col">
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-neutral-900">
                      {programa.nombre}
                    </h3>

                    <p class="mt-3 text-sm leading-6 text-neutral-600">
                      {programa.objetivo}
                    </p>
                  </div>

                  <div class="mt-5 border-t border-neutral-200 pt-4">
                    <div class="flex justify-end">
                      <Button
                        variant="ghost"
                        size="md"
                        href={`/programas/${programa.id}`}
                      >
                        Ver detalle →
                      </Button>
                    </div>
                  </div>
                </div>
              </Card>
            ))}
          </div>
        )}
      </div>
    </Card>
  </section>
</AppLayout>