---
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
---

<AppLayout title="Programas Institucionales" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <span slot="breadcrumb" class="font-medium text-neutral-900">Programas Institucionales</span>
  <section class="space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="mb-1 text-sm font-medium text-primary">Gestión institucional</p>
        <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">Programas Institucionales</h1>
        <p class="mt-1 text-sm text-neutral-500">Catálogo de programas institucionales de FGE, disponible para todas las organizaciones.</p>
      </div>
      <div id="crear-programa-panel" hidden><Button href="/programas/nuevo">Crear programa</Button></div>
    </div>
    <Card>
      <div class="space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">Programas registrados</h2>
          <Button id="recargar-programas" variant="outline">Actualizar listado</Button>
        </div>
        <p id="programas-estado" role="status" aria-live="polite">Cargando programas…</p>
        <p id="programas-error" role="alert" hidden class="rounded-lg bg-red-50 p-4 text-red-800"></p>
        <div id="programas-listado" aria-busy="true" class="grid grid-cols-1 gap-5 md:grid-cols-2"></div>
      </div>
    </Card>
  </section>
</AppLayout>

<template id="plantilla-programa">
  <article class="flex flex-col rounded-xl border border-neutral-200 bg-white p-5">
    <h3 class="text-lg font-semibold text-neutral-900 break-words"></h3>
    <p class="mt-3 flex-1 whitespace-pre-wrap break-words text-sm leading-6 text-neutral-600"></p>
    <a class="mt-5 self-end rounded-lg px-4 py-3 font-semibold text-primary hover:bg-primary/10 focus-visible:ring-2 focus-visible:ring-primary">Ver detalle →</a>
  </article>
</template>

<script>
  import { listarProgramas } from '../lib/programas/cliente';
  import { getUserRoles } from '../lib/supabase';
  const listado = document.querySelector<HTMLElement>('#programas-listado')!;
  const estado = document.querySelector<HTMLElement>('#programas-estado')!;
  const error = document.querySelector<HTMLElement>('#programas-error')!;
  const recargar = document.querySelector<HTMLButtonElement>('#recargar-programas')!;
  let cargando = false;
  async function cargar() {
    if (cargando) return;
    cargando = true; recargar.disabled = true; listado.setAttribute('aria-busy', 'true');
    listado.replaceChildren(); error.hidden = true; estado.textContent = 'Cargando programas…';
    try {
      const programas = await listarProgramas();
      const plantilla = document.querySelector<HTMLTemplateElement>('#plantilla-programa')!;
      for (const programa of programas) {
        const tarjeta = plantilla.content.cloneNode(true) as DocumentFragment;
        tarjeta.querySelector('h3')!.textContent = programa.nombre;
        tarjeta.querySelector('p')!.textContent = programa.objetivo_general;
        const enlace = tarjeta.querySelector('a')!;
        enlace.href = `/programas/${encodeURIComponent(programa.id_programa)}`;
        enlace.setAttribute('aria-label', `Ver detalle de ${programa.nombre}`);
        listado.append(tarjeta);
      }
      estado.textContent = programas.length ? `${programas.length} programas registrados.` : 'No hay programas registrados actualmente.';
    } catch (fallo) {
      estado.textContent = '';
      error.textContent = fallo instanceof Error ? fallo.message : 'No fue posible cargar los programas.';
      error.hidden = false;
    } finally {
      cargando = false; recargar.disabled = false; listado.setAttribute('aria-busy', 'false');
    }
  }
  recargar.addEventListener('click', cargar);
  window.addEventListener('pageshow', evento => { if (evento.persisted) void cargar(); });
  void cargar();
  void getUserRoles().then(roles => {
    document.querySelector<HTMLElement>('#crear-programa-panel')!.hidden = !roles.some(rol => rol.codigo === 'ADMIN');
  }).catch(() => {});
</script>
