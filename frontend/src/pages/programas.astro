---
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
---
<AppLayout title="Programas Institucionales" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>
  <section class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div><p class="text-sm font-medium text-primary">Gestión institucional</p><h1 class="mt-1 text-2xl font-bold md:text-3xl">Programas Institucionales</h1><p class="mt-2 text-neutral-700">Consulta los programas institucionales de FGE.</p></div>
      <div id="crear-programa-enlace" hidden><Button href="/programas/nuevo">Crear programa</Button></div>
    </div>
    <Card><p id="catalogo-estado" role="status">Cargando programas…</p><div id="catalogo-programas" class="grid grid-cols-1 gap-5 md:grid-cols-2"></div></Card>
  </section>
</AppLayout>
<template id="programa-tarjeta">
  <article class="flex flex-col rounded-xl border border-neutral-200 p-5">
    <h2 class="text-lg font-semibold"></h2><p class="mt-3 flex-1 whitespace-pre-line break-words text-neutral-700"></p>
    <a class="mt-5 inline-flex min-h-[48px] items-center justify-end font-medium text-primary underline">Ver detalle →</a>
  </article>
</template>
<script>
  import { listarProgramas } from '../lib/programas/cliente';
  import { getUserRoles } from '../lib/supabase';
  async function cargar() {
    const estado = document.querySelector('#catalogo-estado')!;
    try {
      const roles = await getUserRoles();
      if (roles.some(rol => rol.codigo === 'ADMIN')) document.querySelector<HTMLElement>('#crear-programa-enlace')!.hidden = false;
      const programas = await listarProgramas();
      const contenedor = document.querySelector('#catalogo-programas')!;
      const plantilla = document.querySelector<HTMLTemplateElement>('#programa-tarjeta')!;
      for (const programa of programas) {
        const fragmento = plantilla.content.cloneNode(true) as DocumentFragment;
        fragmento.querySelector('h2')!.textContent = programa.nombre;
        fragmento.querySelector('p')!.textContent = programa.objetivo_general;
        fragmento.querySelector('a')!.href = `/programas/${encodeURIComponent(programa.id_programa)}`;
        contenedor.append(fragmento);
      }
      estado.textContent = programas.length ? '' : 'No hay programas registrados.';
    } catch (error) { estado.textContent = error instanceof Error ? error.message : 'No se pudieron consultar los programas.'; }
  }
  void cargar();
</script>
