---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { mainNavItems } from '../config/nav';
import AppLayout from '../layouts/AppLayout.astro';

const contenido = [
  { titulo: 'Organizaciones y beneficiarios', acento: 'border-l-primary' },
  { titulo: 'Planes y Acciones', acento: 'border-l-brand-green' },
  { titulo: 'Acciones ejecutadas y Compromisos cumplidos', acento: 'border-l-brand-yellow' },
  { titulo: 'Donaciones y recursos', acento: 'border-l-primary' },
  { titulo: 'Indicadores y resultados obtenidos', acento: 'border-l-brand-green' },
];
---

<AppLayout title="Reportes" navItems={mainNavItems}>
  <Fragment slot="headerBreadcrumb">
    <span class="text-sm font-semibold text-neutral-900">Reportes</span>
  </Fragment>

  <section class="space-y-6">
    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary">Rendición de cuentas</p>
        <h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">Reportes</h1>
        <p class="mt-2 max-w-2xl text-sm text-neutral-500">
          Genera reportes consolidados sobre las intervenciones registradas, filtrados por período, país, organización y programa.
        </p>
      </div>
      <Button href="/reportes/nuevo" class="shrink-0" id="nuevo-reporte">
        <span aria-hidden="true">+</span> Nuevo reporte
      </Button>
    </header>

    <Card class="p-4 md:p-5">
      <h2 class="text-lg font-semibold text-neutral-900">Qué incluye un reporte</h2>
      <p class="mt-1 text-sm text-neutral-500">El reporte consolida, según los filtros que elijas:</p>
      <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {contenido.map((item) => (
          <li class:list={['rounded-xl border border-neutral-200 border-l-4 bg-white p-3 text-sm font-medium text-neutral-800', item.acento]}>
            {item.titulo}
          </li>
        ))}
      </ul>
      <p class="mt-4 rounded-lg bg-[#F0EEF9] px-3 py-2 text-sm text-[#423C76]">
        Los reportes para donantes u organismos externos incluyen solo información agregada.
      </p>
    </Card>
  </section>
</AppLayout>
