---
// TEMPORAL: simulación de la portada de fundaciongestionar.org para mostrar cómo quedarían
// los accesos a la plataforma interna y al catálogo. Quitar cuando estén en el sitio real.
import SimulacionLayout from '../layouts/SimulacionLayout.astro';
import { programasSimulacion, RUTA_PROGRAMAS_SIMULACION } from '../lib/simulacion/programas';
---

<SimulacionLayout title="Simulación sitio Fundación Gestionar Esperanzas" actual="inicio">
  <!-- Portada -->
  <section class="relative overflow-hidden bg-[#4C4688] text-white">
    <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[#1EAFDA]/40" aria-hidden="true"></div>
    <div class="absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-[#0E9F6E]/30" aria-hidden="true"></div>
    <div class="absolute bottom-10 right-10 hidden h-16 w-16 rotate-12 border-4 border-[#1EAFDA] md:block" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h1 class="max-w-xl text-4xl font-bold leading-tight md:text-5xl">Juntos podemos transformar realidades</h1>
      <p class="mt-4 max-w-lg text-lg text-white/85">
        Acompañamos a organizaciones comunitarias de Argentina, Chile y Uruguay para que crezcan y sean sostenibles.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/catalogo" class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 font-semibold text-[#4C4688] transition-colors hover:bg-[#F0EEF8]">
          Ver catálogo de productos
        </a>
        <a href="/login" class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-white px-6 font-semibold text-white transition-colors hover:bg-white/10">
          Ingresar a la plataforma interna
        </a>
      </div>
    </div>
  </section>

  <!-- Programas -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-2xl font-bold text-[#252238] md:text-3xl">Nuestros programas</h2>
      <a href={RUTA_PROGRAMAS_SIMULACION} class="text-sm font-semibold text-[#4C4688] hover:underline">Ver todos los programas →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {programasSimulacion.map((programa) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <div class="h-2" style={`background:${programa.color}`} aria-hidden="true"></div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{programa.bajada}</p>
            <h3 class="mt-1 text-lg font-bold text-[#252238]">{programa.nombre}</h3>
            <div class="mt-auto flex flex-wrap gap-2 pt-5">
              <a href={`${RUTA_PROGRAMAS_SIMULACION}#${programa.id}`} class="inline-flex min-h-10 items-center rounded-full border border-neutral-300 px-4 text-sm font-semibold text-neutral-700 hover:bg-neutral-50">Más info</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Acceso para equipos -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-[#F0EEF8] p-8 md:flex-row md:items-center md:p-10">
      <div>
        <h2 class="text-2xl font-bold text-[#252238]">¿Eres parte del equipo de la fundación?</h2>
        <p class="mt-2 text-neutral-600">Coordinadores y administradores ingresan aquí a la plataforma de gestión.</p>
      </div>
      <a href="/login" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-full bg-[#4C4688] px-6 font-semibold text-white hover:bg-[#423C76]">
        Ingresar a la plataforma
      </a>
    </div>
  </section>
</SimulacionLayout>
