---
import AvisoObligatorios from '../components/ui/AvisoObligatorios.astro';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Input from '../components/ui/Input.astro';

---

<Layout title="Recuperar contraseña - Fundación Gestionar Esperanzas">
  <main class="auth-page">
    <section class="brand-panel">
      <div class="brand-circle"></div>
      <img src="/Logo-FGE-SIN-FONDO.png" alt="Fundación Gestionar Esperanzas" class="brand-logo" />
      <div class="brand-wave"></div>
      <div class="brand-footer">
        <span>Chile · Argentina · Uruguay</span>
        <span>© Fundación Gestionar Esperanzas</span>
      </div>
    </section>

    <section class="auth-panel">
      <Card class="auth-card">
        <div class="auth-content">
          <header class="auth-header">
            <h1>Recuperar contraseña</h1>
            <p>Ingresa tu correo y te enviaremos un enlace para restablecer tu contraseña.</p>
          </header>

          <div id="error-alert" class="error-alert hidden" role="alert">
            <span class="error-icon">!</span>
            <span id="error-message"></span>
          </div>

          <div id="success-alert" class="success-alert hidden">
            <span class="success-icon">✓</span>
            <div>
              <strong>Solicitud enviada</strong>
              <p>Si el correo corresponde a una cuenta registrada, recibirás un enlace para restablecer tu contraseña.</p>
            </div>
          </div>

          <form id="recovery-form" class="auth-form" novalidate>
            <AvisoObligatorios />
            <Input
              label="Correo electrónico"
              id="email"
              type="email"
              placeholder="coordinador@fge.cl"
              autocomplete="email"
              required
            />

            <Button id="submit-btn" type="submit" variant="primary" size="lg" class="full">
              Enviar enlace de recuperación
            </Button>
          </form>

          <div class="back">
            <Button href="/login" variant="ghost" size="sm">← Volver al inicio de sesión</Button>
          </div>
        </div>
      </Card>
    </section>
  </main>

  <script>
    import { solicitarRecuperacion } from '../lib/auth/cliente';

    const form = document.getElementById('recovery-form') as HTMLFormElement;
    const email = document.getElementById('email') as HTMLInputElement;
    const alert = document.getElementById('error-alert') as HTMLDivElement;
    const message = document.getElementById('error-message') as HTMLSpanElement;
    const success = document.getElementById('success-alert') as HTMLDivElement;
    const submit = document.getElementById('submit-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideMessages();

      const value = email.value.trim();

      if (!value) {
        showError('Por favor, ingresa tu correo electrónico.');
        return;
      }

      if (!value.includes('@') || !value.includes('.')) {
        showError('Por favor, introduce una dirección de correo electrónico válida.');
        return;
      }

      submit.textContent = 'Enviando...';
      submit.disabled = true;

      try {
        await solicitarRecuperacion(value);
      } catch (error) {
        showError(error instanceof Error ? error.message : 'No fue posible enviar el enlace de recuperación.');
        submit.textContent = 'Enviar enlace de recuperación';
        submit.disabled = false;
        return;
      }

      success.classList.remove('hidden');
      form.classList.add('hidden');
      submit.textContent = 'Enlace enviado';
    });

    function showError(text: string) {
      message.textContent = text;
      alert.classList.remove('hidden');
    }

    function hideMessages() {
      alert.classList.add('hidden');
      success.classList.add('hidden');
    }
  </script>
</Layout>

<style>
  .auth-page {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 45% 55%;
    background: #fff;
  }

  .brand-panel {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,#fff 0%,#fafafa 65%,#f5f3fb 100%);
  }

  .brand-logo {
    position: relative;
    z-index: 2;
    width: min(78%,390px);
  }

  .brand-circle {
    position: absolute;
    width: 270px;
    height: 270px;
    top: -145px;
    left: -90px;
    border-radius: 50%;
    background: rgba(76,70,136,.08);
  }

  .brand-wave {
    position: absolute;
    left: -10%;
    right: -15%;
    bottom: -25%;
    height: 42%;
    background: #4c4688;
    border-radius: 55% 55% 0 0 / 35% 35% 0 0;
    transform: rotate(-3deg);
  }

  .brand-footer {
    position: absolute;
    z-index: 3;
    left: 2.5rem;
    bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: .35rem;
    color: rgba(255,255,255,.9);
    font-size: .78rem;
  }

  .auth-panel {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 560px;
    padding: 2rem;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  .auth-content {
    width: 100%;
    max-width: 520px;
    margin: auto;
  }

  .auth-header { margin-bottom: 2.5rem; }

  .auth-header h1 {
    margin: 0;
    color: #1a1a1a;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .auth-header p {
    margin: .75rem 0 0;
    color: #706e78;
    font-size: 1rem;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .full { width: 100%; }

  .back {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .error-alert,
  .success-alert {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
    margin-bottom: 1.5rem;
    padding: .8rem .9rem;
    border-radius: .65rem;
    font-size: .82rem;
    line-height: 1.4;
  }

  .error-alert {
    border: 1px solid rgba(255,36,113,.25);
    background: rgba(255,36,113,.06);
    color: #706e78;
  }

  .success-alert {
    border: 1px solid rgba(25,157,107,.25);
    background: rgba(25,157,107,.07);
    color: #47705f;
  }

  .error-alert.hidden,
  .success-alert.hidden { display: none; }

  .error-icon,
  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
  }

  .error-icon { background: #ff2471; }
  .success-icon { background: #199d6b; }

  .success-alert p { margin: .25rem 0 0; }

  @media (max-width: 900px) {
    .auth-page { grid-template-columns: 40% 60%; }
    .auth-panel { padding: 2rem; }
  }

  @media (max-width: 700px) {
    .auth-page { display: flex; flex-direction: column; }
    .brand-panel { min-height: 230px; height: 230px; }
    .brand-logo { width: 220px; }
    .brand-wave {
      /* En celular la franja no se inclina, para que el texto quede dentro de lo morado. */
      left: -20%;
      right: -20%;
      bottom: -70px;
      height: 140px;
      transform: none;
      border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    }
    .brand-footer {
      left: 1rem;
      right: 1rem;
      bottom: .7rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 .6rem;
      font-size: .7rem;
      text-align: center;
    }
    .auth-panel { min-height: auto; padding: 2rem 1.25rem 3rem; }
    .auth-card { padding: 0; }
    .auth-header h1 { font-size: 1.8rem; }
  }
</style>
