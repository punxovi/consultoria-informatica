---
import BackButton from '../../../../components/ui/BackButton.astro';
import CoordinadorForm from '../../../../components/coordinadores/CoordinadorForm.astro';
import { mainNavItems } from '../../../../config/nav';
import AppLayout from '../../../../layouts/AppLayout.astro';

const { id = '' } = Astro.params;
---

<AppLayout title="Editar coordinador" navItems={mainNavItems} allowedRoles={['ADMIN']}>
  <Fragment slot="headerBreadcrumb">
    <BackButton href="/administracion/coordinadores" />
    <a href="/administracion/coordinadores" class="truncate text-sm text-neutral-500 transition-colors hover:text-primary">
      Coordinadores
    </a>
    <span aria-hidden="true" class="text-neutral-300">›</span>
    <span class="truncate text-sm font-semibold text-neutral-900">Editar coordinador</span>
  </Fragment>
  <CoordinadorForm modo="editar" idUsuario={id} />
</AppLayout>
