---
import Icono from '../../components/ui/Icono.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { mainNavItems } from '../../config/nav';
import { opcionesAccion, opcionesSeccion } from '../../lib/auditoria/presentacion';
const campos = [
  ['usuario', 'Persona', 'search', 'Correo o nombre'],
  ['pais', 'País', 'search', 'Ej. Chile'],
  ['desde', 'Desde', 'date', ''], ['hasta', 'Hasta', 'date', ''],
] as const;
const listas = [
  ['operacion', 'Qué hizo', 'Todas las acciones', opcionesAccion],
  ['entidad', 'Sección', 'Todas las secciones', opcionesSeccion],
] as const;
const control = 'min-h-12 w-full min-w-0 rounded-xl border border-[#DCD8EA] bg-white px-3 text-base focus:outline-none focus:ring-2 focus:ring-primary';
---
<AppLayout title="Auditoría" navItems={mainNavItems} allowedRoles={['ADMIN']}>
  <Fragment slot="headerBreadcrumb"><span class="text-sm font-semibold text-neutral-900">Auditoría</span></Fragment>
  <section id="auditoria" class="space-y-6 min-w-0">
    <header>
      <p class="text-sm font-medium text-primary">Administración</p>
      <h1 class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">Historial de cambios</h1>
      <p class="mt-2 text-neutral-500">Revisa quién hizo cada cambio en el sistema, qué hizo y cuándo. Este historial es solo de consulta y no se puede modificar.</p>
    </header>
    <Card class="tarjeta-acento acento-morado p-5">
      <h2 class="text-lg font-semibold">Buscar en el historial</h2>
      <p class="mt-1 mb-5 text-sm text-neutral-500">Todos los filtros son opcionales y se pueden combinar. Las fechas incluyen ambos días y se interpretan en tu hora local.</p>
      <form id="audit-form" novalidate>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {campos.map(([id, label, tipo, placeholder]) => <div class="min-w-0">
            <label for={`audit-${id}`} class="block mb-2 text-sm font-medium">{label}</label>
            <input id={`audit-${id}`} name={id} type={tipo} placeholder={placeholder} aria-describedby={`audit-error-${id}`} class={control} />
            <p id={`audit-error-${id}`} hidden class="mt-1 text-sm text-danger"></p>
          </div>)}
          {listas.map(([id, label, todas, opciones]) => <div class="min-w-0">
            <label for={`audit-${id}`} class="block mb-2 text-sm font-medium">{label}</label>
            <select id={`audit-${id}`} name={id} aria-describedby={`audit-error-${id}`} class={control}>
              <option value="">{todas}</option>
              {opciones.map(([valor, texto]) => <option value={valor}>{texto}</option>)}
            </select>
            <p id={`audit-error-${id}`} hidden class="mt-1 text-sm text-danger"></p>
          </div>)}
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button type="submit" size="lg" id="audit-aplicar">Aplicar filtros</Button>
          <Button type="button" variant="outline" size="lg" id="audit-limpiar"> <Icono nombre="limpiar" />Limpiar filtros</Button>
        </div>
      </form>
    </Card>
    <Card class="p-5 min-w-0">
      <h2 class="text-xl font-semibold">Cambios registrados</h2>
      <p class="mt-1 text-sm text-neutral-500">Fecha y hora según tu zona horaria. Los datos técnicos de cada cambio están en «Ver detalles técnicos».</p>
      <p id="audit-criterios" class="mt-3 break-words text-sm text-primary"></p>
      <p id="audit-pendientes" hidden class="mt-2 text-sm text-neutral-500">Hay cambios sin aplicar en los filtros.</p>
      <p id="audit-estado" role="status" class="my-4 text-neutral-500"></p>
      <div id="audit-error" hidden role="alert" class="my-4 rounded-xl bg-danger/5 p-4 text-danger"></div>
      <div id="audit-reintento" hidden><Button id="audit-reintentar" variant="outline" size="lg" class="mb-4">Reintentar consulta</Button></div>
      <div id="audit-resultados" aria-busy="false"></div>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Button id="audit-anterior" variant="outline" size="lg" disabled>Anterior</Button>
        <span id="audit-pagina" class="text-sm text-neutral-500"></span>
        <Button id="audit-siguiente" variant="outline" size="lg" disabled>Siguiente</Button>
      </div>
    </Card>
  </section>
</AppLayout>
<script>
  import { iniciarAuditoria } from '../../lib/auditoria/interfaz';
  void iniciarAuditoria();
</script>
