---
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { mainNavItems } from '../../config/nav';

interface PaisListado {
  id: string;
  nombre: string;
  codigoArea: string;
  zonaHoraria: string;
  codigo: string;
}

// Los países se cargarán desde el cliente HTTP en la tarea de integración.
const paises: PaisListado[] = [];

const totalPaises = paises.length;
const totalCodigos = paises.filter((pais) => Boolean(pais.codigoArea)).length;
const totalZonasHorarias = paises.filter((pais) => Boolean(pais.zonaHoraria)).length;
---

<AppLayout title="Países" navItems={mainNavItems} allowedRoles={['ADMIN']}>
  <section class="space-y-6" aria-labelledby="paises-title">

    <!-- Encabezado -->
    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary">Administración</p>

        <h1 id="paises-title" class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl">
          Países
        </h1>

        <p class="mt-2 max-w-2xl text-sm text-neutral-500">
          Administra los países de operación de la Fundación y su configuración territorial.
        </p>
      </div>

      <Button
        href="/administracion/paises/nuevo"
        size="lg"
        class="shrink-0"
      >
        <span aria-hidden="true">+</span>
        Nuevo país
      </Button>
    </header>

    <!-- Tarjetas de resumen -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3" aria-label="Resumen de países">

      <Card class="border-l-4 border-l-primary p-4">
        <div class="flex items-center gap-3">
          <span
            class="rounded-xl bg-primary/10 p-3 text-primary"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9" />
              <path stroke-linecap="round" d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Países registrados
            </p>
            <p class="mt-1 text-2xl font-bold text-neutral-900">
              {totalPaises}
            </p>
          </div>
        </div>
      </Card>

      <Card class="border-l-4 border-l-brand-green p-4">
        <div class="flex items-center gap-3">
          <span
            class="rounded-xl bg-brand-green/10 p-3 text-brand-green"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Códigos telefónicos
            </p>
            <p class="mt-1 text-2xl font-bold text-neutral-900">
              {totalCodigos}
            </p>
          </div>
        </div>
      </Card>

      <Card class="border-l-4 border-l-brand-yellow p-4">
        <div class="flex items-center gap-3">
          <span
            class="rounded-xl bg-brand-yellow/20 p-3 text-[#946200]"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Zonas horarias
            </p>
            <p class="mt-1 text-2xl font-bold text-neutral-900">
              {totalZonasHorarias}
            </p>
          </div>
        </div>
      </Card>
    </div>

    <!-- Listado de países -->
    <section aria-labelledby="paises-listado-titulo" class="space-y-4">

      <header class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="paises-listado-titulo" class="text-lg font-semibold text-neutral-900">
            Listado de países
          </h2>

          <p class="mt-1 text-sm text-neutral-500">
            Consulta y administra la configuración territorial de la Fundación.
          </p>
        </div>

        <span class="inline-flex w-fit rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          {totalPaises} {totalPaises === 1 ? 'país' : 'países'}
        </span>
      </header>

      {paises.length > 0 ? (
        <ul class="grid grid-cols-1 gap-4" aria-label="Países registrados">
          {paises.map((pais) => (
            <li>
              <Card class="p-5 md:p-6">
                <article class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-3">
                      <span
                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-sm font-bold text-primary"
                        aria-hidden="true"
                      >
                        {pais.codigo}
                      </span>

                      <h3 class="text-lg font-bold text-neutral-900">
                        {pais.nombre}
                      </h3>
                    </div>

                    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                          Código de área
                        </p>

                        <p class="mt-1 text-base font-medium text-neutral-800">
                          {pais.codigoArea}
                        </p>
                      </div>

                      <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                          Zona horaria local
                        </p>

                        <p class="mt-1 break-words text-base font-medium text-neutral-800">
                          {pais.zonaHoraria}
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="border-t border-neutral-100 pt-4 md:border-l md:border-t-0 md:pl-5 md:pt-0">
                    <Button
                      href={`/administracion/paises/${encodeURIComponent(pais.id)}/editar`}
                      variant="outline"
                      size="lg"
                      class="w-full md:w-auto"
                    >
                      Editar país
                      <span aria-hidden="true">→</span>
                    </Button>
                  </div>

                </article>
              </Card>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="Todavía no hay países registrados"
          description="Cuando registres un país, aparecerá aquí con su código de área telefónica y su zona horaria local."
        >
          <Button href="/administracion/paises/nuevo" size="lg">
            Crear el primer país
          </Button>
        </EmptyState>
      )}

      <!-- Estados preparados para la integración -->
      <p
        id="paises-loading"
        hidden
        role="status"
        aria-live="polite"
        class="rounded-xl border border-neutral-200 bg-white p-4 text-sm text-neutral-500"
      >
        Cargando países…
      </p>

      <p
        id="paises-error"
        hidden
        role="alert"
        class="rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger"
      >
        No fue posible cargar los países. Intenta nuevamente.
      </p>

    </section>
  </section>
</AppLayout>