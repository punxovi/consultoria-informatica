---
import Icono from '../../components/ui/Icono.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import DialogosCobertura from '../../components/coberturas/DialogosCobertura.astro';
import { mainNavItems } from '../../config/nav';
---

<AppLayout
  title="Coberturas temporales"
  navItems={mainNavItems}
  allowedRoles={['ADMIN']}
>
  <section
    id="coberturas"
    class="space-y-6"
    aria-labelledby="coberturas-title"
  >
    <p
      id="coberturas-confirmacion"
      hidden
      role="status"
      tabindex="-1"
      class="rounded-xl border border-success/20 bg-success/10 p-4 text-sm text-success focus:outline-none"
    ></p>

    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary">
          Administración
        </p>

        <h1
          id="coberturas-title"
          class="mt-1 text-2xl font-bold text-neutral-900 md:text-3xl"
        >
          Coberturas temporales
        </h1>

        <p class="mt-2 max-w-2xl text-sm text-neutral-500">
          Administra las autorizaciones temporales de los Coordinadores para
          trabajar en países adicionales durante un período definido.
        </p>
      </div>

      <Button
        href="/administracion/coberturas/nueva"
        size="lg"
        class="shrink-0"
        id="coberturas-nueva"
      >
        <span aria-hidden="true">+</span>
        Nueva cobertura
      </Button>
    </header>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      {[
        {
          id: 'total',
          titulo: 'Total de coberturas',
          acento: 'acento-morado',
          icono: 'bg-primary/10 text-primary',
        },
        {
          id: 'vigentes',
          titulo: 'Vigentes',
          acento: 'acento-verde',
          icono: 'bg-brand-green/10 text-brand-green',
        },
        {
          id: 'futuras-vencidas',
          titulo: 'Futuras o vencidas',
          acento: 'acento-amarillo',
          icono: 'bg-brand-yellow/20 text-[#946200]',
        },
      ].map((metrica, indice) => (
        <Card class={`tarjeta-acento ${metrica.acento} p-4`}>
          <div class="flex items-center gap-3">
            <span
              class={`rounded-xl p-3 ${metrica.icono}`}
              aria-hidden="true"
            >
              {indice === 0 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <rect x="4" y="5" width="16" height="15" rx="2" />
                  <path
                    stroke-linecap="round"
                    d="M8 3v4M16 3v4M4 10h16"
                  />
                </svg>
              )}

              {indice === 1 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m5 12 4 4L19 6"
                  />
                  <circle cx="12" cy="12" r="9" />
                </svg>
              )}

              {indice === 2 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path
                    stroke-linecap="round"
                    d="M12 7v5l3 2"
                  />
                </svg>
              )}
            </span>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                {metrica.titulo}
              </p>

              <p
                data-cobertura-metrica={metrica.id}
                class="mt-1 text-2xl font-bold text-neutral-900"
                aria-label="Pendiente de consultar"
              >
                —
              </p>
            </div>
          </div>
        </Card>
      ))}
    </div>

    <Card class="p-4 md:p-5">
      <div class="mb-4 flex items-start gap-3">
        <span class="rounded-xl bg-primary/10 p-2.5 text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16M7 12h10m-7 7h4" /></svg></span>
        <div>
          <h2 class="text-lg font-semibold text-neutral-900">Filtrar coberturas</h2>
          <p class="mt-1 text-sm text-neutral-500">Busca por Coordinador o país y filtra por la condición de vigencia.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-2">
        <div class="space-y-1.5">
          <label
            for="coberturas-buscar"
            class="block text-sm font-medium text-neutral-800"
          >
            Buscar cobertura
          </label>

          <input
            id="coberturas-buscar"
            type="search"
            autocomplete="off"
            placeholder="Nombre del Coordinador o país"
            disabled
            class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary placeholder:text-neutral-400 disabled:cursor-not-allowed disabled:bg-neutral-50"
          />
        </div>

        <div class="space-y-1.5">
          <label
            for="coberturas-filtro-estado"
            class="block text-sm font-medium text-neutral-800"
          >
            Condición de vigencia
          </label>

          <select
            id="coberturas-filtro-estado"
            disabled
            class="min-h-[46px] w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary disabled:cursor-not-allowed disabled:bg-neutral-50"
          >
            <option value="">Todas las condiciones</option>
            <option value="vigente">Vigente</option>
            <option value="futura">Futura</option>
            <option value="vencida">Vencida</option>
            <option value="revocada">Revocada</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
        <p id="coberturas-estado" role="status" aria-live="polite" class="text-sm text-neutral-500">Preparando consulta de coberturas…</p>
        <Button id="coberturas-limpiar" type="button" variant="outline" disabled>
          <Icono nombre="limpiar" />
          Limpiar filtros
        </Button>
      </div>
    </Card>

    <div
      id="coberturas-carga"
      hidden
      role="status"
      aria-live="polite"
      class="flex items-center justify-center gap-3 rounded-2xl border border-[#E4E0F2] bg-white p-6 text-sm text-neutral-500"
    >
      <span
        class="h-4 w-4 animate-spin rounded-full border-2 border-[#D8D3E8] border-t-primary"
        aria-hidden="true"
      ></span>

      Cargando coberturas...
    </div>

    <div
      id="coberturas-error"
      hidden
      role="alert"
      class="rounded-xl border border-danger/20 bg-danger/5 p-4 text-sm text-danger"
    >
      <p class="font-semibold">
        No fue posible consultar las coberturas.
      </p>

      <p id="coberturas-error-texto" class="mt-1"></p>
    </div>

    <section
      aria-labelledby="coberturas-listado-title"
      class="space-y-4"
    >
      <h2
        id="coberturas-listado-title"
        class="text-lg font-semibold text-neutral-900"
      >
        Listado de coberturas
      </h2>

      <EmptyState
        id="coberturas-vacio"
        title="Listado de coberturas"
        description="Cuando el servicio esté disponible, aquí aparecerán las coberturas reales de los Coordinadores autorizados."
      >
        <Button href="/administracion/coberturas/nueva" size="lg">
          Registrar cobertura
        </Button>
      </EmptyState>

      <div
        id="coberturas-sin-registros"
        hidden
        class="rounded-2xl border border-dashed border-[#D8D3E8] bg-white p-8 text-center"
      >
        <h3 class="text-lg font-semibold text-neutral-900">
          Todavía no hay coberturas registradas
        </h3>

        <p class="mx-auto mt-2 max-w-lg text-sm text-neutral-500">
          Cuando registres una cobertura temporal, aparecerá aquí con su
          Coordinador, país autorizado, periodo y condición de vigencia.
        </p>

        <div class="mt-5">
          <Button href="/administracion/coberturas/nueva" size="lg">
            Registrar la primera cobertura
          </Button>
        </div>
      </div>

      <div
        id="coberturas-sin-resultados"
        hidden
        class="rounded-2xl border border-dashed border-[#D8D3E8] bg-white p-8 text-center"
      >
        <h3 class="text-base font-semibold text-neutral-900">
          Ninguna cobertura coincide con los filtros
        </h3>

        <p class="mt-2 text-sm text-neutral-500">
          Modifica la búsqueda o selecciona otra condición de vigencia.
        </p>
      </div>

      <ul
        id="coberturas-lista"
        data-cliente-coberturas="integrado"
        hidden
        class="grid grid-cols-1 gap-4 lg:grid-cols-2"
        aria-busy="false"
      ></ul>
    </section>
  </section>

  <DialogosCobertura />
</AppLayout>

<script>
  import { iniciarListadoCoberturas } from '../../lib/coberturas/interfaz-listado';
  iniciarListadoCoberturas();
</script>
