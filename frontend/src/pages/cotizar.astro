---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Solicitar cotización"><main class="mx-auto max-w-3xl px-6 py-10"><a class="text-sm text-[#4C4688]" href="/">← Volver al catálogo</a><h1 class="mt-4 text-3xl font-bold">Solicitar cotización</h1><p class="mt-2 text-neutral-600">Completa tus datos. Solo se registrará la solicitud; la información interna permanece protegida.</p><form id="quote-form" class="mt-8 space-y-5 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm"><label class="block text-sm font-semibold">Nombre<input name="nombre_solicitante" required maxlength="160" class="mt-1 w-full rounded-lg border p-3" /></label><label class="block text-sm font-semibold">Correo<input name="correo" type="email" required maxlength="320" class="mt-1 w-full rounded-lg border p-3" /></label><label class="block text-sm font-semibold">Teléfono<input name="telefono" maxlength="60" class="mt-1 w-full rounded-lg border p-3" /></label><fieldset><legend class="text-sm font-semibold">Productos o servicios</legend><div id="items" class="mt-2 space-y-2">Cargando…</div></fieldset><label class="block text-sm font-semibold">Mensaje<textarea name="mensaje" maxlength="2000" class="mt-1 min-h-28 w-full rounded-lg border p-3"></textarea></label><button class="rounded-xl bg-[#4C4688] px-5 py-3 font-semibold text-white" type="submit">Enviar solicitud</button><p id="status" role="status" class="text-sm"></p></form></main></Layout>
<script>
  const itemsRoot = document.querySelector('#items'); const form = document.querySelector('#quote-form'); const status = document.querySelector('#status'); const escapeHtml = (v) => String(v ?? '').replace(/[&<>'"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  fetch('/api/v1/public/catalog').then((r) => r.json()).then((p) => { itemsRoot.innerHTML = p.data.items.map((i) => `<label class="flex items-center gap-3 rounded-lg border p-3"><input type="checkbox" data-product="${i.id_producto}" /> <span class="flex-1">${escapeHtml(i.nombre)} <small class="text-neutral-500">(${escapeHtml(i.unidad_medida)})</small></span><input type="number" min="1" step="1" value="1" data-quantity="${i.id_producto}" class="w-20 rounded border p-2" /></label>`).join(''); }).catch(() => { itemsRoot.textContent = 'No fue posible cargar el catálogo.'; });
  form.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const items = [...form.querySelectorAll('input[data-product]:checked')].map((input) => ({ id_producto: input.dataset.product, cantidad: Number(form.querySelector(`[data-quantity="${input.dataset.product}"]`).value) })); if (!items.length) { status.textContent = 'Selecciona al menos un producto.'; return; } const body = Object.fromEntries(data.entries()); body.items = items; const response = await fetch('/api/v1/public/quote-requests', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify(body) }); const payload = await response.json(); status.textContent = payload.ok ? `Solicitud registrada: ${payload.data.quote.id_solicitud}` : payload.error.message; if (payload.ok) form.reset(); });
</script>
