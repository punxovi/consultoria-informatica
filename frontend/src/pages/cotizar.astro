---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
const campos = [['nombre','Nombre','text',79],['apellido','Apellido','text',80],['correo','Correo electrónico','email',320],['telefono','Teléfono (opcional)','tel',60]] as const;
---
<Layout title="Solicitar cotización · Fundación Gestionar Esperanzas">
  <main id="cotizacion" class="mx-auto max-w-6xl space-y-6 px-5 py-8">
    <a href="/catalogo" class="inline-flex min-h-12 items-center font-semibold text-primary">← Volver al catálogo</a>
    <header><h1 class="text-3xl font-bold md:text-4xl">Solicitar cotización</h1><p class="mt-3 text-neutral-600">Revisa tu selección, indica las cantidades estimadas y completa tus datos de contacto.</p></header>
    <p class="rounded-xl border border-[#DCD8EA] bg-[#F0EEF8] p-4 text-sm leading-relaxed text-neutral-700">La Fundación revisará disponibilidad, precios, plazos, condiciones y forma de entrega antes de preparar la cotización final. Esta solicitud no realiza pagos ni reserva o modifica el inventario.</p>
    <p id="cot-carga" role="status" class="text-neutral-600">Cargando selección…</p>
    <div id="cot-error-carga" hidden role="alert"><p id="cot-error-carga-texto">No fue posible cargar el catálogo. Tu selección se conserva.</p><Button id="cot-reintentar" variant="outline" size="lg" class="mt-3">Reintentar</Button></div>
    <div id="cot-error-seleccion" hidden role="alert" class="rounded-xl border border-danger/30 p-4"><p>No se pudo recuperar la selección guardada. Restablécela y agrega los productos nuevamente.</p></div>
    <Button id="cot-restablecer" variant="outline" size="lg">Vaciar selección</Button>
    <div id="cot-confirmacion" hidden role="status" tabindex="-1" class="rounded-xl border border-success/30 bg-success/10 p-6"></div>
    <form id="cot-form" novalidate class="grid items-start gap-6 lg:grid-cols-2">
      <Card class="min-w-0 p-5">
        <h2 class="text-xl font-bold">Productos seleccionados</h2>
        <div id="cot-items" class="mt-4 space-y-4"></div>
        <p id="cot-error-items" hidden role="alert" class="mt-3 text-sm text-danger"></p>
        <div id="cot-resumen" aria-live="polite" class="mt-5 rounded-xl bg-[#F0EEF8] p-4 text-sm leading-relaxed"></div>
      </Card>
      <Card class="min-w-0 p-5">
        <h2 class="text-xl font-bold">Datos de contacto</h2><p class="mt-1 text-sm text-neutral-600">Los campos con * son obligatorios.</p>
        <fieldset id="cot-campos" class="mt-5 space-y-4" disabled>
          {campos.map(([id,label,tipo,max])=><div><label for={`cot-${id}`} class="mb-1 block font-medium">{label}{id !== 'telefono' && ' *'}</label><input id={`cot-${id}`} name={id} type={tipo} maxlength={max} required={id !== 'telefono'} autocomplete={id==='nombre'?'given-name':id==='apellido'?'family-name':id==='correo'?'email':'tel'} aria-describedby={`cot-error-${id}`} class="min-h-12 w-full rounded-xl border border-[#DCD8EA] px-3 focus:outline-2 focus:outline-primary"/><p id={`cot-error-${id}`} hidden class="mt-1 text-sm text-danger"></p></div>)}
          <div><label for="cot-mensaje" class="mb-1 block font-medium">Mensaje (opcional)</label><textarea id="cot-mensaje" name="mensaje" maxlength="2000" rows="4" placeholder="Fechas, destino, requisitos u otros antecedentes" aria-describedby="cot-error-mensaje" class="w-full rounded-xl border border-[#DCD8EA] p-3 focus:outline-2 focus:outline-primary"></textarea><p id="cot-error-mensaje" hidden class="text-sm text-danger"></p></div>
          <Button id="cot-enviar" type="submit" size="lg" class="w-full">Enviar solicitud</Button>
        </fieldset>
        <p id="cot-error-envio" hidden role="alert" class="mt-4 text-sm text-danger"></p>
        <p id="cot-enviando" role="status" class="mt-3 text-sm text-primary"></p>
      </Card>
    </form>
  </main>
</Layout>
<script>
  import { iniciarCotizacion } from '../lib/cotizacion/interfaz';
  void iniciarCotizacion();
</script>
