---
import Layout from '../layouts/Layout.astro';
import EncabezadoPublico from '../components/publico/EncabezadoPublico.astro';
import PanelSolicitud from '../components/cotizacion/PanelSolicitud.astro';
---
<Layout title="Mi solicitud de cotización · Fundación Gestionar Esperanzas">
  <div class="min-h-screen bg-[#F7F6FA] text-neutral-900">
    <EncabezadoPublico actual="solicitud" />
    <main class="mx-auto max-w-7xl space-y-6 px-4 py-6 md:px-5 md:py-8">
      <a href="/catalogo" class="inline-flex min-h-11 items-center font-semibold text-primary">← Seguir explorando el catálogo</a>
      <header>
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Solicitud de cotización</h1>
        <p class="mt-2 max-w-3xl text-neutral-600">Revisa los productos de tu solicitud, ajusta las cantidades estimadas y completa tus datos de contacto para enviarla.</p>
      </header>
      <PanelSolicitud />
    </main>
    <footer class="mt-6 bg-[#423C76] px-5 py-6 text-center text-sm text-[#E5E2F8]">Fundación Gestionar Esperanzas · Conectamos organizaciones y oportunidades.</footer>
  </div>
</Layout>
<script>
  import { iniciarCotizacion } from '../lib/cotizacion/interfaz';
  iniciarCotizacion();
</script>
