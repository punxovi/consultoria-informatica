---
import '../styles/organizaciones.css';
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
---

<AppLayout title="Organizaciones" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>

  <Fragment slot="headerBreadcrumb">
    <span class="text-sm font-semibold text-neutral-900">Organizaciones</span>
  </Fragment>

  <section class="organizaciones-ui org-listado space-y-6">

    <!-- Encabezado -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
          Organizaciones
        </h1>

        <p class="mt-2 text-sm text-neutral-500">
          Gestiona las organizaciones asociadas a la fundación.
        </p>
      </div>

      <Button variant="primary" size="md" href="/organizaciones/nueva">
        <span aria-hidden="true">+</span>
        Nueva organización
      </Button>
    </div>

    <div class="org-listado-metricas grid grid-cols-1 gap-3 sm:grid-cols-3">
      <Card class="border-l-4 border-l-primary p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-primary/10 text-primary p-3" aria-hidden="true"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V5h14v16M9 9h1m4 0h1m-6 4h1m4 0h1" /></svg></span>
          <div><p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Organizaciones</p><p id="total-organizaciones" class="mt-1 text-2xl font-bold text-neutral-900">—</p></div>
        </div>
      </Card>
      <Card class="border-l-4 border-l-brand-green p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-brand-green/10 text-brand-green p-3" aria-hidden="true"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6" /></svg></span>
          <div><p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Activas</p><p id="organizaciones-activas" class="mt-1 text-2xl font-bold text-neutral-900">—</p></div>
        </div>
      </Card>
      <Card class="border-l-4 border-l-brand-yellow p-4">
        <div class="flex items-center gap-3">
          <span class="rounded-xl bg-brand-yellow/20 text-[#946200] p-3" aria-hidden="true"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0" /></svg></span>
          <div><p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Inactivas</p><p id="organizaciones-inactivas" class="mt-1 text-2xl font-bold text-neutral-900">—</p></div>
        </div>
      </Card>
    </div>
    <Card class="org-filtros p-4 md:p-5">
      <div class="mb-4 flex items-start gap-3">
        <span class="rounded-xl bg-primary/10 p-2.5 text-primary" aria-hidden="true"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16M7 12h10m-7 7h4" /></svg></span>
        <div><h2 class="text-lg font-semibold text-neutral-900">Filtrar organizaciones</h2><p class="mt-1 text-sm text-neutral-500">Busca por nombre y país para encontrar las organizaciones que necesitas.</p></div>
      </div>
      <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-3">
        <Input id="buscar-organizacion" label="Buscar por nombre" placeholder="Ej: Comedor Los Aromos" />
        <Select id="filtro-pais" label="País" options={[{value:'',label:'Todos los países'}]} />
        <Select id="filtro-programa" label="Programa institucional" options={[{value:'',label:'Todos los programas'}]} />
      </div>
      <p id="filtro-programa-hint" class="mt-2 text-sm text-neutral-500">El filtro por programa todavía no está disponible.</p>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-100 pt-4">
        <p id="contador-resultados" role="status" aria-live="polite" class="text-sm text-neutral-500">Cargando organizaciones...</p>
        <Button id="limpiar-organizaciones" variant="outline"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7v5h-5M4 17v-5h5m-4.5-3A8 8 0 0 1 18 6l2 6M4 12l2 6a8 8 0 0 0 12.5-1" /></svg> Limpiar filtros</Button>
      </div>
    </Card>
    <section aria-labelledby="org-listado-titulo" class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div><h2 id="org-listado-titulo" class="text-lg font-semibold text-neutral-900">Listado de organizaciones</h2><p class="mt-1 text-sm text-neutral-500">Selecciona una organización para consultar su información.</p></div>
        <Button id="actualizar-organizaciones" variant="outline" class="shrink-0"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7v5h-5M4 17v-5h5m-4.5-3A8 8 0 0 1 18 6l2 6M4 12l2 6a8 8 0 0 0 12.5-1" /></svg> Actualizar listado</Button>
      </div>
      <div id="organizaciones-lista" class="org-resultados" aria-live="polite" aria-busy="true"><p class="text-sm text-neutral-500">Cargando organizaciones...</p></div>
    </section>

  </section>

</AppLayout>

<script>
  import { listarOrganizaciones } from '../lib/organizaciones/cliente';
  import { listarProgramas } from '../lib/programas/cliente';
  import type { Organizacion } from '../lib/modelos/organizaciones';

  const lista = document.querySelector<HTMLDivElement>(
    '#organizaciones-lista',
  )!;

  const totalElement = document.querySelector<HTMLParagraphElement>(
    '#total-organizaciones',
  )!;

  const activasElement = document.querySelector<HTMLParagraphElement>(
    '#organizaciones-activas',
  )!;

  const inactivasElement = document.querySelector<HTMLParagraphElement>(
    '#organizaciones-inactivas',
  )!;

  const contadorElement = document.querySelector<HTMLParagraphElement>(
    '#contador-resultados',
  )!;

  const inputBusqueda = document.querySelector<HTMLInputElement>(
    '#buscar-organizacion',
  )!;

  const selectPais = document.querySelector<HTMLSelectElement>(
    '#filtro-pais',
  )!;
  const selectPrograma = document.querySelector<HTMLSelectElement>(
    '#filtro-programa',
  )!;
  const hintPrograma = document.querySelector<HTMLParagraphElement>(
    '#filtro-programa-hint',
  );

  if (
    !lista ||
    !totalElement ||
    !activasElement ||
    !inactivasElement ||
    !contadorElement ||
    !inputBusqueda ||
    !selectPais ||
    !selectPrograma
  ) {
    throw new Error(
      'No se encontraron los elementos necesarios del listado de organizaciones.',
    );
  }

  // Los filtros se reflejan en la URL para conservar el contexto al abrir
  // una ficha y volver al listado.
  const parametrosIniciales = new URLSearchParams(window.location.search);
  inputBusqueda.value = parametrosIniciales.get('q') ?? '';

  let todasLasOrganizaciones: Organizacion[] = [];

  function sincronizarFiltrosEnUrl() {
    const url = new URL(window.location.href);
    const busqueda = inputBusqueda.value.trim();
    const pais = selectPais.value;

    if (busqueda) url.searchParams.set('q', busqueda);
    else url.searchParams.delete('q');

    if (pais) url.searchParams.set('id_pais', pais);
    else url.searchParams.delete('id_pais');

    history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  }

  /** Quita tildes/mayúsculas para comparar texto sin distinguirlas (RF18). */
  function normalizar(texto: string): string {
    return texto
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function poblarFiltroPaises(datos: Organizacion[]) {
    const seleccionPrevia = selectPais.value;
    const paisesUnicos = new Map<string, string>();

    datos.forEach((organizacion) => {
      paisesUnicos.set(organizacion.pais.id_pais, organizacion.pais.nombre);
    });

    selectPais.replaceChildren();

    const opcionTodos = document.createElement('option');
    opcionTodos.value = '';
    opcionTodos.textContent = 'Todos los países';
    selectPais.append(opcionTodos);

    [...paisesUnicos.entries()]
      .sort(([, nombreA], [, nombreB]) => nombreA.localeCompare(nombreB))
      .forEach(([idPais, nombrePais]) => {
        const opcion = document.createElement('option');
        opcion.value = idPais;
        opcion.textContent = nombrePais;
        selectPais.append(opcion);
      });

    selectPais.value = seleccionPrevia;
  }

  async function cargarProgramasDisponibles() {
    let programas: Awaited<ReturnType<typeof listarProgramas>>;
    try {
      programas = await listarProgramas();
    } catch {
      if (hintPrograma) {
        hintPrograma.textContent =
          'No se pudo cargar el catálogo de programas. La selección aún no filtra organizaciones.';
      }
      return;
    }

    const seleccionPrevia = selectPrograma.value;
    selectPrograma.replaceChildren();

    const opcionTodos = document.createElement('option');
    opcionTodos.value = '';
    opcionTodos.textContent = 'Todos los programas';
    selectPrograma.append(opcionTodos);

    for (const programa of programas) {
      const opcion = document.createElement('option');
      opcion.value = programa.id_programa;
      opcion.textContent = programa.nombre;
      selectPrograma.append(opcion);
    }

    selectPrograma.value = seleccionPrevia;
  }

  function aplicarFiltros() {
    sincronizarFiltrosEnUrl();
    const textoBuscado = normalizar(inputBusqueda.value);
    const idPaisSeleccionado = selectPais.value;

    // RF18 pendiente: filtrar por selectPrograma.value usando los id_organizacion
    // de planes con ese id_programa, una vez habilitada la lectura de planes.

    const filtradas = todasLasOrganizaciones.filter((organizacion) => {
      const coincideNombre =
        textoBuscado === '' || normalizar(organizacion.nombre).includes(textoBuscado);

      const coincidePais =
        idPaisSeleccionado === '' || organizacion.pais.id_pais === idPaisSeleccionado;

      return coincideNombre && coincidePais;
    });

    mostrarOrganizaciones(filtradas, todasLasOrganizaciones.length);
  }

  inputBusqueda.addEventListener('input', aplicarFiltros);
  selectPais.addEventListener('change', aplicarFiltros);

  function limpiarLista() {
    lista.replaceChildren();
  }

  function mostrarMensaje(
    mensaje: string,
    className = 'text-neutral-500',
  ) {
    limpiarLista();

    const contenedor = document.createElement('div');

    contenedor.className =
      'rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center';

    const parrafo = document.createElement('p');

    parrafo.className = `text-sm ${className}`;
    parrafo.textContent = mensaje;

    contenedor.append(parrafo);
    lista.append(contenedor);
  }

  function actualizarResumen(datos: Organizacion[]) {
    const activas = datos.filter(
      (organizacion) => organizacion.archived_at === null,
    ).length;

    const inactivas = datos.length - activas;

    totalElement.textContent = String(datos.length);
    activasElement.textContent = String(activas);
    inactivasElement.textContent = String(inactivas);
  }

  function formatearTipoOrganizacion(organizacion: Organizacion) {
    if (organizacion.tipo_organizacion === 'comedor_merendero') {
      return 'Comedor / Merendero';
    }

    if (organizacion.tipo_organizacion === 'centro_comunitario') {
      return 'Centro comunitario';
    }

    if (organizacion.tipo_organizacion === 'emprendimiento_uv') {
      return 'Emprendimiento UV';
    }

    return organizacion.tipo_organizacion_otro ?? 'Otra organización';
  }

  function crearOrganizacion(organizacion: Organizacion) {
    const tarjeta = document.createElement('article');

    tarjeta.className =
      'org-tarjeta';

    const contenido = document.createElement('div');

    contenido.className =
      'org-tarjeta-contenido';

    // Información de la organización
    const informacion = document.createElement('div');

    informacion.className = 'min-w-0';

    const encabezado = document.createElement('div');

    encabezado.className =
      'flex flex-wrap items-center gap-2';

    const nombre = document.createElement('h3');

    nombre.className =
      'text-xl font-semibold text-neutral-900';

    nombre.textContent = organizacion.nombre;

    const tipo = document.createElement('span');

    tipo.className =
      'inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary';

    tipo.textContent = formatearTipoOrganizacion(organizacion);

    encabezado.append(nombre, tipo);

    const ubicacion = document.createElement('p');

    ubicacion.className =
      'mt-2 text-sm text-neutral-500';

    ubicacion.textContent = [
      organizacion.comuna_municipio_ciudad,
      organizacion.region_departamento,
      organizacion.pais.nombre,
    ].join(' · ');

    const resumen = document.createElement('p');
    resumen.className = 'org-tarjeta-resumen';
    resumen.textContent = organizacion.descripcion_breve || 'Sin descripción registrada.';
    const beneficiarios = document.createElement('p');
    beneficiarios.className = 'org-tarjeta-beneficiarios';
    beneficiarios.textContent = String(organizacion.numero_beneficiarios) + ' beneficiarios';
    informacion.append(encabezado, ubicacion, resumen, beneficiarios);

    // Acción de detalle
    const acciones = document.createElement('div');

    acciones.className =
      'flex shrink-0 items-center md:justify-end';

    const detalle = document.createElement('a');

    const parametrosRetorno = new URLSearchParams(window.location.search);
    const queryRetorno = parametrosRetorno.toString();
    detalle.href = `/organizaciones/${encodeURIComponent(organizacion.id_organizacion)}${queryRetorno ? `?${queryRetorno}` : ''}`;

    detalle.className =
      'inline-flex min-h-[48px] items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';

    detalle.textContent = 'Ver detalle →';

    acciones.append(detalle);

    contenido.append(informacion, acciones);

    tarjeta.append(contenido);

    return tarjeta;
  }

  function mostrarOrganizaciones(
    datos: Organizacion[],
    totalSinFiltrar = datos.length,
  ) {
    limpiarLista();

    if (datos.length === 0) {
      mostrarMensaje(
        totalSinFiltrar === 0
          ? 'No hay organizaciones registradas actualmente.'
          : 'No se encontraron organizaciones con esos filtros.',
      );

      contadorElement.textContent =
        totalSinFiltrar === 0
          ? '0 organizaciones registradas'
          : '0 resultados';

      return;
    }

    lista.append(...datos.map(crearOrganizacion));

    contadorElement.textContent =
      datos.length === 1
        ? '1 organización encontrada'
        : `${datos.length} organizaciones encontradas`;
  }

  async function cargarOrganizaciones() {
    lista.setAttribute('aria-busy', 'true');
    contadorElement.textContent = 'Cargando organizaciones...';
    mostrarMensaje('Cargando organizaciones...');

    try {
      void cargarProgramasDisponibles();
      const datos = await listarOrganizaciones();

      todasLasOrganizaciones = datos;
      actualizarResumen(datos);
      poblarFiltroPaises(datos);
      selectPais.value = parametrosIniciales.get('id_pais') ?? '';
      aplicarFiltros();
    } catch (error) {
      todasLasOrganizaciones = [];
      actualizarResumen([]);

      contadorElement.textContent =
        'No se pudieron cargar las organizaciones.';

      mostrarMensaje(
        error instanceof Error
          ? error.message
          : 'Ocurrió un error inesperado.',
        'text-danger',
      );

      const reintentar = document.createElement('button');

      reintentar.type = 'button';

      reintentar.className =
        'mt-4 min-h-[48px] rounded-lg border-2 border-primary px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/10';

      reintentar.textContent = 'Reintentar';

      reintentar.addEventListener('click', () => {
        void cargarOrganizaciones();
      });

      lista.append(reintentar);
    } finally {
      lista.setAttribute('aria-busy', 'false');
    }
  }

  document.querySelector('#limpiar-organizaciones')?.addEventListener('click', () => {
    inputBusqueda.value = ''; selectPais.value = ''; selectPrograma.value = ''; aplicarFiltros();
  });
  document.querySelector('#actualizar-organizaciones')?.addEventListener('click', () => void cargarOrganizaciones());
  void cargarOrganizaciones();
</script>
