---
import AppLayout from '../layouts/AppLayout.astro';
import { mainNavItems } from '../config/nav';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
---

<AppLayout title="Organizaciones" navItems={mainNavItems} allowedRoles={['ADMIN', 'COORD']}>

  <Fragment slot="breadcrumb">
    <span>Chile</span>
    <span>&rsaquo;</span>
    <span class="font-medium text-neutral-900">Organizaciones</span>
  </Fragment>

  <section class="space-y-6">

    <!-- Encabezado -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="mb-1 text-sm font-medium text-primary">
          Gestión institucional
        </p>

        <h1 class="text-2xl font-bold text-neutral-900 md:text-3xl">
          Organizaciones
        </h1>

        <p class="mt-1 text-sm text-neutral-500">
          Gestiona las organizaciones asociadas a la fundación.
        </p>
      </div>

      <Button variant="primary" size="md" href="/organizaciones/nueva">
        <span aria-hidden="true">+</span>
        Nueva organización
      </Button>
    </div>

    <!-- Resumen -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

      <!-- Total -->
      <Card class="!p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Organizaciones
            </p>

            <p
              id="total-organizaciones"
              class="mt-2 text-3xl font-bold text-neutral-900"
            >
              0
            </p>

            <p class="mt-1 text-sm text-neutral-500">
              Registradas actualmente
            </p>
          </div>

          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 21h18M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14M9 9h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1"
              />
            </svg>
          </div>
        </div>
      </Card>

      <!-- Activas -->
      <Card class="!p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Activas
            </p>

            <p
              id="organizaciones-activas"
              class="mt-2 text-3xl font-bold text-neutral-900"
            >
              0
            </p>

            <p class="mt-1 text-sm text-neutral-500">
              Organizaciones activas
            </p>
          </div>

          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-success/10 text-success"
            aria-hidden="true"
          >
            <span class="text-lg">●</span>
          </div>
        </div>
      </Card>

      <!-- Inactivas -->
      <Card class="!p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Inactivas
            </p>

            <p
              id="organizaciones-inactivas"
              class="mt-2 text-3xl font-bold text-neutral-900"
            >
              0
            </p>

            <p class="mt-1 text-sm text-neutral-500">
              Organizaciones inactivas
            </p>
          </div>

          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-neutral-100 text-neutral-500"
            aria-hidden="true"
          >
            <span class="text-lg">○</span>
          </div>
        </div>
      </Card>

    </div>

    <!-- Listado -->
    <Card>

      <div class="flex flex-col gap-5">

        <div>
          <h2 class="text-lg font-semibold text-neutral-900">
            Organizaciones registradas
          </h2>

          <p class="mt-1 text-sm text-neutral-500">
            Consulta las organizaciones asociadas a la fundación.
          </p>
        </div>

        <!-- Búsqueda y filtros (RF18) -->
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="md:col-span-1">
            <Input
              id="buscar-organizacion"
              label="Buscar por nombre"
              placeholder="Ej: Comedor Los Aromos"
            />
          </div>

          <Select
            id="filtro-pais"
            label="País"
            options={[{ value: '', label: 'Todos los países' }]}
          />

          <!--
            RF18: los programas son un catálogo global de FGE. Para filtrar organizaciones
            por programa, buscar los planes cuyo id_programa coincida y usar sus
            id_organizacion; no crear una relación directa Organización–Programa.
            Este selector muestra el catálogo global, pero todavía no modifica
            los resultados. Conectar la consulta de planes y sus permisos de
            lectura en el sprint de Planes de Intervención.
          -->
          <Select
            id="filtro-programa"
            label="Filtrar por programa"
            options={[{ value: '', label: 'Todos los programas' }]}
            hint="Por ahora la selección no filtra resultados; estará disponible al consultar los planes de intervención."
          />
        </div>

        <!-- Contador -->
        <div class="flex items-center justify-between">
          <div>
            <p
              id="contador-resultados"
              class="text-sm text-neutral-500"
            >
              Cargando organizaciones...
            </p>
          </div>
        </div>

        <!-- Lista -->
        <div
          id="organizaciones-lista"
          class="space-y-3"
          aria-live="polite"
          aria-busy="true"
        >
          <div
            class="rounded-xl border border-neutral-200 bg-white p-5"
          >
            <div class="animate-pulse space-y-3">
              <div class="h-4 w-2/5 rounded bg-neutral-200"></div>
              <div class="h-3 w-1/4 rounded bg-neutral-200"></div>
            </div>
          </div>
        </div>

      </div>

    </Card>

  </section>

</AppLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { parse } from 'devalue';
  import type { RespuestaActionOrganizacion } from '../actions/organizaciones/organizaciones.handler';
  import type { Organizacion } from '../lib/server/organizaciones';

  const lista = document.querySelector<HTMLDivElement>(
    '#organizaciones-lista',
  );

  const totalElement = document.querySelector<HTMLParagraphElement>(
    '#total-organizaciones',
  );

  const activasElement = document.querySelector<HTMLParagraphElement>(
    '#organizaciones-activas',
  );

  const inactivasElement = document.querySelector<HTMLParagraphElement>(
    '#organizaciones-inactivas',
  );

  const contadorElement = document.querySelector<HTMLParagraphElement>(
    '#contador-resultados',
  );

  const inputBusqueda = document.querySelector<HTMLInputElement>(
    '#buscar-organizacion',
  );

  const selectPais = document.querySelector<HTMLSelectElement>(
    '#filtro-pais',
  );
  const selectPrograma = document.querySelector<HTMLSelectElement>(
    '#filtro-programa',
  );
  const hintPrograma = document.querySelector<HTMLParagraphElement>(
    '#filtro-programa-hint',
  );

  if (
    !lista ||
    !totalElement ||
    !activasElement ||
    !inactivasElement ||
    !contadorElement ||
    !inputBusqueda ||
    !selectPais ||
    !selectPrograma
  ) {
    throw new Error(
      'No se encontraron los elementos necesarios del listado de organizaciones.',
    );
  }

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  if (!supabaseUrl || !supabaseAnonKey) {
    throw new Error('Faltan las variables de configuración de Supabase.');
  }

  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  // Dataset completo tal como llegó del backend; los filtros (RF18) se
  // aplican en el cliente sobre esta copia.
  let todasLasOrganizaciones: Organizacion[] = [];

  /** Quita tildes/mayúsculas para comparar texto sin distinguirlas (RF18). */
  function normalizar(texto: string): string {
    return texto
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function poblarFiltroPaises(datos: Organizacion[]) {
    const seleccionPrevia = selectPais.value;
    const paisesUnicos = new Map<string, string>();

    datos.forEach((organizacion) => {
      paisesUnicos.set(organizacion.pais.id_pais, organizacion.pais.nombre);
    });

    selectPais.replaceChildren();

    const opcionTodos = document.createElement('option');
    opcionTodos.value = '';
    opcionTodos.textContent = 'Todos los países';
    selectPais.append(opcionTodos);

    [...paisesUnicos.entries()]
      .sort(([, nombreA], [, nombreB]) => nombreA.localeCompare(nombreB))
      .forEach(([idPais, nombrePais]) => {
        const opcion = document.createElement('option');
        opcion.value = idPais;
        opcion.textContent = nombrePais;
        selectPais.append(opcion);
      });

    selectPais.value = seleccionPrevia;
  }

  async function cargarProgramasDisponibles() {
    const { data, error } = await supabase
      .from('programas')
      .select('id_programa, nombre')
      .is('archived_at', null)
      .order('nombre', { ascending: true });

    if (error) {
      if (hintPrograma) {
        hintPrograma.textContent =
          'No se pudo cargar el catálogo de programas. La selección aún no filtra organizaciones.';
      }
      return;
    }

    const seleccionPrevia = selectPrograma.value;
    selectPrograma.replaceChildren();

    const opcionTodos = document.createElement('option');
    opcionTodos.value = '';
    opcionTodos.textContent = 'Todos los programas';
    selectPrograma.append(opcionTodos);

    for (const programa of data ?? []) {
      const opcion = document.createElement('option');
      opcion.value = programa.id_programa;
      opcion.textContent = programa.nombre;
      selectPrograma.append(opcion);
    }

    selectPrograma.value = seleccionPrevia;
  }

  function aplicarFiltros() {
    const textoBuscado = normalizar(inputBusqueda.value);
    const idPaisSeleccionado = selectPais.value;

    // RF18 pendiente: filtrar por selectPrograma.value usando los id_organizacion
    // de planes con ese id_programa, una vez habilitada la lectura de planes.

    const filtradas = todasLasOrganizaciones.filter((organizacion) => {
      const coincideNombre =
        textoBuscado === '' || normalizar(organizacion.nombre).includes(textoBuscado);

      const coincidePais =
        idPaisSeleccionado === '' || organizacion.pais.id_pais === idPaisSeleccionado;

      return coincideNombre && coincidePais;
    });

    mostrarOrganizaciones(filtradas, todasLasOrganizaciones.length);
  }

  inputBusqueda.addEventListener('input', aplicarFiltros);
  selectPais.addEventListener('change', aplicarFiltros);

  function limpiarLista() {
    lista.replaceChildren();
  }

  function mostrarMensaje(
    mensaje: string,
    className = 'text-neutral-500',
  ) {
    limpiarLista();

    const contenedor = document.createElement('div');

    contenedor.className =
      'rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-8 text-center';

    const parrafo = document.createElement('p');

    parrafo.className = `text-sm ${className}`;
    parrafo.textContent = mensaje;

    contenedor.append(parrafo);
    lista.append(contenedor);
  }

  function actualizarResumen(datos: Organizacion[]) {
    const activas = datos.filter(
      (organizacion) => organizacion.archived_at === null,
    ).length;

    const inactivas = datos.length - activas;

    totalElement.textContent = String(datos.length);
    activasElement.textContent = String(activas);
    inactivasElement.textContent = String(inactivas);
  }

  function formatearTipoOrganizacion(organizacion: Organizacion) {
    if (organizacion.tipo_organizacion === 'comedor_merendero') {
      return 'Comedor / Merendero';
    }

    if (organizacion.tipo_organizacion === 'centro_comunitario') {
      return 'Centro comunitario';
    }

    if (organizacion.tipo_organizacion === 'emprendimiento_uv') {
      return 'Emprendimiento UV';
    }

    return organizacion.tipo_organizacion_otro ?? 'Otra organización';
  }

  function crearOrganizacion(organizacion: Organizacion) {
    const tarjeta = document.createElement('article');

    tarjeta.className =
      'group rounded-xl border border-neutral-200 bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md';

    const contenido = document.createElement('div');

    contenido.className =
      'flex flex-col gap-4 md:flex-row md:items-center md:justify-between';

    // Información de la organización
    const informacion = document.createElement('div');

    informacion.className = 'min-w-0';

    const encabezado = document.createElement('div');

    encabezado.className =
      'flex flex-wrap items-center gap-2';

    const nombre = document.createElement('h3');

    nombre.className =
      'text-base font-semibold text-neutral-900';

    nombre.textContent = organizacion.nombre;

    const tipo = document.createElement('span');

    tipo.className =
      'inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary';

    tipo.textContent = formatearTipoOrganizacion(organizacion);

    encabezado.append(nombre, tipo);

    const ubicacion = document.createElement('p');

    ubicacion.className =
      'mt-2 text-sm text-neutral-500';

    ubicacion.textContent = [
      organizacion.comuna_municipio_ciudad,
      organizacion.region_departamento,
      organizacion.pais.nombre,
    ].join(' · ');

    informacion.append(encabezado, ubicacion);

    // Acción de detalle
    const acciones = document.createElement('div');

    acciones.className =
      'flex shrink-0 items-center md:justify-end';

    const detalle = document.createElement('a');

    detalle.href = `/organizaciones/${organizacion.id_organizacion}`;

    detalle.className =
      'inline-flex min-h-[48px] items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';

    detalle.textContent = 'Ver detalle →';

    acciones.append(detalle);

    contenido.append(informacion, acciones);

    tarjeta.append(contenido);

    return tarjeta;
  }

  function mostrarOrganizaciones(
    datos: Organizacion[],
    totalSinFiltrar = datos.length,
  ) {
    limpiarLista();

    if (datos.length === 0) {
      mostrarMensaje(
        totalSinFiltrar === 0
          ? 'No hay organizaciones registradas actualmente.'
          : 'No se encontraron organizaciones con esos filtros.',
      );

      contadorElement.textContent =
        totalSinFiltrar === 0
          ? '0 organizaciones registradas'
          : '0 resultados';

      return;
    }

    lista.append(...datos.map(crearOrganizacion));

    contadorElement.textContent =
      datos.length === 1
        ? '1 organización encontrada'
        : `${datos.length} organizaciones encontradas`;
  }

  async function cargarOrganizaciones() {
    lista.setAttribute('aria-busy', 'true');
    contadorElement.textContent = 'Cargando organizaciones...';
    mostrarMensaje('Cargando organizaciones...');

    try {
      const { data, error } = await supabase.auth.getSession();

      if (error) throw error;
      if (!data.session) {
        throw new Error('Tu sesión ha expirado. Vuelve a iniciar sesión.');
      }

      void cargarProgramasDisponibles();

      const respuesta = await fetch('/_actions/listarOrganizaciones', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          Authorization: `Bearer ${data.session.access_token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({}),
      });

      if (!respuesta.ok) {
        throw new Error('No fue posible consultar las organizaciones.');
      }

      const resultado = parse(
        await respuesta.text(),
      ) as RespuestaActionOrganizacion<Organizacion[]>;

      if (!resultado.ok) {
        throw new Error(resultado.mensaje);
      }

      const datos = resultado.datos;

      todasLasOrganizaciones = datos;
      actualizarResumen(datos);
      poblarFiltroPaises(datos);
      aplicarFiltros();
    } catch (error) {
      todasLasOrganizaciones = [];
      actualizarResumen([]);

      contadorElement.textContent =
        'No se pudieron cargar las organizaciones.';

      mostrarMensaje(
        error instanceof Error
          ? error.message
          : 'Ocurrió un error inesperado.',
        'text-danger',
      );

      const reintentar = document.createElement('button');

      reintentar.type = 'button';

      reintentar.className =
        'mt-4 min-h-[48px] rounded-lg border-2 border-primary px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/10';

      reintentar.textContent = 'Reintentar';

      reintentar.addEventListener('click', () => {
        void cargarOrganizaciones();
      });

      lista.append(reintentar);
    } finally {
      lista.setAttribute('aria-busy', 'false');
    }
  }

  void cargarOrganizaciones();
</script>
